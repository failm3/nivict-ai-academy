{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1423","origin":{"collection":"Радар","original_row_number":1423,"raw_json_pointer":"/1422"},"raw":{"description":"buxuku/SmartSub — SmartSub — это универсальный инструмент для создания и перевода субтитров к видео и аудио. Он позволяет быстро генерировать субтитры в пакетном режиме, что значительно экономит время. Поддержка различных переводческих сервисов, таких как Baidu и OpenAI, делает процесс перевода удобным и эффективным. SmartSub упрощает работу с мультимедийным контентом, обеспечивая качественные субтитры и переводы.","link":"https://github.com/buxuku/SmartSub"},"raw_record_json":"{\"description\":\"buxuku/SmartSub — SmartSub — это универсальный инструмент для создания и перевода субтитров к видео и аудио. Он позволяет быстро генерировать субтитры в пакетном режиме, что значительно экономит время. Поддержка различных переводческих сервисов, таких как Baidu и OpenAI, делает процесс перевода удобным и эффективным. SmartSub упрощает работу с мультимедийным контентом, обеспечивая качественные субтитры и переводы.\",\"link\":\"https://github.com/buxuku/SmartSub\"}","identity":{"raw_url":"https://github.com/buxuku/SmartSub","normalized_exact_url":"https://github.com/buxuku/smartsub","normalized_address_key":"github.com/buxuku/smartsub","url_host":"github.com","owner_repo":"buxuku/SmartSub"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1423.md","card_sha256":"f30652d148c7c23e0fd170111f924f3802bc73d9024db09f0c6ccb9d3d3017df","exact_candidate_group_id":"DUP_5ec