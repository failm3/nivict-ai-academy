{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1716","origin":{"collection":"Радар","original_row_number":1716,"raw_json_pointer":"/1715"},"raw":{"description":"zoicware/RemoveWindowsAI — RemoveWindowsAI позволяет удалить нежелательные функции, такие как Copilot и другие элементы Windows 11, которые могут мешать пользователю. Этот инструмент упрощает процесс настройки операционной системы, обеспечивая более чистый и персонализированный интерфейс. Удаление лишних компонентов помогает повысить производительность и улучшить пользовательский опыт.","link":"https://github.com/zoicware/RemoveWindowsAI"},"raw_record_json":"{\"description\":\"zoicware/RemoveWindowsAI — RemoveWindowsAI позволяет удалить нежелательные функции, такие как Copilot и другие элементы Windows 11, которые могут мешать пользователю. Этот инструмент упрощает процесс настройки операционной системы, обеспечивая более чистый и персонализированный интерфейс. Удаление лишних компонентов помогает повысить производительность и улучшить пользовательский опыт.\",\"link\":\"https://github.com/zoicware/RemoveWindowsAI\"}","identity":{"raw_url":"https://github.com/zoicware/RemoveWindowsAI","normalized_exact_url":"https://github.com/zoicware/removewindowsai","normalized_address_key":"github.com/zoicware/removewindowsai","url_host":"github.com","owner_repo":"zoicware/RemoveWindowsAI"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-1716.md","card_sha256":"eeb67907aed0e33b98978a7b6dfce69f07a0ba929f3daf8a870ec1daaae4db47","exact_candidate_group_id":"DUP_6065f0cb033a