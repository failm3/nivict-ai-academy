{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1548","origin":{"collection":"Радар","original_row_number":1548,"raw_json_pointer":"/1547"},"raw":{"description":"krillinai/KrillinAI — KrillinAI — это инструмент для перевода и дубляжа видео, поддерживающий 100 языков. Он позволяет легко и быстро адаптировать контент для популярных платформ, таких как YouTube и TikTok, с помощью одной кнопки. Пользователи могут автоматизировать весь процесс перевода, что значительно экономит время и усилия. Проект обеспечивает высокое качество перевода и оптимизацию для различных форматов видео.","link":"https://github.com/krillinai/KrillinAI"},"raw_record_json":"{\"description\":\"krillinai/KrillinAI — KrillinAI — это инструмент для перевода и дубляжа видео, поддерживающий 100 языков. Он позволяет легко и быстро адаптировать контент для популярных платформ, таких как YouTube и TikTok, с помощью одной кнопки. Пользователи могут автоматизировать весь процесс перевода, что значительно экономит время и усилия. Проект обеспечивает высокое качество перевода и оптимизацию для различных форматов видео.\",\"link\":\"https://github.com/krillinai/KrillinAI\"}","identity":{"raw_url":"https://github.com/krillinai/KrillinAI","normalized_exact_url":"https://github.com/krillinai/krillinai","normalized_address_key":"github.com/krillinai/krillinai","url_host":"github.com","owner_repo":"krillinai/KrillinAI"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1548.md","card_sha256":"c3df563d621cbf78f0e1c3ff49918d7d35fe3df03e7c64485a74a41e43f368a6","exact_candi