{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1402","origin":{"collection":"Радар","original_row_number":1402,"raw_json_pointer":"/1401"},"raw":{"description":"unopim/unopim — UnoPIM — это бесплатная и открытая система управления информацией о продуктах, созданная на базе Laravel. Она позволяет компаниям эффективно организовывать, управлять и обогащать данные о товарах с единой централизованной платформы. Система подходит для работы с большими объемами информации, включая более 10 миллионов продуктов, что делает её идеальным решением для бизнеса, стремящегося оптимизировать управление ассортиментом.","link":"https://github.com/unopim/unopim"},"raw_record_json":"{\"description\":\"unopim/unopim — UnoPIM — это бесплатная и открытая система управления информацией о продуктах, созданная на базе Laravel. Она позволяет компаниям эффективно организовывать, управлять и обогащать данные о товарах с единой централизованной платформы. Система подходит для работы с большими объемами информации, включая более 10 миллионов продуктов, что делает её идеальным решением для бизнеса, стремящегося оптимизировать управление ассортиментом.\",\"link\":\"https://github.com/unopim/unopim\"}","identity":{"raw_url":"https://github.com/unopim/unopim","normalized_exact_url":"https://github.com/unopim/unopim","normalized_address_key":"github.com/unopim/unopim","url_host":"github.com","owner_repo":"unopim/unopim"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","professional_deliverable"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Бизнес - Маркетинг и продажи","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Бизнес---Маркетинг-и-продажи/Радар-1402.md","card_sha256":"7d69e44ed4de901f3fa5b328faf5742