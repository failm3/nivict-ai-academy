{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1662","origin":{"collection":"Радар","original_row_number":1662,"raw_json_pointer":"/1661"},"raw":{"description":"CherryHQ/cherry-studio — Cherry Studio предлагает инструменты для повышения продуктивности с использованием искусственного интеллекта. Пользователи получают доступ к умным чатам и автономным агентам, которые помогают в решении различных задач. С более чем 300 ассистентами, проект обеспечивает единый интерфейс для работы с передовыми языковыми моделями. — 🔥","link":"https://github.com/CherryHQ/cherry-studio"},"raw_record_json":"{\"description\":\"CherryHQ/cherry-studio — Cherry Studio предлагает инструменты для повышения продуктивности с использованием искусственного интеллекта. Пользователи получают доступ к умным чатам и автономным агентам, которые помогают в решении различных задач. С более чем 300 ассистентами, проект обеспечивает единый интерфейс для работы с передовыми языковыми моделями. — 🔥\",\"link\":\"https://github.com/CherryHQ/cherry-studio\"}","identity":{"raw_url":"https://github.com/CherryHQ/cherry-studio","normalized_exact_url":"https://github.com/cherryhq/cherry-studio","normalized_address_key":"github.com/cherryhq/cherry-studio","url_host":"github.com","owner_repo":"CherryHQ/cherry-studio"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-1662.md","card_sha256":"0a2488dace2a8c9fde7c2f775bdaae3f0c90c0d47765b5b409ffc50861a1e002","exact_candidate_group_id":"DUP_e8a8dc14262d0817","exact_candidate_members":["Радар-1662"],"address_candidate_grou