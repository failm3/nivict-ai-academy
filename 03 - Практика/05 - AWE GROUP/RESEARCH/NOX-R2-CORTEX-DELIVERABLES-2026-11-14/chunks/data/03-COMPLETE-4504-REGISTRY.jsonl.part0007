{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1436","origin":{"collection":"Радар","original_row_number":1436,"raw_json_pointer":"/1435"},"raw":{"description":"sinelaw/fresh — Fresh — это удобная и быстрая IDE и текстовый редактор, работающий в терминале. Он позволяет разработчикам эффективно редактировать код и управлять проектами без отвлечений, обеспечивая высокую производительность и простоту использования. Fresh поддерживает множество функций, таких как автозавершение кода и интеграция с системами контроля версий, что делает его идеальным инструментом для программистов. — edited","link":"https://github.com/sinelaw/fresh"},"raw_record_json":"{\"description\":\"sinelaw/fresh — Fresh — это удобная и быстрая IDE и текстовый редактор, работающий в терминале. Он позволяет разработчикам эффективно редактировать код и управлять проектами без отвлечений, обеспечивая высокую производительность и простоту использования. Fresh поддерживает множество функций, таких как автозавершение кода и интеграция с системами контроля версий, что делает его идеальным инструментом для программистов. — edited\",\"link\":\"https://github.com/sinelaw/fresh\"}","identity":{"raw_url":"https://github.com/sinelaw/fresh","normalized_exact_url":"https://github.com/sinelaw/fresh","normalized_address_key":"github.com/sinelaw/fresh","url_host":"github.com","owner_repo":"sinelaw/fresh"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-1436.md","card_sha256":"50273ae7038400eacf6b696a5b37ac36997258921b5eb923d8e7180102604a30","exact_candidate_group_id":"DUP_3154