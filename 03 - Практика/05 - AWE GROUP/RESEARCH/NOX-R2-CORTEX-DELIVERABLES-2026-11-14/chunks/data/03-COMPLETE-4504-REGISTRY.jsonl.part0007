{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1501","origin":{"collection":"Радар","original_row_number":1501,"raw_json_pointer":"/1500"},"raw":{"description":"middleapi/orpc — orpc упрощает создание безопасных API, позволяя разработчикам легко и быстро генерировать типизированные интерфейсы для взаимодействия между клиентом и сервером. Это значительно снижает вероятность ошибок и повышает производительность работы с данными. Пользователи могут сосредоточиться на логике приложения, не беспокоясь о проблемах с типами. — 👍","link":"https://github.com/middleapi/orpc"},"raw_record_json":"{\"description\":\"middleapi/orpc — orpc упрощает создание безопасных API, позволяя разработчикам легко и быстро генерировать типизированные интерфейсы для взаимодействия между клиентом и сервером. Это значительно снижает вероятность ошибок и повышает производительность работы с данными. Пользователи могут сосредоточиться на логике приложения, не беспокоясь о проблемах с типами. — 👍\",\"link\":\"https://github.com/middleapi/orpc\"}","identity":{"raw_url":"https://github.com/middleapi/orpc","normalized_exact_url":"https://github.com/middleapi/orpc","normalized_address_key":"github.com/middleapi/orpc","url_host":"github.com","owner_repo":"middleapi/orpc"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics","security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-1501.md","card_sha256":"06e2a8085c74dee66ccbfc3facfc3aa3308c2248abfe2f5ef0c4240a687ba946","exact_candidate_group_id":"DUP_9d321c2f4cfee95f","exact_candidate_members":["Рад