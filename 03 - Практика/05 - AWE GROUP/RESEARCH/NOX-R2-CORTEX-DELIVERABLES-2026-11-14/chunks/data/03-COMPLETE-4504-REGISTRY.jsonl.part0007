{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1685","origin":{"collection":"Радар","original_row_number":1685,"raw_json_pointer":"/1684"},"raw":{"description":"OpenCTI-Platform/opencti — OpenCTI — это платформа для управления и анализа информации о киберугрозах. Она помогает организациям собирать, хранить и обмениваться данными о киберугрозах, что позволяет лучше понимать и реагировать на инциденты безопасности. Система поддерживает интеграцию с другими инструментами и упрощает совместную работу команд.","link":"https://github.com/OpenCTI-Platform/opencti"},"raw_record_json":"{\"description\":\"OpenCTI-Platform/opencti — OpenCTI — это платформа для управления и анализа информации о киберугрозах. Она помогает организациям собирать, хранить и обмениваться данными о киберугрозах, что позволяет лучше понимать и реагировать на инциденты безопасности. Система поддерживает интеграцию с другими инструментами и упрощает совместную работу команд.\",\"link\":\"https://github.com/OpenCTI-Platform/opencti\"}","identity":{"raw_url":"https://github.com/OpenCTI-Platform/opencti","normalized_exact_url":"https://github.com/opencti-platform/opencti","normalized_address_key":"github.com/opencti-platform/opencti","url_host":"github.com","owner_repo":"OpenCTI-Platform/opencti"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-1685.md","card_sha256":"164dae6b25db894f1d03f29e204ae79fd425290f18ca7aa1e7ca5b0bfecd30c6","exact_candidate_group_id":"DUP_042f5c813989bf34","exact_candidate_members":["Радар-1685"],"address_candidate_group_id":"DUP_d796de4976