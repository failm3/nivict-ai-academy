{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1727","origin":{"collection":"Радар","original_row_number":1727,"raw_json_pointer":"/1726"},"raw":{"description":"xiamuceer-j/MuMuAINovel — MuMuAINovel — это интеллектуальный помощник для написания романов на основе искусственного интеллекта. Он упрощает процесс создания увлекательных историй, предоставляя пользователям идеи, сюжеты и помощь в разработке персонажей. С помощью этого инструмента можно быстро генерировать текст и улучшать качество написания, что делает его полезным как для начинающих авторов, так и для опытных писателей.","link":"https://github.com/xiamuceer-j/MuMuAINovel"},"raw_record_json":"{\"description\":\"xiamuceer-j/MuMuAINovel — MuMuAINovel — это интеллектуальный помощник для написания романов на основе искусственного интеллекта. Он упрощает процесс создания увлекательных историй, предоставляя пользователям идеи, сюжеты и помощь в разработке персонажей. С помощью этого инструмента можно быстро генерировать текст и улучшать качество написания, что делает его полезным как для начинающих авторов, так и для опытных писателей.\",\"link\":\"https://github.com/xiamuceer-j/MuMuAINovel\"}","identity":{"raw_url":"https://github.com/xiamuceer-j/MuMuAINovel","normalized_exact_url":"https://github.com/xiamuceer-j/mumuainovel","normalized_address_key":"github.com/xiamuceer-j/mumuainovel","url_host":"github.com","owner_repo":"xiamuceer-j/MuMuAINovel"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1727.md","card_sha256":"fe77e9