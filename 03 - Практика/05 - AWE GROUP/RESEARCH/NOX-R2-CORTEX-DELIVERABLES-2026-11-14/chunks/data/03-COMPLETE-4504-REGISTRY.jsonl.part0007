{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1518","origin":{"collection":"Радар","original_row_number":1518,"raw_json_pointer":"/1517"},"raw":{"description":"QuivrHQ/MegaParse — MegaParse позволяет эффективно извлекать текст из файлов форматов PDF, DOCX и PPTX, оптимизируя его для обработки большими языковыми моделями. Инструмент гарантирует сохранение всех данных без потерь, что делает его незаменимым для работы с документами в контексте анализа и обучения ИИ.","link":"https://github.com/QuivrHQ/MegaParse"},"raw_record_json":"{\"description\":\"QuivrHQ/MegaParse — MegaParse позволяет эффективно извлекать текст из файлов форматов PDF, DOCX и PPTX, оптимизируя его для обработки большими языковыми моделями. Инструмент гарантирует сохранение всех данных без потерь, что делает его незаменимым для работы с документами в контексте анализа и обучения ИИ.\",\"link\":\"https://github.com/QuivrHQ/MegaParse\"}","identity":{"raw_url":"https://github.com/QuivrHQ/MegaParse","normalized_exact_url":"https://github.com/quivrhq/megaparse","normalized_address_key":"github.com/quivrhq/megaparse","url_host":"github.com","owner_repo":"QuivrHQ/MegaParse"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable","skills_competence"],"contours":["B_KNOWLEDGE_COMPETENCE","A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1518.md","card_sha256":"62709cc3872af9ff71b69cce896e37ab2f3bdc533bda28d579761a3c826347fd","exact_candidate_group_id":"DUP_475bf61afaff11bf","exact_candidate_members":["Радар-1518"],"address_candidate_group_id":"DUP_6bbfd65e323a74bb","address_candidate_members":["Рад