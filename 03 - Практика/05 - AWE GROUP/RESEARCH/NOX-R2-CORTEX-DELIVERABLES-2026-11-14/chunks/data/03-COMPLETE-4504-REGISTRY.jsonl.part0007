{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1769","origin":{"collection":"Радар","original_row_number":1769,"raw_json_pointer":"/1768"},"raw":{"description":"HarryR/z80ai — Z80AI предлагает возможность создания и обучения разговорных моделей на 2-битном квантованном языке, который можно запускать на 8-битном процессоре Z80. Пользователи могут тренировать модели на Python и экспортировать их в формате .COM для CP/M, что позволяет вести диалоги на винтажных компьютерах.","link":"https://github.com/HarryR/z80ai"},"raw_record_json":"{\"description\":\"HarryR/z80ai — Z80AI предлагает возможность создания и обучения разговорных моделей на 2-битном квантованном языке, который можно запускать на 8-битном процессоре Z80. Пользователи могут тренировать модели на Python и экспортировать их в формате .COM для CP/M, что позволяет вести диалоги на винтажных компьютерах.\",\"link\":\"https://github.com/HarryR/z80ai\"}","identity":{"raw_url":"https://github.com/HarryR/z80ai","normalized_exact_url":"https://github.com/harryr/z80ai","normalized_address_key":"github.com/harryr/z80ai","url_host":"github.com","owner_repo":"HarryR/z80ai"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence","quality_evaluation"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Обучение и оценка моделей","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Обучение-и-оценка-моделеи/Радар-1769.md","card_sha256":"07ca5fa235e09166eb4315d40a8e748a34339a6313e1662944b223f6770d08ce","exact_candidate_group_id":"DUP_a8a7dd6fc3dc5372","exact_candidate_members":["Радар-1769"],"address_candidate_group_id":"DUP_677ada13e9835df5","address_candidate_members":["Радар-1769"]},"status":{"maturity_stage":"RAW_CANDI