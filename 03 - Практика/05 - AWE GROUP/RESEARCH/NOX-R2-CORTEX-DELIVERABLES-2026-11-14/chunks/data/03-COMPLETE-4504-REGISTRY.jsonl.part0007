{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1704","origin":{"collection":"Радар","original_row_number":1704,"raw_json_pointer":"/1703"},"raw":{"description":"blinkospace/blinko — Blinko — это саморазворачивающийся инструмент для создания личных заметок с поддержкой искусственного интеллекта, который акцентирует внимание на конфиденциальности данных. Пользователи могут безопасно хранить и организовывать свои заметки, а также получать интеллектуальные рекомендации и помощь в управлении информацией.","link":"https://github.com/blinkospace/blinko"},"raw_record_json":"{\"description\":\"blinkospace/blinko — Blinko — это саморазворачивающийся инструмент для создания личных заметок с поддержкой искусственного интеллекта, который акцентирует внимание на конфиденциальности данных. Пользователи могут безопасно хранить и организовывать свои заметки, а также получать интеллектуальные рекомендации и помощь в управлении информацией.\",\"link\":\"https://github.com/blinkospace/blinko\"}","identity":{"raw_url":"https://github.com/blinkospace/blinko","normalized_exact_url":"https://github.com/blinkospace/blinko","normalized_address_key":"github.com/blinkospace/blinko","url_host":"github.com","owner_repo":"blinkospace/blinko"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1704.md","card_sha256":"0c0e97c4d958687c628407341bfe5dc3dfac60ff73553e56e3cc687f82455e50","exact_candidate_group_id":"DUP_6acad4c6273964af","exact_candidate_members":["Радар-1704"],"address_candidate_group_id":"DUP_d566a084a