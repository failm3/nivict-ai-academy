{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1447","origin":{"collection":"Радар","original_row_number":1447,"raw_json_pointer":"/1446"},"raw":{"description":"systemd/systemd — systemd — это менеджер систем и сервисов, который упрощает управление процессами в операционных системах на базе Linux. Он отвечает за запуск, остановку и мониторинг служб, а также управление зависимостями между ними. systemd обеспечивает быструю загрузку системы и эффективное использование ресурсов, позволяя администраторам легко настраивать и контролировать работу сервисов. — ❤","link":"https://github.com/systemd/systemd"},"raw_record_json":"{\"description\":\"systemd/systemd — systemd — это менеджер систем и сервисов, который упрощает управление процессами в операционных системах на базе Linux. Он отвечает за запуск, остановку и мониторинг служб, а также управление зависимостями между ними. systemd обеспечивает быструю загрузку системы и эффективное использование ресурсов, позволяя администраторам легко настраивать и контролировать работу сервисов. — ❤\",\"link\":\"https://github.com/systemd/systemd\"}","identity":{"raw_url":"https://github.com/systemd/systemd","normalized_exact_url":"https://github.com/systemd/systemd","normalized_address_key":"github.com/systemd/systemd","url_host":"github.com","owner_repo":"systemd/systemd"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-1447.md","card_sha256":"12a958de561133654f61953c7b6e4c4083c382b069124eee7a40c31b267e151c","exact_candidate_group_id":"DUP_03b3c9018ccebb47","exact_candi