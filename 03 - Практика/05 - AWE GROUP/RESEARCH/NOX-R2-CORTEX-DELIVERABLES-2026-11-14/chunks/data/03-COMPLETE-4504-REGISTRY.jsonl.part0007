{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1718","origin":{"collection":"Радар","original_row_number":1718,"raw_json_pointer":"/1717"},"raw":{"description":"seerr-team/seerr — Seerr — это инструмент для управления запросами и поиска медиа-контента, совместимый с Jellyfin, Plex и Emby. Он позволяет пользователям легко находить и запрашивать фильмы и сериалы, упрощая процесс организации и доступа к любимым материалам. С помощью Seerr можно эффективно отслеживать запросы и получать уведомления о новых поступлениях.","link":"https://github.com/seerr-team/seerr"},"raw_record_json":"{\"description\":\"seerr-team/seerr — Seerr — это инструмент для управления запросами и поиска медиа-контента, совместимый с Jellyfin, Plex и Emby. Он позволяет пользователям легко находить и запрашивать фильмы и сериалы, упрощая процесс организации и доступа к любимым материалам. С помощью Seerr можно эффективно отслеживать запросы и получать уведомления о новых поступлениях.\",\"link\":\"https://github.com/seerr-team/seerr\"}","identity":{"raw_url":"https://github.com/seerr-team/seerr","normalized_exact_url":"https://github.com/seerr-team/seerr","normalized_address_key":"github.com/seerr-team/seerr","url_host":"github.com","owner_repo":"seerr-team/seerr"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["retrieval_memory"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1718.md","card_sha256":"6a58c0e4879c16a03526e94d1e81d35169d1c5d7a34558b9e50cbb43b973908d","exact_candidate_group_id":"DUP_25abb6fcd2e9d2a8","exact_candidate_members":["Радар-1718"],"address_candidate_group_id":"DUP_18d8df26