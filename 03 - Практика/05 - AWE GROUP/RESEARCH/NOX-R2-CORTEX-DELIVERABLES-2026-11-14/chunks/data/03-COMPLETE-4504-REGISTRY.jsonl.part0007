{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1663","origin":{"collection":"Радар","original_row_number":1663,"raw_json_pointer":"/1662"},"raw":{"description":"Ripple-TS/ripple — Ripple — это элегантный фреймворк для создания пользовательских интерфейсов на TypeScript. Он упрощает разработку, позволяя быстро и эффективно строить адаптивные и интерактивные приложения. Пользователи могут легко интегрировать компоненты, управлять состоянием и настраивать стили, что значительно ускоряет процесс создания интерфейсов.","link":"https://github.com/Ripple-TS/ripple"},"raw_record_json":"{\"description\":\"Ripple-TS/ripple — Ripple — это элегантный фреймворк для создания пользовательских интерфейсов на TypeScript. Он упрощает разработку, позволяя быстро и эффективно строить адаптивные и интерактивные приложения. Пользователи могут легко интегрировать компоненты, управлять состоянием и настраивать стили, что значительно ускоряет процесс создания интерфейсов.\",\"link\":\"https://github.com/Ripple-TS/ripple\"}","identity":{"raw_url":"https://github.com/Ripple-TS/ripple","normalized_exact_url":"https://github.com/ripple-ts/ripple","normalized_address_key":"github.com/ripple-ts/ripple","url_host":"github.com","owner_repo":"Ripple-TS/ripple"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1663.md","card_sha256":"99500c39cb0db7218e75b46e98fe1bd8bf90ce0e2e8a34f131ab98281b762192","exact_candidate_group_id":"DUP_b1ee2338423bb621","exact_candidate_members":["Радар-1663"],"address_candidate_group_id":"DUP_6f