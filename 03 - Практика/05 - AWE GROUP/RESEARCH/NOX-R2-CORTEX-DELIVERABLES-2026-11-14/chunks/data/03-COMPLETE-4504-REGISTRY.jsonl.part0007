{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1382","origin":{"collection":"Радар","original_row_number":1382,"raw_json_pointer":"/1381"},"raw":{"description":"edtechre/pybroker — pybroker предлагает инструменты для алгоритмической торговли на Python с использованием машинного обучения. Он позволяет пользователям разрабатывать и тестировать торговые стратегии, анализировать рыночные данные и оптимизировать свои подходы к инвестициям. Поддержка различных финансовых инструментов и интеграция с популярными библиотеками делают его удобным для трейдеров и аналитиков.","link":"https://github.com/edtechre/pybroker"},"raw_record_json":"{\"description\":\"edtechre/pybroker — pybroker предлагает инструменты для алгоритмической торговли на Python с использованием машинного обучения. Он позволяет пользователям разрабатывать и тестировать торговые стратегии, анализировать рыночные данные и оптимизировать свои подходы к инвестициям. Поддержка различных финансовых инструментов и интеграция с популярными библиотеками делают его удобным для трейдеров и аналитиков.\",\"link\":\"https://github.com/edtechre/pybroker\"}","identity":{"raw_url":"https://github.com/edtechre/pybroker","normalized_exact_url":"https://github.com/edtechre/pybroker","normalized_address_key":"github.com/edtechre/pybroker","url_host":"github.com","owner_repo":"edtechre/pybroker"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["quality_evaluation","skills_competence"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1382.md","card_sha256":"e1f3322d39f80988663f40aaabf8b78835bb78798b53fb0d8d0de859a5454921"