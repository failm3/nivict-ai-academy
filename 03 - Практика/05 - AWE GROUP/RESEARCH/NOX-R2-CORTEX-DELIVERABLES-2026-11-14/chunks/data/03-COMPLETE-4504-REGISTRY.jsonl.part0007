{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1715","origin":{"collection":"Радар","original_row_number":1715,"raw_json_pointer":"/1714"},"raw":{"description":"jordanbaird/Ice — Ice — это мощный менеджер меню для macOS, который упрощает доступ к приложениям и инструментам. Он позволяет организовать и настраивать меню в строке состояния, что помогает быстро находить нужные функции и сокращает время на выполнение задач. Пользователи могут легко добавлять, удалять и изменять порядок элементов, что делает рабочее пространство более удобным и эффективным.","link":"https://github.com/jordanbaird/Ice"},"raw_record_json":"{\"description\":\"jordanbaird/Ice — Ice — это мощный менеджер меню для macOS, который упрощает доступ к приложениям и инструментам. Он позволяет организовать и настраивать меню в строке состояния, что помогает быстро находить нужные функции и сокращает время на выполнение задач. Пользователи могут легко добавлять, удалять и изменять порядок элементов, что делает рабочее пространство более удобным и эффективным.\",\"link\":\"https://github.com/jordanbaird/Ice\"}","identity":{"raw_url":"https://github.com/jordanbaird/Ice","normalized_exact_url":"https://github.com/jordanbaird/ice","normalized_address_key":"github.com/jordanbaird/ice","url_host":"github.com","owner_repo":"jordanbaird/Ice"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1715.md","card_sha256":"c2c84a97f7b7009b76c71394dad74c7790a891053701283c1644c49d8147d0ad","exact_candidate_group_id":"DUP_09f9883a146a7100","exact_candidate_members":["Радар-1