{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1783","origin":{"collection":"Радар","original_row_number":1783,"raw_json_pointer":"/1782"},"raw":{"description":"miaoxworld/OpenClawInstaller — OpenClawInstaller — это удобный инструмент для быстрой установки и настройки ClawdBot. Он позволяет пользователям без лишних усилий развернуть бота, минимизируя время и затраты на конфигурацию. С помощью этого установщика можно легко управлять зависимостями и обновлениями, что делает процесс установки более простым и эффективным.","link":"https://github.com/miaoxworld/OpenClawInstaller"},"raw_record_json":"{\"description\":\"miaoxworld/OpenClawInstaller — OpenClawInstaller — это удобный инструмент для быстрой установки и настройки ClawdBot. Он позволяет пользователям без лишних усилий развернуть бота, минимизируя время и затраты на конфигурацию. С помощью этого установщика можно легко управлять зависимостями и обновлениями, что делает процесс установки более простым и эффективным.\",\"link\":\"https://github.com/miaoxworld/OpenClawInstaller\"}","identity":{"raw_url":"https://github.com/miaoxworld/OpenClawInstaller","normalized_exact_url":"https://github.com/miaoxworld/openclawinstaller","normalized_address_key":"github.com/miaoxworld/openclawinstaller","url_host":"github.com","owner_repo":"miaoxworld/OpenClawInstaller"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1783.md","card_sha256":"bb3348baadaf01af12aef57638dc58bf1d92268673f1512667620fe4fee9e8c6","exact_candidate_group_id":"DUP_ed34f