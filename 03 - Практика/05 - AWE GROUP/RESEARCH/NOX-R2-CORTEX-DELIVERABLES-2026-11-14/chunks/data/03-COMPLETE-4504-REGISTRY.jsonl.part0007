{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1499","origin":{"collection":"Радар","original_row_number":1499,"raw_json_pointer":"/1498"},"raw":{"description":"matro7sh/BypassAV — BypassAV предоставляет набор эффективных методов обхода антивирусных систем и средств защиты конечных точек (EDR). Он помогает специалистам по безопасности тестировать и оценивать уязвимости в системах защиты, а также исследовать поведение вредоносного ПО. Инструменты из этого репозитория могут быть полезны для анализа и разработки стратегий защиты от киберугроз. — 🔥","link":"https://github.com/matro7sh/BypassAV"},"raw_record_json":"{\"description\":\"matro7sh/BypassAV — BypassAV предоставляет набор эффективных методов обхода антивирусных систем и средств защиты конечных точек (EDR). Он помогает специалистам по безопасности тестировать и оценивать уязвимости в системах защиты, а также исследовать поведение вредоносного ПО. Инструменты из этого репозитория могут быть полезны для анализа и разработки стратегий защиты от киберугроз. — 🔥\",\"link\":\"https://github.com/matro7sh/BypassAV\"}","identity":{"raw_url":"https://github.com/matro7sh/BypassAV","normalized_exact_url":"https://github.com/matro7sh/bypassav","normalized_address_key":"github.com/matro7sh/bypassav","url_host":"github.com","owner_repo":"matro7sh/BypassAV"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance","observability_economics","quality_evaluation"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-1499.md","card_sha256":"a7fd0846b29150f92c0827bb4fd2a239bddaa437028960732b8296b5925aba67","exact_candidate_gro