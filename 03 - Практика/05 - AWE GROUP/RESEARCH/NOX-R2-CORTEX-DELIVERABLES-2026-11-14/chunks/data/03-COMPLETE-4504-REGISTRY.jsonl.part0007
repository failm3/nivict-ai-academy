{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1510","origin":{"collection":"Радар","original_row_number":1510,"raw_json_pointer":"/1509"},"raw":{"description":"nikopueringer/CorridorKey — CorridorKey предлагает эффективные решения для создания идеальных хромакейных фонов. Он позволяет легко удалять зеленые экраны и заменять их на любые изображения или видео, обеспечивая высокое качество и реалистичность. Инструмент будет полезен для видеомонтажеров, создателей контента и профессионалов в области кино, стремящихся улучшить визуальное восприятие своих работ.","link":"https://github.com/nikopueringer/CorridorKey"},"raw_record_json":"{\"description\":\"nikopueringer/CorridorKey — CorridorKey предлагает эффективные решения для создания идеальных хромакейных фонов. Он позволяет легко удалять зеленые экраны и заменять их на любые изображения или видео, обеспечивая высокое качество и реалистичность. Инструмент будет полезен для видеомонтажеров, создателей контента и профессионалов в области кино, стремящихся улучшить визуальное восприятие своих работ.\",\"link\":\"https://github.com/nikopueringer/CorridorKey\"}","identity":{"raw_url":"https://github.com/nikopueringer/CorridorKey","normalized_exact_url":"https://github.com/nikopueringer/corridorkey","normalized_address_key":"github.com/nikopueringer/corridorkey","url_host":"github.com","owner_repo":"nikopueringer/CorridorKey"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1510.md","card_sha256":"af715b972b11869de95e85a8ed32443df122e3e030f712f6a56edbe594383450","e