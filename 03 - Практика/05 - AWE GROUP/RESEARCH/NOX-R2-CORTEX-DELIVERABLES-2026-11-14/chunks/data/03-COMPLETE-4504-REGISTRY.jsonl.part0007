{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1552","origin":{"collection":"Радар","original_row_number":1552,"raw_json_pointer":"/1551"},"raw":{"description":"tracel-ai/burn — Burn — это современная библиотека для работы с тензорами и фреймворк глубокого обучения, который обеспечивает высокую гибкость и эффективность. Он подходит для разработчиков, стремящихся создать и обучить модели машинного обучения без сложных ограничений. Burn позволяет легко интегрировать решения в различные среды, что делает его идеальным инструментом для исследователей и практиков в области ИИ.","link":"https://github.com/tracel-ai/burn"},"raw_record_json":"{\"description\":\"tracel-ai/burn — Burn — это современная библиотека для работы с тензорами и фреймворк глубокого обучения, который обеспечивает высокую гибкость и эффективность. Он подходит для разработчиков, стремящихся создать и обучить модели машинного обучения без сложных ограничений. Burn позволяет легко интегрировать решения в различные среды, что делает его идеальным инструментом для исследователей и практиков в области ИИ.\",\"link\":\"https://github.com/tracel-ai/burn\"}","identity":{"raw_url":"https://github.com/tracel-ai/burn","normalized_exact_url":"https://github.com/tracel-ai/burn","normalized_address_key":"github.com/tracel-ai/burn","url_host":"github.com","owner_repo":"tracel-ai/burn"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","skills_competence"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1552.md","card_sha256":"ba686c6dda9af