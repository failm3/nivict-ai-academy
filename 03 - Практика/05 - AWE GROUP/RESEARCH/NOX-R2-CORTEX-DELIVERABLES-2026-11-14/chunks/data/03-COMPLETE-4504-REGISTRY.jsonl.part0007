{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1521","origin":{"collection":"Радар","original_row_number":1521,"raw_json_pointer":"/1520"},"raw":{"description":"hengyoush/kyanos — Kyanos — это инструмент для анализа сетевого трафика, основанный на eBPF. Он позволяет визуализировать время, которое пакеты проводят в ядре, а также захватывать запросы и ответы. Это значительно упрощает процесс диагностики сетевых проблем и повышает эффективность устранения неполадок. Kyanos помогает пользователям лучше понимать поведение сетевых приложений и оптимизировать их работу.","link":"https://github.com/hengyoush/kyanos"},"raw_record_json":"{\"description\":\"hengyoush/kyanos — Kyanos — это инструмент для анализа сетевого трафика, основанный на eBPF. Он позволяет визуализировать время, которое пакеты проводят в ядре, а также захватывать запросы и ответы. Это значительно упрощает процесс диагностики сетевых проблем и повышает эффективность устранения неполадок. Kyanos помогает пользователям лучше понимать поведение сетевых приложений и оптимизировать их работу.\",\"link\":\"https://github.com/hengyoush/kyanos\"}","identity":{"raw_url":"https://github.com/hengyoush/kyanos","normalized_exact_url":"https://github.com/hengyoush/kyanos","normalized_address_key":"github.com/hengyoush/kyanos","url_host":"github.com","owner_repo":"hengyoush/kyanos"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1521.md","card_sha256":"fc61bd267a904e0f42680e6d9452ca3552831a20d94ba19d489d67da5e3eb7f9","exact_candidate_group_id":"DUP_fcab2b84229d