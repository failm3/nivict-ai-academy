{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1481","origin":{"collection":"Радар","original_row_number":1481,"raw_json_pointer":"/1480"},"raw":{"description":"opencloud-eu/opencloud — OpenCloud предлагает удобную платформу для управления файлами, их обмена и совместной работы. Она обеспечивает пользователям полный контроль над данными, позволяя безопасно хранить и делиться информацией без зависимости от сторонних сервисов. Решает задачи организации рабочего процесса и упрощает взаимодействие между командами.","link":"https://github.com/opencloud-eu/opencloud"},"raw_record_json":"{\"description\":\"opencloud-eu/opencloud — OpenCloud предлагает удобную платформу для управления файлами, их обмена и совместной работы. Она обеспечивает пользователям полный контроль над данными, позволяя безопасно хранить и делиться информацией без зависимости от сторонних сервисов. Решает задачи организации рабочего процесса и упрощает взаимодействие между командами.\",\"link\":\"https://github.com/opencloud-eu/opencloud\"}","identity":{"raw_url":"https://github.com/opencloud-eu/opencloud","normalized_exact_url":"https://github.com/opencloud-eu/opencloud","normalized_address_key":"github.com/opencloud-eu/opencloud","url_host":"github.com","owner_repo":"opencloud-eu/opencloud"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1481.md","card_sha256":"d42970707f6723d0c8938069d58356fe96ef4e70d793a9ebbb833048bbedcb3c","exact_candidate_group_id":"DUP_27668821ee46debc","exact_candidate_members":["Радар-1481"],"address_candidate_gr