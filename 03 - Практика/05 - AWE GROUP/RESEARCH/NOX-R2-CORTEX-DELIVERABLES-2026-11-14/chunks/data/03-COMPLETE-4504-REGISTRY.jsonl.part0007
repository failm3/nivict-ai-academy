{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1719","origin":{"collection":"Радар","original_row_number":1719,"raw_json_pointer":"/1718"},"raw":{"description":"OpenSPG/KAG — KAG предлагает эффективный инструмент для логического рассуждения и извлечения информации, основанный на движке OpenSPG и больших языковых моделях. Он предназначен для создания решений в области логического анализа и ответов на фактические вопросы, что особенно полезно для профессиональных баз знаний.","link":"https://github.com/OpenSPG/KAG"},"raw_record_json":"{\"description\":\"OpenSPG/KAG — KAG предлагает эффективный инструмент для логического рассуждения и извлечения информации, основанный на движке OpenSPG и больших языковых моделях. Он предназначен для создания решений в области логического анализа и ответов на фактические вопросы, что особенно полезно для профессиональных баз знаний.\",\"link\":\"https://github.com/OpenSPG/KAG\"}","identity":{"raw_url":"https://github.com/OpenSPG/KAG","normalized_exact_url":"https://github.com/openspg/kag","normalized_address_key":"github.com/openspg/kag","url_host":"github.com","owner_repo":"OpenSPG/KAG"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1719.md","card_sha256":"a7eeb3f0d6b5acfb8a5cf0238d94499c9f1ba6ff378f04d44f66928e467546ba","exact_candidate_group_id":"DUP_1cf34273ca585ee6","exact_candidate_members":["Радар-1719"],"address_candidate_group_id":"DUP_83deac2cf136743f","address_candidate_members":["Радар-1719"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVE