{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1723","origin":{"collection":"Радар","original_row_number":1723,"raw_json_pointer":"/1722"},"raw":{"description":"karpathy/llm.c — llm.c предоставляет инструменты для обучения языковых моделей на языке C и CUDA. Он позволяет разработчикам эффективно реализовывать алгоритмы машинного обучения, оптимизируя производительность и использование ресурсов. Подходит для тех, кто хочет глубже понять процесс обучения моделей без сложных зависимостей.","link":"https://github.com/karpathy/llm.c"},"raw_record_json":"{\"description\":\"karpathy/llm.c — llm.c предоставляет инструменты для обучения языковых моделей на языке C и CUDA. Он позволяет разработчикам эффективно реализовывать алгоритмы машинного обучения, оптимизируя производительность и использование ресурсов. Подходит для тех, кто хочет глубже понять процесс обучения моделей без сложных зависимостей.\",\"link\":\"https://github.com/karpathy/llm.c\"}","identity":{"raw_url":"https://github.com/karpathy/llm.c","normalized_exact_url":"https://github.com/karpathy/llm.c","normalized_address_key":"github.com/karpathy/llm.c","url_host":"github.com","owner_repo":"karpathy/llm.c"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1723.md","card_sha256":"05746d324744497951c561e1d323858eb18375056d14858664e4090d623936a9","exact_candidate_group_id":"DUP_574de567debfa26f","exact_candidate_members":["Радар-1723"],"address_candidate_group_id":"DUP_5ad2c992d42a32fb","address_candidate_members":["Радар-1723"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness