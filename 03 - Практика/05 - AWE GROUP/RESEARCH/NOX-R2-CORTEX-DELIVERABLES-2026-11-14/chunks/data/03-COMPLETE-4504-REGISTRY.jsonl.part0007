{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1406","origin":{"collection":"Радар","original_row_number":1406,"raw_json_pointer":"/1405"},"raw":{"description":"josStorer/RWKV-Runner — RWKV-Runner — это инструмент для управления и запуска модели RWKV, обеспечивающий полную автоматизацию в компактном размере всего 8 МБ. Он предлагает интерфейс, совместимый с API OpenAI, что позволяет легко интегрировать модель в различные приложения. RWKV — это мощная языковая модель с открытым исходным кодом, доступная для коммерческого использования.","link":"https://github.com/josStorer/RWKV-Runner"},"raw_record_json":"{\"description\":\"josStorer/RWKV-Runner — RWKV-Runner — это инструмент для управления и запуска модели RWKV, обеспечивающий полную автоматизацию в компактном размере всего 8 МБ. Он предлагает интерфейс, совместимый с API OpenAI, что позволяет легко интегрировать модель в различные приложения. RWKV — это мощная языковая модель с открытым исходным кодом, доступная для коммерческого использования.\",\"link\":\"https://github.com/josStorer/RWKV-Runner\"}","identity":{"raw_url":"https://github.com/josStorer/RWKV-Runner","normalized_exact_url":"https://github.com/josstorer/rwkv-runner","normalized_address_key":"github.com/josstorer/rwkv-runner","url_host":"github.com","owner_repo":"josStorer/RWKV-Runner"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1406.md","card_sha256":"310207a813f9e14b2054c2465e5fc604fc7679516bf4d167524990d127dc413d","exact_candidate_group_id":"DUP_1acf908973445c70","exact_candidate_members":["Радар