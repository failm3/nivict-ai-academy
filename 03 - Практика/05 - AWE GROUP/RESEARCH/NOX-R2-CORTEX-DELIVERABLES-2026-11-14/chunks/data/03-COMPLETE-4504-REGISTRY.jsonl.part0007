{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1705","origin":{"collection":"Радар","original_row_number":1705,"raw_json_pointer":"/1704"},"raw":{"description":"RSSNext/Folo — Folo — это инструмент, который помогает пользователям быстро и эффективно извлекать информацию из текстов. Он анализирует и обрабатывает большие объемы данных, позволяя сосредоточиться на главном, а не тратить время на чтение. Folo подходит для студентов, исследователей и профессионалов, которым необходимо быстро усваивать информацию и делать выводы.","link":"https://github.com/RSSNext/Folo"},"raw_record_json":"{\"description\":\"RSSNext/Folo — Folo — это инструмент, который помогает пользователям быстро и эффективно извлекать информацию из текстов. Он анализирует и обрабатывает большие объемы данных, позволяя сосредоточиться на главном, а не тратить время на чтение. Folo подходит для студентов, исследователей и профессионалов, которым необходимо быстро усваивать информацию и делать выводы.\",\"link\":\"https://github.com/RSSNext/Folo\"}","identity":{"raw_url":"https://github.com/RSSNext/Folo","normalized_exact_url":"https://github.com/rssnext/folo","normalized_address_key":"github.com/rssnext/folo","url_host":"github.com","owner_repo":"RSSNext/Folo"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1705.md","card_sha256":"9ede1a6397ae6fcd35315360a5921987e3c5275168f95bf60b24df0a66d7d775","exact_candidate_group_id":"DUP_f8906be1b30e5c21","exact_candidate_members":["Радар-1705"],"address_candidate_group_id":"