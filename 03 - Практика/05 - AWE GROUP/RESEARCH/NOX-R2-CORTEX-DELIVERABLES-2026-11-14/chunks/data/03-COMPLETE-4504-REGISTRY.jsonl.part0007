{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1675","origin":{"collection":"Радар","original_row_number":1675,"raw_json_pointer":"/1674"},"raw":{"description":"fosrl/pangolin — Pangolin обеспечивает безопасный удаленный доступ к ресурсам с учетом идентификации пользователей. Он позволяет создавать виртуальные частные сети и прокси-серверы, которые защищают данные и обеспечивают конфиденциальность. Этот инструмент идеально подходит для организаций, стремящихся защитить свои сети и управлять доступом к критически важным ресурсам. — ❤","link":"https://github.com/fosrl/pangolin"},"raw_record_json":"{\"description\":\"fosrl/pangolin — Pangolin обеспечивает безопасный удаленный доступ к ресурсам с учетом идентификации пользователей. Он позволяет создавать виртуальные частные сети и прокси-серверы, которые защищают данные и обеспечивают конфиденциальность. Этот инструмент идеально подходит для организаций, стремящихся защитить свои сети и управлять доступом к критически важным ресурсам. — ❤\",\"link\":\"https://github.com/fosrl/pangolin\"}","identity":{"raw_url":"https://github.com/fosrl/pangolin","normalized_exact_url":"https://github.com/fosrl/pangolin","normalized_address_key":"github.com/fosrl/pangolin","url_host":"github.com","owner_repo":"fosrl/pangolin"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-1675.md","card_sha256":"1b1634576cad7b70afa879cb583d5d839a02f7a95945b387d7ff9a767f7d323c","exact_candidate_group_id":"DUP_286dd44c8a5edc83","exact_candidate_members":["Радар-1675"],"address_candidate_group_id