{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1696","origin":{"collection":"Радар","original_row_number":1696,"raw_json_pointer":"/1695"},"raw":{"description":"Snouzy/workout-cool — Современная платформа для фитнес-тренировок с открытым исходным кодом. Пользователи могут создавать индивидуальные планы тренировок, отслеживать свой прогресс и получать доступ к обширной базе упражнений. Это решение подходит как для новичков, так и для опытных спортсменов, стремящихся улучшить свои результаты. Платформа помогает организовать тренировки и сделать процесс более структурированным. — edited","link":"https://github.com/Snouzy/workout-cool"},"raw_record_json":"{\"description\":\"Snouzy/workout-cool — Современная платформа для фитнес-тренировок с открытым исходным кодом. Пользователи могут создавать индивидуальные планы тренировок, отслеживать свой прогресс и получать доступ к обширной базе упражнений. Это решение подходит как для новичков, так и для опытных спортсменов, стремящихся улучшить свои результаты. Платформа помогает организовать тренировки и сделать процесс более структурированным. — edited\",\"link\":\"https://github.com/Snouzy/workout-cool\"}","identity":{"raw_url":"https://github.com/Snouzy/workout-cool","normalized_exact_url":"https://github.com/snouzy/workout-cool","normalized_address_key":"github.com/snouzy/workout-cool","url_host":"github.com","owner_repo":"Snouzy/workout-cool"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1696.md","card_sha256":"cbe428909f6a86e4cea80961d688f4a52587d0f61