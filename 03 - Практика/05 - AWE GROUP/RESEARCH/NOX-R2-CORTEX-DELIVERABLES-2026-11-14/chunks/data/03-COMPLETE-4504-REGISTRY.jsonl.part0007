{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1753","origin":{"collection":"Радар","original_row_number":1753,"raw_json_pointer":"/1752"},"raw":{"description":"rxi/sj.h — Библиотека «sj.h» предназначена для простого и эффективного разбора JSON-данных. Она позволяет разработчикам быстро извлекать информацию из JSON-формата, минимизируя время на написание кода для парсинга. Подходит для использования в различных приложениях, где требуется обработка JSON, обеспечивая легкость интеграции и высокую производительность.","link":"https://github.com/rxi/sj.h"},"raw_record_json":"{\"description\":\"rxi/sj.h — Библиотека «sj.h» предназначена для простого и эффективного разбора JSON-данных. Она позволяет разработчикам быстро извлекать информацию из JSON-формата, минимизируя время на написание кода для парсинга. Подходит для использования в различных приложениях, где требуется обработка JSON, обеспечивая легкость интеграции и высокую производительность.\",\"link\":\"https://github.com/rxi/sj.h\"}","identity":{"raw_url":"https://github.com/rxi/sj.h","normalized_exact_url":"https://github.com/rxi/sj.h","normalized_address_key":"github.com/rxi/sj.h","url_host":"github.com","owner_repo":"rxi/sj.h"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1753.md","card_sha256":"487e553df9c48c40869ff578a9d1545f5ab4c631bab7ae0dde4276465009c5cd","exact_candidate_group_id":"DUP_7e4a760e8e680578","exact_candidate_members":["Радар-1753"],"address_candidate_group_id":"DUP_046b139a06dc1479","address_candidate_membe