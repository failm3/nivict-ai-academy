{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1405","origin":{"collection":"Радар","original_row_number":1405,"raw_json_pointer":"/1404"},"raw":{"description":"wanshuiyin/Auto-claude-code-research-in-sleep — Auto-claude-code-research-in-sleep предлагает легковесные инструменты для автономного машинного обучения, позволяя проводить обзор моделей, генерировать идеи и автоматизировать эксперименты. Решение не привязано к конкретным фреймворкам и совместимо с различными LLM-агентами, такими как Claude Code и Codex.","link":"https://github.com/wanshuiyin/Auto-claude-code-research-in-sleep"},"raw_record_json":"{\"description\":\"wanshuiyin/Auto-claude-code-research-in-sleep — Auto-claude-code-research-in-sleep предлагает легковесные инструменты для автономного машинного обучения, позволяя проводить обзор моделей, генерировать идеи и автоматизировать эксперименты. Решение не привязано к конкретным фреймворкам и совместимо с различными LLM-агентами, такими как Claude Code и Codex.\",\"link\":\"https://github.com/wanshuiyin/Auto-claude-code-research-in-sleep\"}","identity":{"raw_url":"https://github.com/wanshuiyin/Auto-claude-code-research-in-sleep","normalized_exact_url":"https://github.com/wanshuiyin/auto-claude-code-research-in-sleep","normalized_address_key":"github.com/wanshuiyin/auto-claude-code-research-in-sleep","url_host":"github.com","owner_repo":"wanshuiyin/Auto-claude-code-research-in-sleep"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","skills_competence","knowledge_ingestion"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Знания - Обучение и исследования","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Знания---Обучени