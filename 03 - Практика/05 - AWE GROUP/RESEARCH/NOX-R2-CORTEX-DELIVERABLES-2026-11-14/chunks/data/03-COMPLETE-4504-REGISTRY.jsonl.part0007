{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1737","origin":{"collection":"Радар","original_row_number":1737,"raw_json_pointer":"/1736"},"raw":{"description":"docling-project/docling — Docling помогает пользователям подготовить документы для работы с генеративным искусственным интеллектом. Он упрощает процесс структурирования и форматирования текстов, что позволяет эффективно использовать их в AI-приложениях. С помощью этого инструмента можно быстро адаптировать и оптимизировать материалы для автоматизированной обработки, что значительно экономит время и усилия.","link":"https://github.com/docling-project/docling"},"raw_record_json":"{\"description\":\"docling-project/docling — Docling помогает пользователям подготовить документы для работы с генеративным искусственным интеллектом. Он упрощает процесс структурирования и форматирования текстов, что позволяет эффективно использовать их в AI-приложениях. С помощью этого инструмента можно быстро адаптировать и оптимизировать материалы для автоматизированной обработки, что значительно экономит время и усилия.\",\"link\":\"https://github.com/docling-project/docling\"}","identity":{"raw_url":"https://github.com/docling-project/docling","normalized_exact_url":"https://github.com/docling-project/docling","normalized_address_key":"github.com/docling-project/docling","url_host":"github.com","owner_repo":"docling-project/docling"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1737.md",