{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1634","origin":{"collection":"Радар","original_row_number":1634,"raw_json_pointer":"/1633"},"raw":{"description":"diggerhq/digger — Digger упрощает управление инфраструктурой как код (IaC) в существующих CI/CD процессах. Он позволяет автоматизировать развертывание и обновление инфраструктуры, интегрируясь с уже настроенными пайплайнами. Пользователи могут легко управлять конфигурациями и обеспечивать согласованность окружений, что значительно снижает риски ошибок и ускоряет разработку.","link":"https://github.com/diggerhq/digger"},"raw_record_json":"{\"description\":\"diggerhq/digger — Digger упрощает управление инфраструктурой как код (IaC) в существующих CI/CD процессах. Он позволяет автоматизировать развертывание и обновление инфраструктуры, интегрируясь с уже настроенными пайплайнами. Пользователи могут легко управлять конфигурациями и обеспечивать согласованность окружений, что значительно снижает риски ошибок и ускоряет разработку.\",\"link\":\"https://github.com/diggerhq/digger\"}","identity":{"raw_url":"https://github.com/diggerhq/digger","normalized_exact_url":"https://github.com/diggerhq/digger","normalized_address_key":"github.com/diggerhq/digger","url_host":"github.com","owner_repo":"diggerhq/digger"},"classification":{"semantic_class":"workflow","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-1634.md","card_sha256":"1092673baa3c67d672e205b1aa424baa61734f90721e3ed58a47d7418dad87de","exact_candidate_group_id":"DUP_95145498d10bc7fe","exact_candidate_mem