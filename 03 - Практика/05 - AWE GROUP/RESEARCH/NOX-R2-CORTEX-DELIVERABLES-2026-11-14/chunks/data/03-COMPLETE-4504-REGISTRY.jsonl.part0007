{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1784","origin":{"collection":"Радар","original_row_number":1784,"raw_json_pointer":"/1783"},"raw":{"description":"nohajc/anylinuxfs — anylinuxfs позволяет монтировать файловые системы, поддерживаемые Linux, на macOS с возможностью чтения и записи. Используя NFS и микро-ВМ, пользователи могут легко интегрировать и управлять данными между двумя операционными системами. Это решение упрощает работу с файлами и совместное использование ресурсов, что особенно полезно для разработчиков и администраторов систем. — ❤","link":"https://github.com/nohajc/anylinuxfs"},"raw_record_json":"{\"description\":\"nohajc/anylinuxfs — anylinuxfs позволяет монтировать файловые системы, поддерживаемые Linux, на macOS с возможностью чтения и записи. Используя NFS и микро-ВМ, пользователи могут легко интегрировать и управлять данными между двумя операционными системами. Это решение упрощает работу с файлами и совместное использование ресурсов, что особенно полезно для разработчиков и администраторов систем. — ❤\",\"link\":\"https://github.com/nohajc/anylinuxfs\"}","identity":{"raw_url":"https://github.com/nohajc/anylinuxfs","normalized_exact_url":"https://github.com/nohajc/anylinuxfs","normalized_address_key":"github.com/nohajc/anylinuxfs","url_host":"github.com","owner_repo":"nohajc/anylinuxfs"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1784.md","card_sha256":"3250cf91600d681837218846c67f132a0284ca130941702f95c6daf7d80a405b","exact_candidate_group_id":"DUP_1cb1117b1bba17cc","exac