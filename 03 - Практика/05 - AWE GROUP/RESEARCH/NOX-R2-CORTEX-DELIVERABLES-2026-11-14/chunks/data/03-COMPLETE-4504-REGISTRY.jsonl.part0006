{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0986","origin":{"collection":"Радар","original_row_number":986,"raw_json_pointer":"/985"},"raw":{"description":"git-up/GitUp — GitUp — Git‑клиент для macOS с упором на работу через наглядный граф репозитория. Вместо набора команд вы напрямую «двигаете» историю: правите, переставляете, объединяете и исправляете коммиты прямо на схеме. — Важная часть — безопасность действий: почти всё поддерживает безлимитные undo/redo, включая rebase и merge, а ещё есть снимки состояния в стиле Time Machine для отката в один клик.","link":"https://github.com/git-up/GitUp"},"raw_record_json":"{\"description\":\"git-up/GitUp — GitUp — Git‑клиент для macOS с упором на работу через наглядный граф репозитория. Вместо набора команд вы напрямую «двигаете» историю: правите, переставляете, объединяете и исправляете коммиты прямо на схеме. — Важная часть — безопасность действий: почти всё поддерживает безлимитные undo/redo, включая rebase и merge, а ещё есть снимки состояния в стиле Time Machine для отката в один клик.\",\"link\":\"https://github.com/git-up/GitUp\"}","identity":{"raw_url":"https://github.com/git-up/GitUp","normalized_exact_url":"https://github.com/git-up/gitup","normalized_address_key":"github.com/git-up/gitup","url_host":"github.com","owner_repo":"git-up/GitUp"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-0986.md","card_sha256":"e4360e69dc0866bff893940bc55fce6ab5b609c5da10dea776ac8c23d95d4392","exact_candidate_group_id":"DUP_d2efa992264a42bc","exact_candidate_me