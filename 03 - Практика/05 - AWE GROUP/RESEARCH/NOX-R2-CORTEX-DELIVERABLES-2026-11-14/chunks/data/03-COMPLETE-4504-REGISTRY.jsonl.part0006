{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0928","origin":{"collection":"Радар","original_row_number":928,"raw_json_pointer":"/927"},"raw":{"description":"BrowserWorks/waterfox — Браузер на основе Firefox, из которого убраны телеметрия и встроенные механизмы слежки. Сбор данных сведён к минимуму — только то, что необходимо для работы. При этом совместимость с расширениями сохраняется: работают как классические, так и современные дополнения. — Waterfox позиционируется как замена Firefox без необходимости менять привычки.","link":"https://github.com/BrowserWorks/waterfox"},"raw_record_json":"{\"description\":\"BrowserWorks/waterfox — Браузер на основе Firefox, из которого убраны телеметрия и встроенные механизмы слежки. Сбор данных сведён к минимуму — только то, что необходимо для работы. При этом совместимость с расширениями сохраняется: работают как классические, так и современные дополнения. — Waterfox позиционируется как замена Firefox без необходимости менять привычки.\",\"link\":\"https://github.com/BrowserWorks/waterfox\"}","identity":{"raw_url":"https://github.com/BrowserWorks/waterfox","normalized_exact_url":"https://github.com/browserworks/waterfox","normalized_address_key":"github.com/browserworks/waterfox","url_host":"github.com","owner_repo":"BrowserWorks/waterfox"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-0928.md","card_sha256":"7bdfb02983a7cedecb231fdcd92c6c7177316d9e74987001166bfe92841e50d4","exact_candidate_group_id":"DUP_da4de4db235d4878","exact_candidate_members":["Рад