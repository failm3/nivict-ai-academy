{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0912","origin":{"collection":"Радар","original_row_number":912,"raw_json_pointer":"/911"},"raw":{"description":"OpenShot/openshot-qt — openshot-qt (OpenShot Video Editor) — бесплатный видеоредактор для Linux, macOS и Windows. Поддерживает множество форматов видео, аудио и изображений благодаря FFmpeg, подходит для сборки роликов из разнородных исходников. — Монтаж строится на таймлайне с неограниченным числом дорожек: обрезка, склейка, масштабирование, поворот, изменение скорости, покадровая точность.","link":"https://github.com/OpenShot/openshot-qt"},"raw_record_json":"{\"description\":\"OpenShot/openshot-qt — openshot-qt (OpenShot Video Editor) — бесплатный видеоредактор для Linux, macOS и Windows. Поддерживает множество форматов видео, аудио и изображений благодаря FFmpeg, подходит для сборки роликов из разнородных исходников. — Монтаж строится на таймлайне с неограниченным числом дорожек: обрезка, склейка, масштабирование, поворот, изменение скорости, покадровая точность.\",\"link\":\"https://github.com/OpenShot/openshot-qt\"}","identity":{"raw_url":"https://github.com/OpenShot/openshot-qt","normalized_exact_url":"https://github.com/openshot/openshot-qt","normalized_address_key":"github.com/openshot/openshot-qt","url_host":"github.com","owner_repo":"OpenShot/openshot-qt"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0912.md","card_sha256":"71b44abd24b697c3535aff1fd540d504cc2e595af4ce853ed899809538acedb0","exact_candidate_group_id":"DUP_a8a49e05fc1b2717","exact