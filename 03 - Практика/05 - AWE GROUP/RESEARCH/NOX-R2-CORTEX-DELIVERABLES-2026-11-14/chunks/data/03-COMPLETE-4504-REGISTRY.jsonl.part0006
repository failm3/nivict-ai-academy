{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1347","origin":{"collection":"Радар","original_row_number":1347,"raw_json_pointer":"/1346"},"raw":{"description":"bkaradzic/bgfx — bgfx — это кроссплатформенная библиотека для рендеринга, которая не привязана к конкретному графическому API. Она позволяет разработчикам легко интегрировать графику в свои проекты, независимо от используемого движка или фреймворка. С помощью bgfx можно создавать высококачественную графику для игр и приложений, обеспечивая гибкость и совместимость на разных платформах. — ❤","link":"https://github.com/bkaradzic/bgfx"},"raw_record_json":"{\"description\":\"bkaradzic/bgfx — bgfx — это кроссплатформенная библиотека для рендеринга, которая не привязана к конкретному графическому API. Она позволяет разработчикам легко интегрировать графику в свои проекты, независимо от используемого движка или фреймворка. С помощью bgfx можно создавать высококачественную графику для игр и приложений, обеспечивая гибкость и совместимость на разных платформах. — ❤\",\"link\":\"https://github.com/bkaradzic/bgfx\"}","identity":{"raw_url":"https://github.com/bkaradzic/bgfx","normalized_exact_url":"https://github.com/bkaradzic/bgfx","normalized_address_key":"github.com/bkaradzic/bgfx","url_host":"github.com","owner_repo":"bkaradzic/bgfx"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1347.md","card_sha256":"52001ad2cbfb52074bbc4f4fff26399a4136fb2d17f739b536b155a85cf75b73","exact_candidate_group_id":"DUP_41cb7789603aba60","exact_candidate_members":["Радар-1347"],"address_candidate_