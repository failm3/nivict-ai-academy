{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1007","origin":{"collection":"Радар","original_row_number":1007,"raw_json_pointer":"/1006"},"raw":{"description":"megadose/holehe — holehe — OSINT-инструмент, который проверяет, привязан ли конкретный email к аккаунтам на разных сервисах: от twitter и instagram до десятков других площадок (всего более 120). — Часть проверок опирается на механики «забыли пароль» и иногда вытягивает доступные фрагменты данных восстановления — например, частично скрытый резервный email или номер телефона.","link":"https://github.com/megadose/holehe"},"raw_record_json":"{\"description\":\"megadose/holehe — holehe — OSINT-инструмент, который проверяет, привязан ли конкретный email к аккаунтам на разных сервисах: от twitter и instagram до десятков других площадок (всего более 120). — Часть проверок опирается на механики «забыли пароль» и иногда вытягивает доступные фрагменты данных восстановления — например, частично скрытый резервный email или номер телефона.\",\"link\":\"https://github.com/megadose/holehe\"}","identity":{"raw_url":"https://github.com/megadose/holehe","normalized_exact_url":"https://github.com/megadose/holehe","normalized_address_key":"github.com/megadose/holehe","url_host":"github.com","owner_repo":"megadose/holehe"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-1007.md","card_sha256":"11d3200f160bab8186372c2754eaa45f36345a50dc2c65fc7f3218c5e5b230b1","exact_candidate_group_id":"DUP_2ef99fc1894ab5fc","exact_candidate_members":["Радар-1007"],"address_candidate_group_id":"DUP_e36e7156