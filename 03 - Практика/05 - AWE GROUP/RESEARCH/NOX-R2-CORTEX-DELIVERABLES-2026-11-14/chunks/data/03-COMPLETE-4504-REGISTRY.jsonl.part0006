{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1278","origin":{"collection":"Радар","original_row_number":1278,"raw_json_pointer":"/1277"},"raw":{"description":"PDFMathTranslate/PDFMathTranslate — PDFMathTranslate обеспечивает перевод научных статей в формате PDF с сохранением оригинального оформления. Пользователи могут легко переводить текст на разные языки, используя такие сервисы, как Google, DeepL, Ollama и OpenAI. Инструмент поддерживает различные интерфейсы, включая командную строку и графический интерфейс, а также интеграцию с Zotero. — ❤","link":"https://github.com/PDFMathTranslate/PDFMathTranslate"},"raw_record_json":"{\"description\":\"PDFMathTranslate/PDFMathTranslate — PDFMathTranslate обеспечивает перевод научных статей в формате PDF с сохранением оригинального оформления. Пользователи могут легко переводить текст на разные языки, используя такие сервисы, как Google, DeepL, Ollama и OpenAI. Инструмент поддерживает различные интерфейсы, включая командную строку и графический интерфейс, а также интеграцию с Zotero. — ❤\",\"link\":\"https://github.com/PDFMathTranslate/PDFMathTranslate\"}","identity":{"raw_url":"https://github.com/PDFMathTranslate/PDFMathTranslate","normalized_exact_url":"https://github.com/pdfmathtranslate/pdfmathtranslate","normalized_address_key":"github.com/pdfmathtranslate/pdfmathtranslate","url_host":"github.com","owner_repo":"PDFMathTranslate/PDFMathTranslate"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1278.md","card_sha256":"a640afa58ecb462790e636a41acc