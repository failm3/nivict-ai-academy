{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1341","origin":{"collection":"Радар","original_row_number":1341,"raw_json_pointer":"/1340"},"raw":{"description":"Worklenz/worklenz — Удобный инструмент для управления проектами, который помогает командам эффективно планировать, организовывать и отслеживать задачи. Он объединяет все необходимые функции для совместной работы, включая управление сроками, распределение ресурсов и мониторинг прогресса. Пользователи могут легко координировать действия, улучшать коммуникацию и повышать продуктивность. — 👍","link":"https://github.com/Worklenz/worklenz"},"raw_record_json":"{\"description\":\"Worklenz/worklenz — Удобный инструмент для управления проектами, который помогает командам эффективно планировать, организовывать и отслеживать задачи. Он объединяет все необходимые функции для совместной работы, включая управление сроками, распределение ресурсов и мониторинг прогресса. Пользователи могут легко координировать действия, улучшать коммуникацию и повышать продуктивность. — 👍\",\"link\":\"https://github.com/Worklenz/worklenz\"}","identity":{"raw_url":"https://github.com/Worklenz/worklenz","normalized_exact_url":"https://github.com/worklenz/worklenz","normalized_address_key":"github.com/worklenz/worklenz","url_host":"github.com","owner_repo":"Worklenz/worklenz"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1341.md","card_sha256":"0a789bf0e124410e4c0a4972f3ef64a5b8bf87a2e257f2e0c686422b4cf6200c","exact_candidate_group_id":"DUP_3fb8ead9b5c4603f","exact_candidate_m