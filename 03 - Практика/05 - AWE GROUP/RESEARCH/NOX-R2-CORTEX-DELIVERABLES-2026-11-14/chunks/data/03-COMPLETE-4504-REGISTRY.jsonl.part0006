{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1042","origin":{"collection":"Радар","original_row_number":1042,"raw_json_pointer":"/1041"},"raw":{"description":"ryanoasis/nerd-fonts — nerd-fonts — набор «пропатченных» шрифтов для разработчиков, где к привычным моноширинным гарнитурам добавлены тысячи пиктограмм. В коллекции есть варианты на базе Hack, Source Code Pro и других, всего более 3600 глифов. — Пригодится, когда в терминале, редакторе или статус-строке хочется видеть аккуратные иконки: для git-статусов, папок, языков, индикаторов и прочих символов.","link":"https://github.com/ryanoasis/nerd-fonts"},"raw_record_json":"{\"description\":\"ryanoasis/nerd-fonts — nerd-fonts — набор «пропатченных» шрифтов для разработчиков, где к привычным моноширинным гарнитурам добавлены тысячи пиктограмм. В коллекции есть варианты на базе Hack, Source Code Pro и других, всего более 3600 глифов. — Пригодится, когда в терминале, редакторе или статус-строке хочется видеть аккуратные иконки: для git-статусов, папок, языков, индикаторов и прочих символов.\",\"link\":\"https://github.com/ryanoasis/nerd-fonts\"}","identity":{"raw_url":"https://github.com/ryanoasis/nerd-fonts","normalized_exact_url":"https://github.com/ryanoasis/nerd-fonts","normalized_address_key":"github.com/ryanoasis/nerd-fonts","url_host":"github.com","owner_repo":"ryanoasis/nerd-fonts"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-1042.md","card_sha256":"c6ff8f13fb106281558eff16dc681f543feaa2c036c8824afd4769e0828bbdd7","exact_candidate_group_id":"D