{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1041","origin":{"collection":"Радар","original_row_number":1041,"raw_json_pointer":"/1040"},"raw":{"description":"ianstormtaylor/slate — slate — фреймворк для сборки rich text‑редакторов в веб‑приложениях. Подходит, когда нужен интерфейс уровня Medium или Google Docs: форматирование, сложные блоки и «умное» поведение при вводе. — Архитектура строится вокруг плагинов: логику и возможности редактора можно наращивать и менять без жёстких ограничений «ядра».","link":"https://github.com/ianstormtaylor/slate"},"raw_record_json":"{\"description\":\"ianstormtaylor/slate — slate — фреймворк для сборки rich text‑редакторов в веб‑приложениях. Подходит, когда нужен интерфейс уровня Medium или Google Docs: форматирование, сложные блоки и «умное» поведение при вводе. — Архитектура строится вокруг плагинов: логику и возможности редактора можно наращивать и менять без жёстких ограничений «ядра».\",\"link\":\"https://github.com/ianstormtaylor/slate\"}","identity":{"raw_url":"https://github.com/ianstormtaylor/slate","normalized_exact_url":"https://github.com/ianstormtaylor/slate","normalized_address_key":"github.com/ianstormtaylor/slate","url_host":"github.com","owner_repo":"ianstormtaylor/slate"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1041.md","card_sha256":"5634d4c3387c2e89d212bf2d73b97b26b5c283c84ddb5a531d5c58631f461d20","exact_candidate_group_id":"DUP_000f951d9cb553c9","exact_candidate_members":["Радар-1041"],"address_candidate_group_id":"DUP_135112440