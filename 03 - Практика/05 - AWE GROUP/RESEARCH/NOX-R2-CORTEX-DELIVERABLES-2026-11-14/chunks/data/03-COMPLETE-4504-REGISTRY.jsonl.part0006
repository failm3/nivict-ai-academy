{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1043","origin":{"collection":"Радар","original_row_number":1043,"raw_json_pointer":"/1042"},"raw":{"description":"apernet/hysteria — hysteria — быстрый прокси, рассчитанный на нестабильные и «шумные» сети. Работает поверх модифицированного QUIC и умеет передавать трафик в разных режимах: SOCKS5, HTTP Proxy, TCP/UDP forwarding. — Протокол маскируется под обычный HTTP/3‑трафик, поэтому его сложнее отличить и заблокировать точечно.","link":"https://github.com/apernet/hysteria"},"raw_record_json":"{\"description\":\"apernet/hysteria — hysteria — быстрый прокси, рассчитанный на нестабильные и «шумные» сети. Работает поверх модифицированного QUIC и умеет передавать трафик в разных режимах: SOCKS5, HTTP Proxy, TCP/UDP forwarding. — Протокол маскируется под обычный HTTP/3‑трафик, поэтому его сложнее отличить и заблокировать точечно.\",\"link\":\"https://github.com/apernet/hysteria\"}","identity":{"raw_url":"https://github.com/apernet/hysteria","normalized_exact_url":"https://github.com/apernet/hysteria","normalized_address_key":"github.com/apernet/hysteria","url_host":"github.com","owner_repo":"apernet/hysteria"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-1043.md","card_sha256":"98b8e360a4b7eb5fa262bc33c58696549be664e186d3a2fd399ce959106de044","exact_candidate_group_id":"DUP_730c9f73e936241e","exact_candidate_members":["Радар-1043"],"address_candidate_group_id":"DUP_bc795ae7e92a24e2","address_candidate_members":["Радар