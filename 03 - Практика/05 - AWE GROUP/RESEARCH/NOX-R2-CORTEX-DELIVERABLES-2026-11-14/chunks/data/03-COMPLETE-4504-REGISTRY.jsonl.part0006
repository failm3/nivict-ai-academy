{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0935","origin":{"collection":"Радар","original_row_number":935,"raw_json_pointer":"/934"},"raw":{"description":"asmvik/yabai — yabai — тайловый менеджер окон для macOS на основе binary space partitioning. Он автоматически раскладывает окна по экрану, поддерживает работу с несколькими дисплеями и «Spaces», чтобы меньше тратить времени на ручное перетаскивание. — Управление — через командную строку; при желании горячие клавиши настраиваются внешними утилитами вроде skhd.","link":"https://github.com/asmvik/yabai"},"raw_record_json":"{\"description\":\"asmvik/yabai — yabai — тайловый менеджер окон для macOS на основе binary space partitioning. Он автоматически раскладывает окна по экрану, поддерживает работу с несколькими дисплеями и «Spaces», чтобы меньше тратить времени на ручное перетаскивание. — Управление — через командную строку; при желании горячие клавиши настраиваются внешними утилитами вроде skhd.\",\"link\":\"https://github.com/asmvik/yabai\"}","identity":{"raw_url":"https://github.com/asmvik/yabai","normalized_exact_url":"https://github.com/asmvik/yabai","normalized_address_key":"github.com/asmvik/yabai","url_host":"github.com","owner_repo":"asmvik/yabai"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0935.md","card_sha256":"7968cfc799f0a391b8f9196b93fa71823846274893c6edffca60159e87cd600e","exact_candidate_group_id":"DUP_c71e4d05a9fcb21c","exact_candidate_members":["Радар-0935"],"address_candidate_group_id":"DUP_9f061a0ce56878c9","address_candidate_membe