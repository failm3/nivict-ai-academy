{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0994","origin":{"collection":"Радар","original_row_number":994,"raw_json_pointer":"/993"},"raw":{"description":"jonas/tig — tig — текстовый интерфейс для git в терминале. Показывает историю коммитов, ветки и теги в виде удобного списка, позволяет быстро перемещаться по репозиторию без графических клиентов. — Подходит, когда работаешь по SSH или просто предпочитаешь консоль: можно открыть детали коммита, посмотреть diff и пройтись по изменениям прямо из одного экрана, не переключаясь между командами.","link":"https://github.com/jonas/tig"},"raw_record_json":"{\"description\":\"jonas/tig — tig — текстовый интерфейс для git в терминале. Показывает историю коммитов, ветки и теги в виде удобного списка, позволяет быстро перемещаться по репозиторию без графических клиентов. — Подходит, когда работаешь по SSH или просто предпочитаешь консоль: можно открыть детали коммита, посмотреть diff и пройтись по изменениям прямо из одного экрана, не переключаясь между командами.\",\"link\":\"https://github.com/jonas/tig\"}","identity":{"raw_url":"https://github.com/jonas/tig","normalized_exact_url":"https://github.com/jonas/tig","normalized_address_key":"github.com/jonas/tig","url_host":"github.com","owner_repo":"jonas/tig"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0994.md","card_sha256":"15dcd547e0ace1ee37c22d6de079838843ac31bc7bc8e8ebae08275af6de5def","exact_candidate_group_id":"DUP_aff7c4311d23f384","exact_candidate_members":["Радар-0994"],"address_candidate_group_i