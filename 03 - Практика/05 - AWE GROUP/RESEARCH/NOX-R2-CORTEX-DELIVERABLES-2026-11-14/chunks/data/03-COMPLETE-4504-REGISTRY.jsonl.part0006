{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1044","origin":{"collection":"Радар","original_row_number":1044,"raw_json_pointer":"/1043"},"raw":{"description":"home-assistant/core — Home Assistant core — платформа домашней автоматизации с упором на локальное управление и приватность. Сценарий простой: устройства и сценарии работают в вашей сети, без обязательной привязки к облаку. — Обычно ставят на Raspberry Pi или домашний сервер. Через интерфейс можно объединять разные устройства и сервисы, настраивать автоматизации и следить за состояниями в одном месте.","link":"https://github.com/home-assistant/core"},"raw_record_json":"{\"description\":\"home-assistant/core — Home Assistant core — платформа домашней автоматизации с упором на локальное управление и приватность. Сценарий простой: устройства и сценарии работают в вашей сети, без обязательной привязки к облаку. — Обычно ставят на Raspberry Pi или домашний сервер. Через интерфейс можно объединять разные устройства и сервисы, настраивать автоматизации и следить за состояниями в одном месте.\",\"link\":\"https://github.com/home-assistant/core\"}","identity":{"raw_url":"https://github.com/home-assistant/core","normalized_exact_url":"https://github.com/home-assistant/core","normalized_address_key":"github.com/home-assistant/core","url_host":"github.com","owner_repo":"home-assistant/core"},"classification":{"semantic_class":"workflow","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance","execution_automation","observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-1044.md","card_sha256":"a89f2b8b80c5e07131ecf3d70670cb7be499cea296363a5d