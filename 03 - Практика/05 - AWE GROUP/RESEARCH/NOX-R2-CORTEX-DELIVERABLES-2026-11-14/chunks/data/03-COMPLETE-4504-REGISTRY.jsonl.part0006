{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0913","origin":{"collection":"Радар","original_row_number":913,"raw_json_pointer":"/912"},"raw":{"description":"asciinema/asciinema — asciinema записывает сессии терминала и умеет транслировать их вживую. Вместо тяжёлых видео сохраняет текстовый «слепок» вывода в формате .cast, который хорошо сжимается и остаётся читаемым как терминальная запись. — Запись можно воспроизвести прямо в терминале: менять скорость, ставить на паузу, зацикливать, ограничивать простои, переходить пошагово и прыгать по маркерам.","link":"https://github.com/asciinema/asciinema"},"raw_record_json":"{\"description\":\"asciinema/asciinema — asciinema записывает сессии терминала и умеет транслировать их вживую. Вместо тяжёлых видео сохраняет текстовый «слепок» вывода в формате .cast, который хорошо сжимается и остаётся читаемым как терминальная запись. — Запись можно воспроизвести прямо в терминале: менять скорость, ставить на паузу, зацикливать, ограничивать простои, переходить пошагово и прыгать по маркерам.\",\"link\":\"https://github.com/asciinema/asciinema\"}","identity":{"raw_url":"https://github.com/asciinema/asciinema","normalized_exact_url":"https://github.com/asciinema/asciinema","normalized_address_key":"github.com/asciinema/asciinema","url_host":"github.com","owner_repo":"asciinema/asciinema"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0913.md","card_sha256":"1ab0c6e0829b2c1c80365f9db4f2a7cf7f1f37f3053e5a008c77eaf9c0aa3f91","exact_candidate_group_id":"DUP_2a4ef323ccb8c14