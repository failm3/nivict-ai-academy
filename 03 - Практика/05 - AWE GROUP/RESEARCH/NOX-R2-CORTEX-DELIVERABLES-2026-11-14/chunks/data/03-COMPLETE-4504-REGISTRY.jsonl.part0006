{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1350","origin":{"collection":"Радар","original_row_number":1350,"raw_json_pointer":"/1349"},"raw":{"description":"ruvnet/ruflo — Платформа «ruflo» позволяет эффективно управлять многими агентами, обеспечивая координацию автономных процессов и создание систем разговорного ИИ. Она поддерживает распределённый интеллект агентов и интеграцию с Claude, что делает её идеальным решением для разработки сложных приложений.","link":"https://github.com/ruvnet/ruflo"},"raw_record_json":"{\"description\":\"ruvnet/ruflo — Платформа «ruflo» позволяет эффективно управлять многими агентами, обеспечивая координацию автономных процессов и создание систем разговорного ИИ. Она поддерживает распределённый интеллект агентов и интеграцию с Claude, что делает её идеальным решением для разработки сложных приложений.\",\"link\":\"https://github.com/ruvnet/ruflo\"}","identity":{"raw_url":"https://github.com/ruvnet/ruflo","normalized_exact_url":"https://github.com/ruvnet/ruflo","normalized_address_key":"github.com/ruvnet/ruflo","url_host":"github.com","owner_repo":"ruvnet/ruflo"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["C_EXECUTION_STRATEGY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-1350.md","card_sha256":"286506aa9204c82fed7af9c8156fc46d961b01e0bef67e329e7e6c1e15115a7c","exact_candidate_group_id":"DUP_e90565626d35e8d2","exact_candidate_members":["Радар-1350"],"address_candidate_group_id":"DUP_a59a069139bfa48e","address_candidate_members":["Радар-1350"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTED","verdict":"H","research_status":"DOCUMENTED_L1_