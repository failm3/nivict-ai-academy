{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1276","origin":{"collection":"Радар","original_row_number":1276,"raw_json_pointer":"/1275"},"raw":{"description":"golutra/golutra — «golutra» — это инструмент для автоматизации процессов управления проектами и задачами. Он помогает командам эффективно планировать, отслеживать прогресс и координировать действия, минимизируя время на рутинные операции. Пользователи смогут легко делиться информацией, устанавливать приоритеты и контролировать выполнение задач. — ❤","link":"https://github.com/golutra/golutra"},"raw_record_json":"{\"description\":\"golutra/golutra — «golutra» — это инструмент для автоматизации процессов управления проектами и задачами. Он помогает командам эффективно планировать, отслеживать прогресс и координировать действия, минимизируя время на рутинные операции. Пользователи смогут легко делиться информацией, устанавливать приоритеты и контролировать выполнение задач. — ❤\",\"link\":\"https://github.com/golutra/golutra\"}","identity":{"raw_url":"https://github.com/golutra/golutra","normalized_exact_url":"https://github.com/golutra/golutra","normalized_address_key":"github.com/golutra/golutra","url_host":"github.com","owner_repo":"golutra/golutra"},"classification":{"semantic_class":"workflow","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1276.md","card_sha256":"88be383ce7fed227c1b609b02b535fb6490fae05cb54fd00013998e1c71c730e","exact_candidate_group_id":"DUP_f249e82750cfc941","exact_candidate_members":["Радар-1276"],"address_candidate_group_id":"DUP_3de1a9c4fd07bf93","address_candidate_mem