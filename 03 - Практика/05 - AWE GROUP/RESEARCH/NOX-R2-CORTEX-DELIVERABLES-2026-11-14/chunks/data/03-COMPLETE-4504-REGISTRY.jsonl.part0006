{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1088","origin":{"collection":"Радар","original_row_number":1088,"raw_json_pointer":"/1087"},"raw":{"description":"ImageOptim/ImageOptim — ImageOptim — графический оптимизатор изображений для macOS. Перетаскиваете PNG, JPEG, GIF или SVG в окно — и получаете файлы меньшего размера без потери качества, за счёт набора проверенных lossless-утилит. — Подходит, когда нужно быстро подготовить картинки для сайта, приложения или рассылки: уменьшить вес, ускорить загрузку и при этом не трогать визуальное качество.","link":"https://github.com/ImageOptim/ImageOptim"},"raw_record_json":"{\"description\":\"ImageOptim/ImageOptim — ImageOptim — графический оптимизатор изображений для macOS. Перетаскиваете PNG, JPEG, GIF или SVG в окно — и получаете файлы меньшего размера без потери качества, за счёт набора проверенных lossless-утилит. — Подходит, когда нужно быстро подготовить картинки для сайта, приложения или рассылки: уменьшить вес, ускорить загрузку и при этом не трогать визуальное качество.\",\"link\":\"https://github.com/ImageOptim/ImageOptim\"}","identity":{"raw_url":"https://github.com/ImageOptim/ImageOptim","normalized_exact_url":"https://github.com/imageoptim/imageoptim","normalized_address_key":"github.com/imageoptim/imageoptim","url_host":"github.com","owner_repo":"ImageOptim/ImageOptim"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable"],"contours":["D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Изображения и графика","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Изображения-и-графика/Радар-1088.md","card_sha256":"9cce975621d2d2a68bcba1d52031989b3ffc0868aab93642a07e0992839f746c","exact_candidate_group_id":"DUP_08f6