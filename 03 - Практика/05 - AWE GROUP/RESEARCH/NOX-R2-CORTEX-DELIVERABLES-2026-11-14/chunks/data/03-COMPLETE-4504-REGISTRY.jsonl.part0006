{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1014","origin":{"collection":"Радар","original_row_number":1014,"raw_json_pointer":"/1013"},"raw":{"description":"docmirror/dev-sidecar — dev-sidecar — настольный инструмент, который через локальный прокси ускоряет доступ к зарубежным сервисам, когда они открываются медленно или нестабильно. Работает на Windows, macOS и Linux, автоматически настраивает системный прокси и может оптимизировать DNS, подбирая более удачные IP для доменов. — ❤","link":"https://github.com/docmirror/dev-sidecar"},"raw_record_json":"{\"description\":\"docmirror/dev-sidecar — dev-sidecar — настольный инструмент, который через локальный прокси ускоряет доступ к зарубежным сервисам, когда они открываются медленно или нестабильно. Работает на Windows, macOS и Linux, автоматически настраивает системный прокси и может оптимизировать DNS, подбирая более удачные IP для доменов. — ❤\",\"link\":\"https://github.com/docmirror/dev-sidecar\"}","identity":{"raw_url":"https://github.com/docmirror/dev-sidecar","normalized_exact_url":"https://github.com/docmirror/dev-sidecar","normalized_address_key":"github.com/docmirror/dev-sidecar","url_host":"github.com","owner_repo":"docmirror/dev-sidecar"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-1014.md","card_sha256":"9178a16c164986e93094e6579bf22abb2a8b9ceee4e0663ddc36bf119f7db05b","exact_candidate_group_id":"DUP_c0276ea6a0d83138","exact_candidate_members":["Радар-1014"],"address_candidate_group_id":"DUP_d0ae5ee2fb5