{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1344","origin":{"collection":"Радар","original_row_number":1344,"raw_json_pointer":"/1343"},"raw":{"description":"vudovn/antigravity-kit — antigravity-kit предлагает набор инструментов для разработчиков, позволяющий легко интегрировать функции управления гравитацией в приложения. С его помощью можно моделировать физические эффекты, создавать интерактивные элементы и улучшать пользовательский опыт в играх и симуляциях. Этот репозиторий упрощает работу с физикой, предоставляя готовые решения для реализации сложных задач.","link":"https://github.com/vudovn/antigravity-kit"},"raw_record_json":"{\"description\":\"vudovn/antigravity-kit — antigravity-kit предлагает набор инструментов для разработчиков, позволяющий легко интегрировать функции управления гравитацией в приложения. С его помощью можно моделировать физические эффекты, создавать интерактивные элементы и улучшать пользовательский опыт в играх и симуляциях. Этот репозиторий упрощает работу с физикой, предоставляя готовые решения для реализации сложных задач.\",\"link\":\"https://github.com/vudovn/antigravity-kit\"}","identity":{"raw_url":"https://github.com/vudovn/antigravity-kit","normalized_exact_url":"https://github.com/vudovn/antigravity-kit","normalized_address_key":"github.com/vudovn/antigravity-kit","url_host":"github.com","owner_repo":"vudovn/antigravity-kit"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Игры и интерактив","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Игры-и-интерактив/Радар-1344.md","card_sha256":"461d84ce2208b5e80d860544c289ebe750d86621c2faa4444b5d7c1f342f5ee9","exact_candidate_group_id":"DUP_0f9494fd25238d7d","