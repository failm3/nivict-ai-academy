{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1024","origin":{"collection":"Радар","original_row_number":1024,"raw_json_pointer":"/1023"},"raw":{"description":"wtfutil/wtf — WTF (wtfutil) — персональная информационная панель прямо в терминале. На одном экране собирает «редко нужные, но важные» показатели и данные, чтобы быстро взглянуть и вернуться к работе. — Подходит тем, кто живёт в консоли и хочет держать под рукой сводку без переключения между вкладками и сервисами: открыл терминал — увидел актуальную картину.","link":"https://github.com/wtfutil/wtf"},"raw_record_json":"{\"description\":\"wtfutil/wtf — WTF (wtfutil) — персональная информационная панель прямо в терминале. На одном экране собирает «редко нужные, но важные» показатели и данные, чтобы быстро взглянуть и вернуться к работе. — Подходит тем, кто живёт в консоли и хочет держать под рукой сводку без переключения между вкладками и сервисами: открыл терминал — увидел актуальную картину.\",\"link\":\"https://github.com/wtfutil/wtf\"}","identity":{"raw_url":"https://github.com/wtfutil/wtf","normalized_exact_url":"https://github.com/wtfutil/wtf","normalized_address_key":"github.com/wtfutil/wtf","url_host":"github.com","owner_repo":"wtfutil/wtf"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-1024.md","card_sha256":"badad3ac604867ef45c357a9871045e5b19a12aa3875a014ef3befbea06c33fd","exact_candidate_group_id":"DUP_cfda4442a78cb245","exact_candidate_members":["Радар-1024"],"address_candidate_group_id":"DUP_e21f7707faf0697e","address_candidate_members":["Радар-1024"]}