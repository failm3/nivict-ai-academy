{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0972","origin":{"collection":"Радар","original_row_number":972,"raw_json_pointer":"/971"},"raw":{"description":"thunderbird/thunderbird-android — thunderbird-android — почтовое приложение для Android с открытым исходным кодом и акцентом на приватность. Оно не рассматривает личные данные как товар и подходит тем, кто хочет держать переписку под контролем. — Внутри — работа с несколькими почтовыми аккаунтами в одном месте и режим Unified Inbox, где письма собираются в общий список.","link":"https://github.com/thunderbird/thunderbird-android"},"raw_record_json":"{\"description\":\"thunderbird/thunderbird-android — thunderbird-android — почтовое приложение для Android с открытым исходным кодом и акцентом на приватность. Оно не рассматривает личные данные как товар и подходит тем, кто хочет держать переписку под контролем. — Внутри — работа с несколькими почтовыми аккаунтами в одном месте и режим Unified Inbox, где письма собираются в общий список.\",\"link\":\"https://github.com/thunderbird/thunderbird-android\"}","identity":{"raw_url":"https://github.com/thunderbird/thunderbird-android","normalized_exact_url":"https://github.com/thunderbird/thunderbird-android","normalized_address_key":"github.com/thunderbird/thunderbird-android","url_host":"github.com","owner_repo":"thunderbird/thunderbird-android"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0972.md","card_sha256":"da66f605e866b5d289ef9752d789d6356fc61021a4ad46cd6cb057920336223d","exact_candidate_group