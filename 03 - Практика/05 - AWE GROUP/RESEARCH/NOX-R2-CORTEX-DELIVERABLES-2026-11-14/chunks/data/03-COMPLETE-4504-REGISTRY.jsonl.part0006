{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1021","origin":{"collection":"Радар","original_row_number":1021,"raw_json_pointer":"/1020"},"raw":{"description":"alibaba/weex — weex — фреймворк для создания кроссплатформенного мобильного интерфейса. Подходит, когда один и тот же UI требуется запускать на разных платформах без отдельной реализации под каждую. — Целевые среды: Android 4.1+ (API 16), iOS 9.0+ и WebKit 534.30+. В итоге получается единый подход к сборке экранов и компонентов, который можно использовать в мобильных приложениях и в окружениях на базе WebKit.","link":"https://github.com/alibaba/weex"},"raw_record_json":"{\"description\":\"alibaba/weex — weex — фреймворк для создания кроссплатформенного мобильного интерфейса. Подходит, когда один и тот же UI требуется запускать на разных платформах без отдельной реализации под каждую. — Целевые среды: Android 4.1+ (API 16), iOS 9.0+ и WebKit 534.30+. В итоге получается единый подход к сборке экранов и компонентов, который можно использовать в мобильных приложениях и в окружениях на базе WebKit.\",\"link\":\"https://github.com/alibaba/weex\"}","identity":{"raw_url":"https://github.com/alibaba/weex","normalized_exact_url":"https://github.com/alibaba/weex","normalized_address_key":"github.com/alibaba/weex","url_host":"github.com","owner_repo":"alibaba/weex"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1021.md","card_sha256":"a576c01740276002eb94a6b3b5825115267fc282641b006726311df59d5ed4fe","exact_candidate_group_id":"DUP_644b1af954ff087a",