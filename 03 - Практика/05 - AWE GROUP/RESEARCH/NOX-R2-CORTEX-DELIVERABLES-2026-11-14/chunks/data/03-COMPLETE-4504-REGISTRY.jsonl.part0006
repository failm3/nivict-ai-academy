{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1286","origin":{"collection":"Радар","original_row_number":1286,"raw_json_pointer":"/1285"},"raw":{"description":"ByteDance-Seed/Depth-Anything-3 — Depth-Anything-3 предоставляет инструменты для работы с глубиной изображения, позволяя пользователям создавать и редактировать 3D-сцены с высокой точностью. С его помощью можно легко извлекать глубинную информацию из 2D-изображений, что открывает новые горизонты для художников, дизайнеров и разработчиков. — ⚡","link":"https://github.com/ByteDance-Seed/Depth-Anything-3"},"raw_record_json":"{\"description\":\"ByteDance-Seed/Depth-Anything-3 — Depth-Anything-3 предоставляет инструменты для работы с глубиной изображения, позволяя пользователям создавать и редактировать 3D-сцены с высокой точностью. С его помощью можно легко извлекать глубинную информацию из 2D-изображений, что открывает новые горизонты для художников, дизайнеров и разработчиков. — ⚡\",\"link\":\"https://github.com/ByteDance-Seed/Depth-Anything-3\"}","identity":{"raw_url":"https://github.com/ByteDance-Seed/Depth-Anything-3","normalized_exact_url":"https://github.com/bytedance-seed/depth-anything-3","normalized_address_key":"github.com/bytedance-seed/depth-anything-3","url_host":"github.com","owner_repo":"ByteDance-Seed/Depth-Anything-3"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","professional_deliverable"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1286.md","card_sha256":"3115c059c5f116727aea4e0705c7ddf89d03292dba9df969406dd85e51f5b00f","exact_candidate_group_id":"DUP_15a2e703ad3fe85b","exact_candidate_