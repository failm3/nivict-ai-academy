{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1982","origin":{"collection":"Радар","original_row_number":1982,"raw_json_pointer":"/1981"},"raw":{"description":"remorses/playwriter — Playwriter — это расширение для браузера, которое упрощает работу с текстами, устраняя лишний контекст и повышая удобство взаимодействия. Оно помогает пользователям быстро и эффективно редактировать и структурировать свои записи, делая процесс более интуитивным и продуктивным.","link":"https://github.com/remorses/playwriter"},"raw_record_json":"{\"description\":\"remorses/playwriter — Playwriter — это расширение для браузера, которое упрощает работу с текстами, устраняя лишний контекст и повышая удобство взаимодействия. Оно помогает пользователям быстро и эффективно редактировать и структурировать свои записи, делая процесс более интуитивным и продуктивным.\",\"link\":\"https://github.com/remorses/playwriter\"}","identity":{"raw_url":"https://github.com/remorses/playwriter","normalized_exact_url":"https://github.com/remorses/playwriter","normalized_address_key":"github.com/remorses/playwriter","url_host":"github.com","owner_repo":"remorses/playwriter"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1982.md","card_sha256":"5e39d238f13eb09d9d5ebf2ec1a872dd4c7593f227b8dbba95bff2905db7cb7a","exact_candidate_group_id":"DUP_297e9dae3f217849","exact_candidate_members":["Радар-1982"],"address_candidate_group_id":"DUP_522ca31b84696957","address_candidate_members":["Радар-1982"]},"status":{"maturity_stage":"RAW_CANDIDATE","read