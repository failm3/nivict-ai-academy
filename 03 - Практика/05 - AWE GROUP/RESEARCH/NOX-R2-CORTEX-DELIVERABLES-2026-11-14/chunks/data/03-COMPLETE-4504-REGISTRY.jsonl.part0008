{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2173","origin":{"collection":"Радар","original_row_number":2173,"raw_json_pointer":"/2172"},"raw":{"description":"imputnet/helium — Helium — это быстрый и безопасный веб-браузер, который обеспечивает приватность пользователей при серфинге в интернете. Он блокирует отслеживание и рекламу, позволяя сосредоточиться на контенте без лишних отвлечений. Удобный интерфейс и высокая скорость загрузки страниц делают его идеальным выбором для тех, кто ценит эффективность и безопасность в сети. — 👍","link":"https://github.com/imputnet/helium"},"raw_record_json":"{\"description\":\"imputnet/helium — Helium — это быстрый и безопасный веб-браузер, который обеспечивает приватность пользователей при серфинге в интернете. Он блокирует отслеживание и рекламу, позволяя сосредоточиться на контенте без лишних отвлечений. Удобный интерфейс и высокая скорость загрузки страниц делают его идеальным выбором для тех, кто ценит эффективность и безопасность в сети. — 👍\",\"link\":\"https://github.com/imputnet/helium\"}","identity":{"raw_url":"https://github.com/imputnet/helium","normalized_exact_url":"https://github.com/imputnet/helium","normalized_address_key":"github.com/imputnet/helium","url_host":"github.com","owner_repo":"imputnet/helium"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance","observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2173.md","card_sha256":"2df043b4a23a602a85bc65dbccc67d0a30246ceb28f4cbf728f70064b67a0e77","exact_candidate_group_id":"DUP_5fcc64133a3465d4","exact_candidate_members":["Рад