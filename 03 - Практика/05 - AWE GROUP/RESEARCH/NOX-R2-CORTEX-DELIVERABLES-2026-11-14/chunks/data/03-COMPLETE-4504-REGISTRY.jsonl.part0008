{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2090","origin":{"collection":"Радар","original_row_number":2090,"raw_json_pointer":"/2089"},"raw":{"description":"nickrunning/wechat-selkies — wechat-selkies предлагает веб-версию WeChat и QQ на базе Selkies, обеспечивая удобный доступ к популярным мессенджерам через браузер. Поддержка локального ввода китайского языка делает общение более комфортным для пользователей, а совместимость с архитектурами AMD64 и ARM64 расширяет возможности использования на различных устройствах.","link":"https://github.com/nickrunning/wechat-selkies"},"raw_record_json":"{\"description\":\"nickrunning/wechat-selkies — wechat-selkies предлагает веб-версию WeChat и QQ на базе Selkies, обеспечивая удобный доступ к популярным мессенджерам через браузер. Поддержка локального ввода китайского языка делает общение более комфортным для пользователей, а совместимость с архитектурами AMD64 и ARM64 расширяет возможности использования на различных устройствах.\",\"link\":\"https://github.com/nickrunning/wechat-selkies\"}","identity":{"raw_url":"https://github.com/nickrunning/wechat-selkies","normalized_exact_url":"https://github.com/nickrunning/wechat-selkies","normalized_address_key":"github.com/nickrunning/wechat-selkies","url_host":"github.com","owner_repo":"nickrunning/wechat-selkies"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-2090.md","card_sha256":"333720b08948e3bcb83f1f6b4ee46a14a7d780a66c8dcc39aeb396bac6a453bf","exact_candidate_group_id":"DUP_836a40fdd0d5a061","exact_candidate_member