{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1901","origin":{"collection":"Радар","original_row_number":1901,"raw_json_pointer":"/1900"},"raw":{"description":"GVCLab/PersonaLive — PersonaLive позволяет анимировать портретные изображения для живых трансляций, придавая им выразительность и динамичность. С помощью этого инструмента пользователи могут легко создавать уникальные анимации, которые делают стримы более привлекательными и интерактивными. Он подходит как для стримеров, так и для создателей контента, желающих выделиться на платформах. — edited","link":"https://github.com/GVCLab/PersonaLive"},"raw_record_json":"{\"description\":\"GVCLab/PersonaLive — PersonaLive позволяет анимировать портретные изображения для живых трансляций, придавая им выразительность и динамичность. С помощью этого инструмента пользователи могут легко создавать уникальные анимации, которые делают стримы более привлекательными и интерактивными. Он подходит как для стримеров, так и для создателей контента, желающих выделиться на платформах. — edited\",\"link\":\"https://github.com/GVCLab/PersonaLive\"}","identity":{"raw_url":"https://github.com/GVCLab/PersonaLive","normalized_exact_url":"https://github.com/gvclab/personalive","normalized_address_key":"github.com/gvclab/personalive","url_host":"github.com","owner_repo":"GVCLab/PersonaLive"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1901.md","card_sha256":"1c1d7433c635365e5f832e334248d6d7c8f0cdffd1ba7601bd828e1af06866f3","exact_candidate_group_id":"DUP_6caf0c3d9aaf4f6f","exact_candidate_members":["Рад