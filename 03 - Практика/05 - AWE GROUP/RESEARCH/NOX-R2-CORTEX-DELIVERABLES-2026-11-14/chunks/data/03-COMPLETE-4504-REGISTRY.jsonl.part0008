{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1828","origin":{"collection":"Радар","original_row_number":1828,"raw_json_pointer":"/1827"},"raw":{"description":"plasma-disassembler/plasma — Plasma — это интерактивный дизассемблер для архитектур x86, ARM и MIPS. Он позволяет анализировать машинный код, преобразуя его в читаемый псевдокод с цветной синтаксической подсветкой. Это облегчает процесс изучения и отладки программного обеспечения, помогая разработчикам и исследователям быстро понимать структуру и логику кода.","link":"https://github.com/plasma-disassembler/plasma"},"raw_record_json":"{\"description\":\"plasma-disassembler/plasma — Plasma — это интерактивный дизассемблер для архитектур x86, ARM и MIPS. Он позволяет анализировать машинный код, преобразуя его в читаемый псевдокод с цветной синтаксической подсветкой. Это облегчает процесс изучения и отладки программного обеспечения, помогая разработчикам и исследователям быстро понимать структуру и логику кода.\",\"link\":\"https://github.com/plasma-disassembler/plasma\"}","identity":{"raw_url":"https://github.com/plasma-disassembler/plasma","normalized_exact_url":"https://github.com/plasma-disassembler/plasma","normalized_address_key":"github.com/plasma-disassembler/plasma","url_host":"github.com","owner_repo":"plasma-disassembler/plasma"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1828.md","card_sha256":"203d75e684af4dd913dab73f81f55cdb3942e2740b083bab57846b451d5aa618","exact_candidate_group_id":"DUP_9d16a4bf232918bd","exact_candidate_me