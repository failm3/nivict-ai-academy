{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2141","origin":{"collection":"Радар","original_row_number":2141,"raw_json_pointer":"/2140"},"raw":{"description":"clemcer/LoggiFly — LoggiFly позволяет получать уведомления из логов контейнеров Docker, что помогает быстро реагировать на возникающие проблемы. Система отслеживает важные события и ошибки, отправляя оповещения в удобном формате. Это упрощает мониторинг и управление приложениями, обеспечивая своевременное вмешательство в случае сбоев.","link":"https://github.com/clemcer/LoggiFly"},"raw_record_json":"{\"description\":\"clemcer/LoggiFly — LoggiFly позволяет получать уведомления из логов контейнеров Docker, что помогает быстро реагировать на возникающие проблемы. Система отслеживает важные события и ошибки, отправляя оповещения в удобном формате. Это упрощает мониторинг и управление приложениями, обеспечивая своевременное вмешательство в случае сбоев.\",\"link\":\"https://github.com/clemcer/LoggiFly\"}","identity":{"raw_url":"https://github.com/clemcer/LoggiFly","normalized_exact_url":"https://github.com/clemcer/loggifly","normalized_address_key":"github.com/clemcer/loggifly","url_host":"github.com","owner_repo":"clemcer/LoggiFly"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","execution_automation"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-2141.md","card_sha256":"227a13760e0d94a98999de6ef73337804703a44a148296cbfdc76dd47d02fe0d","exact_candidate_group_id":"DUP_5754fea772b4fec4","exact_candidate_members":["Радар-2141"],"address_candidate_group_id":"DUP_7afc8ee4ab6cf50c","addre