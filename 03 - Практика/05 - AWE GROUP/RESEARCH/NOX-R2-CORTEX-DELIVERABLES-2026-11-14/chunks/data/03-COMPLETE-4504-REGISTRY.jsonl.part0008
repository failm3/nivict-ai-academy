{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2138","origin":{"collection":"Радар","original_row_number":2138,"raw_json_pointer":"/2137"},"raw":{"description":"octelium/octelium — Octelium — это современная платформа с открытым исходным кодом для безопасного доступа без доверия, позволяющая пользователям организовать удалённый доступ, управлять API и интегрировать различные сервисы. Она может служить альтернативой VPN, ZTNA и ngrok, а также поддерживает создание облачной инфраструктуры. — ❤","link":"https://github.com/octelium/octelium"},"raw_record_json":"{\"description\":\"octelium/octelium — Octelium — это современная платформа с открытым исходным кодом для безопасного доступа без доверия, позволяющая пользователям организовать удалённый доступ, управлять API и интегрировать различные сервисы. Она может служить альтернативой VPN, ZTNA и ngrok, а также поддерживает создание облачной инфраструктуры. — ❤\",\"link\":\"https://github.com/octelium/octelium\"}","identity":{"raw_url":"https://github.com/octelium/octelium","normalized_exact_url":"https://github.com/octelium/octelium","normalized_address_key":"github.com/octelium/octelium","url_host":"github.com","owner_repo":"octelium/octelium"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2138.md","card_sha256":"efdd691cb72879c8f9e39889f51a5ec2ea1928e64eb46523fc29d6e25de3cb7c","exact_candidate_group_id":"DUP_ce1ad4f9332839ee","exact_candidate_members":["Радар-2138"],"address_candidate_group_id":"DUP_4d43c71194cf1813","address_candidate_members":["Радар