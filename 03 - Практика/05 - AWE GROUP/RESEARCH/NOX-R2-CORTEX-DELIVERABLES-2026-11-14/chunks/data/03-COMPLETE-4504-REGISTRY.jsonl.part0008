{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2021","origin":{"collection":"Радар","original_row_number":2021,"raw_json_pointer":"/2020"},"raw":{"description":"mbbill/undotree — Undotree — это инструмент для визуализации истории отмены изменений в редакторе Vim. Он позволяет пользователям наглядно отслеживать и управлять изменениями в файлах, упрощая процесс возврата к предыдущим версиям. С помощью графического интерфейса можно легко видеть, какие правки были сделаны и в каком порядке, что значительно облегчает работу с кодом.","link":"https://github.com/mbbill/undotree"},"raw_record_json":"{\"description\":\"mbbill/undotree — Undotree — это инструмент для визуализации истории отмены изменений в редакторе Vim. Он позволяет пользователям наглядно отслеживать и управлять изменениями в файлах, упрощая процесс возврата к предыдущим версиям. С помощью графического интерфейса можно легко видеть, какие правки были сделаны и в каком порядке, что значительно облегчает работу с кодом.\",\"link\":\"https://github.com/mbbill/undotree\"}","identity":{"raw_url":"https://github.com/mbbill/undotree","normalized_exact_url":"https://github.com/mbbill/undotree","normalized_address_key":"github.com/mbbill/undotree","url_host":"github.com","owner_repo":"mbbill/undotree"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-2021.md","card_sha256":"c42e3abae3b23a71eb41941204ef4d16e548decc2e24f2a194aebd1b7949b520","exact_candidate_group_id":"DUP_5c205bc4df879741","exact_candidate_members":["Радар-2021"],"address_candidate_group_id":"DUP