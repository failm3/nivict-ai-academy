{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2031","origin":{"collection":"Радар","original_row_number":2031,"raw_json_pointer":"/2030"},"raw":{"description":"koel/koel — Koel — это удобное решение для стриминга музыки, позволяющее организовать и воспроизводить собственную музыкальную библиотеку. С помощью этого инструмента можно легко загружать треки, создавать плейлисты и делиться ими с другими пользователями. Он поддерживает различные форматы файлов и предоставляет интуитивно понятный интерфейс для управления коллекцией.","link":"https://github.com/koel/koel"},"raw_record_json":"{\"description\":\"koel/koel — Koel — это удобное решение для стриминга музыки, позволяющее организовать и воспроизводить собственную музыкальную библиотеку. С помощью этого инструмента можно легко загружать треки, создавать плейлисты и делиться ими с другими пользователями. Он поддерживает различные форматы файлов и предоставляет интуитивно понятный интерфейс для управления коллекцией.\",\"link\":\"https://github.com/koel/koel\"}","identity":{"raw_url":"https://github.com/koel/koel","normalized_exact_url":"https://github.com/koel/koel","normalized_address_key":"github.com/koel/koel","url_host":"github.com","owner_repo":"koel/koel"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-2031.md","card_sha256":"d8055e73df947ff543b6cf4bd9d1345b726cd434c27ca865f5f10b39c74f9132","exact_candidate_group_id":"DUP_b7dd00428a208dfb","exact_candidate_members":["Радар-2031"],"address_candidate_group_id":"DUP_502bf9ac208625e7","address_candidate_members":["Радар-2