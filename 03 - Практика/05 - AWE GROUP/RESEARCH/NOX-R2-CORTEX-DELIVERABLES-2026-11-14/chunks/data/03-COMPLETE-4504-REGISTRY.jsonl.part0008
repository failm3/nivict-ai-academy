{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2130","origin":{"collection":"Радар","original_row_number":2130,"raw_json_pointer":"/2129"},"raw":{"description":"1Panel-dev/CordysCRM — CordysCRM — это современная система управления взаимоотношениями с клиентами, основанная на искусственном интеллекте и открытом коде. Она предоставляет пользователям гибкие инструменты для автоматизации продаж, управления контактами и анализа данных. Решая задачи по улучшению взаимодействия с клиентами, CordysCRM позволяет оптимизировать бизнес-процессы и повысить эффективность работы команды. — 👍","link":"https://github.com/1Panel-dev/CordysCRM"},"raw_record_json":"{\"description\":\"1Panel-dev/CordysCRM — CordysCRM — это современная система управления взаимоотношениями с клиентами, основанная на искусственном интеллекте и открытом коде. Она предоставляет пользователям гибкие инструменты для автоматизации продаж, управления контактами и анализа данных. Решая задачи по улучшению взаимодействия с клиентами, CordysCRM позволяет оптимизировать бизнес-процессы и повысить эффективность работы команды. — 👍\",\"link\":\"https://github.com/1Panel-dev/CordysCRM\"}","identity":{"raw_url":"https://github.com/1Panel-dev/CordysCRM","normalized_exact_url":"https://github.com/1panel-dev/cordyscrm","normalized_address_key":"github.com/1panel-dev/cordyscrm","url_host":"github.com","owner_repo":"1Panel-dev/CordysCRM"},"classification":{"semantic_class":"workflow","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable","execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Бизнес - Маркетинг и продажи","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Бизнес---Маркетинг-и-продажи/Радар-2130.md","card_sha256":"24326745e79d4d93e6cfa74d58