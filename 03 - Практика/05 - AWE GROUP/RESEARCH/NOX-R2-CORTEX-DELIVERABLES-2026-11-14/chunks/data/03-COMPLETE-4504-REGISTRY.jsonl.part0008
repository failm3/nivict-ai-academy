{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2106","origin":{"collection":"Радар","original_row_number":2106,"raw_json_pointer":"/2105"},"raw":{"description":"unhappychoice/gitlogue — Gitlogue превращает историю ваших коммитов в увлекательное и наглядное представление. Этот инструмент для терминала позволяет визуализировать изменения в проекте, делая процесс анализа истории Git более понятным и интерактивным. Пользователи могут легко отслеживать эволюцию кода, что помогает в обучении и понимании командной работы.","link":"https://github.com/unhappychoice/gitlogue"},"raw_record_json":"{\"description\":\"unhappychoice/gitlogue — Gitlogue превращает историю ваших коммитов в увлекательное и наглядное представление. Этот инструмент для терминала позволяет визуализировать изменения в проекте, делая процесс анализа истории Git более понятным и интерактивным. Пользователи могут легко отслеживать эволюцию кода, что помогает в обучении и понимании командной работы.\",\"link\":\"https://github.com/unhappychoice/gitlogue\"}","identity":{"raw_url":"https://github.com/unhappychoice/gitlogue","normalized_exact_url":"https://github.com/unhappychoice/gitlogue","normalized_address_key":"github.com/unhappychoice/gitlogue","url_host":"github.com","owner_repo":"unhappychoice/gitlogue"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-2106.md","card_sha256":"cdf9e8aa695580f09850f04b4f569c3bce6f54469ea75f96a0212f2e87210451","exact_candidate_group_id":"DUP_f509473a33d0dc01","exact_candidate_members":["Радар-2106"],"address_candidate_group_id":