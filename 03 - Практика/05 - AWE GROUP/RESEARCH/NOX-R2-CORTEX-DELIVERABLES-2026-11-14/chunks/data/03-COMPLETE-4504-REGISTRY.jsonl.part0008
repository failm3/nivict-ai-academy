{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2199","origin":{"collection":"Радар","original_row_number":2199,"raw_json_pointer":"/2198"},"raw":{"description":"gamosoft/NoteDiscovery — NoteDiscovery — это удобное решение для создания и управления личной базой знаний. Пользователи могут эффективно организовывать свои заметки, идеи и информацию, сохраняя всё в одном месте. Интуитивно понятный интерфейс позволяет быстро находить нужные данные и структурировать их по категориям.","link":"https://github.com/gamosoft/NoteDiscovery"},"raw_record_json":"{\"description\":\"gamosoft/NoteDiscovery — NoteDiscovery — это удобное решение для создания и управления личной базой знаний. Пользователи могут эффективно организовывать свои заметки, идеи и информацию, сохраняя всё в одном месте. Интуитивно понятный интерфейс позволяет быстро находить нужные данные и структурировать их по категориям.\",\"link\":\"https://github.com/gamosoft/NoteDiscovery\"}","identity":{"raw_url":"https://github.com/gamosoft/NoteDiscovery","normalized_exact_url":"https://github.com/gamosoft/notediscovery","normalized_address_key":"github.com/gamosoft/notediscovery","url_host":"github.com","owner_repo":"gamosoft/NoteDiscovery"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-2199.md","card_sha256":"c5a69d073b3804dc17f1deab5f8dbb173dc3605cd5eca341cd9bd3279641559f","exact_candidate_group_id":"DUP_7391a6af822c8a0e","exact_candidate_members":["Радар-2199"],"address_candidate_group_id":"DUP_45978c6773d72896","address_candidate_members":["Радар-2199"]