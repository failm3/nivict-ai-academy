{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1850","origin":{"collection":"Радар","original_row_number":1850,"raw_json_pointer":"/1849"},"raw":{"description":"QwenLM/Qwen-Image-Layered — Qwen-Image-Layered предлагает эффективный подход к разложению изображений на слои, что позволяет легко редактировать и изменять отдельные элементы. Это решение полезно для дизайнеров и художников, которые хотят быстро вносить изменения в визуальные проекты без необходимости работы с целыми изображениями. — 👎","link":"https://github.com/QwenLM/Qwen-Image-Layered"},"raw_record_json":"{\"description\":\"QwenLM/Qwen-Image-Layered — Qwen-Image-Layered предлагает эффективный подход к разложению изображений на слои, что позволяет легко редактировать и изменять отдельные элементы. Это решение полезно для дизайнеров и художников, которые хотят быстро вносить изменения в визуальные проекты без необходимости работы с целыми изображениями. — 👎\",\"link\":\"https://github.com/QwenLM/Qwen-Image-Layered\"}","identity":{"raw_url":"https://github.com/QwenLM/Qwen-Image-Layered","normalized_exact_url":"https://github.com/qwenlm/qwen-image-layered","normalized_address_key":"github.com/qwenlm/qwen-image-layered","url_host":"github.com","owner_repo":"QwenLM/Qwen-Image-Layered"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-1850.md","card_sha256":"0b179f3e008f5dd6d58dbb453e25dd2bfc8ae7d55712ee53273e587baa445c31","exact_candidate_group_id":"DUP_85c2e065068b7836","exact_candidate_members":["Радар-1850"],"address_candidate_group_id":"DUP_75a680a02cf9ff00","ad