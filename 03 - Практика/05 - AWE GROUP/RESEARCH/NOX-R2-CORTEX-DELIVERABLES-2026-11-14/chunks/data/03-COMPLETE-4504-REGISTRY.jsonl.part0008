{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2061","origin":{"collection":"Радар","original_row_number":2061,"raw_json_pointer":"/2060"},"raw":{"description":"domcyrus/rustnet — Rustnet — это кроссплатформенный инструмент для мониторинга сетей с удобным терминальным интерфейсом. Он позволяет пользователям отслеживать состояние сетевых соединений, выявлять проблемы и анализировать производительность в реальном времени. Благодаря своей простоте и эффективности, Rustnet идеально подходит для системных администраторов и разработчиков, стремящихся улучшить управление сетями.","link":"https://github.com/domcyrus/rustnet"},"raw_record_json":"{\"description\":\"domcyrus/rustnet — Rustnet — это кроссплатформенный инструмент для мониторинга сетей с удобным терминальным интерфейсом. Он позволяет пользователям отслеживать состояние сетевых соединений, выявлять проблемы и анализировать производительность в реальном времени. Благодаря своей простоте и эффективности, Rustnet идеально подходит для системных администраторов и разработчиков, стремящихся улучшить управление сетями.\",\"link\":\"https://github.com/domcyrus/rustnet\"}","identity":{"raw_url":"https://github.com/domcyrus/rustnet","normalized_exact_url":"https://github.com/domcyrus/rustnet","normalized_address_key":"github.com/domcyrus/rustnet","url_host":"github.com","owner_repo":"domcyrus/rustnet"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-2061.md","card_sha256":"8b4f91ec3f8e6bbba55c75f4ec2bfaf4c9b7a30d00841f99614daa45667468cd","exact_candidate_group_id":"DUP_354ee