{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2115","origin":{"collection":"Радар","original_row_number":2115,"raw_json_pointer":"/2114"},"raw":{"description":"HKUDS/VideoRAG — VideoRAG позволяет взаимодействовать с видеофайлами через чат. Пользователи могут задавать вопросы и получать ответы на основе содержимого видео, что упрощает поиск нужной информации и делает процесс обучения более эффективным. Эта система помогает извлекать ключевые моменты и детали, не просматривая весь материал.","link":"https://github.com/HKUDS/VideoRAG"},"raw_record_json":"{\"description\":\"HKUDS/VideoRAG — VideoRAG позволяет взаимодействовать с видеофайлами через чат. Пользователи могут задавать вопросы и получать ответы на основе содержимого видео, что упрощает поиск нужной информации и делает процесс обучения более эффективным. Эта система помогает извлекать ключевые моменты и детали, не просматривая весь материал.\",\"link\":\"https://github.com/HKUDS/VideoRAG\"}","identity":{"raw_url":"https://github.com/HKUDS/VideoRAG","normalized_exact_url":"https://github.com/hkuds/videorag","normalized_address_key":"github.com/hkuds/videorag","url_host":"github.com","owner_repo":"HKUDS/VideoRAG"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable","retrieval_memory","skills_competence"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-2115.md","card_sha256":"8460d7ad136df2f30f5b598794428e94ed68004c892603214e528add21431084","exact_candidate_group_id":"DUP_b0a07b46f22504d0","exact_candidate_members":["Радар-2115"],"address_candidate_group_id":"DUP_f8c834152d252c08","address_candidate_members":["Радар-2115"]},"s