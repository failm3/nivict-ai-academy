{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2088","origin":{"collection":"Радар","original_row_number":2088,"raw_json_pointer":"/2087"},"raw":{"description":"ravitemer/mcphub.nvim — mcphub.nvim позволяет эффективно интегрировать MCP-серверы в рабочий процесс редактирования в Neovim. С помощью интуитивно понятного интерфейса пользователи могут легко управлять, тестировать и использовать MCP-серверы совместно с любимыми плагинами для чата. Это решение упрощает взаимодействие с MCP-серверами, делая их доступными и удобными в использовании.","link":"https://github.com/ravitemer/mcphub.nvim"},"raw_record_json":"{\"description\":\"ravitemer/mcphub.nvim — mcphub.nvim позволяет эффективно интегрировать MCP-серверы в рабочий процесс редактирования в Neovim. С помощью интуитивно понятного интерфейса пользователи могут легко управлять, тестировать и использовать MCP-серверы совместно с любимыми плагинами для чата. Это решение упрощает взаимодействие с MCP-серверами, делая их доступными и удобными в использовании.\",\"link\":\"https://github.com/ravitemer/mcphub.nvim\"}","identity":{"raw_url":"https://github.com/ravitemer/mcphub.nvim","normalized_exact_url":"https://github.com/ravitemer/mcphub.nvim","normalized_address_key":"github.com/ravitemer/mcphub.nvim","url_host":"github.com","owner_repo":"ravitemer/mcphub.nvim"},"classification":{"semantic_class":"MCP","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["tool_discovery","execution_automation","quality_evaluation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-2088.md","card_sha256":"cf27ccc08fa3a63459e7f5a70c5c83cbb66a670da9b506d409b492a8a3c5112c","exact_candidate_group_id":"DUP_581b1d6bb65c1