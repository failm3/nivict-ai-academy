{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1844","origin":{"collection":"Радар","original_row_number":1844,"raw_json_pointer":"/1843"},"raw":{"description":"kovidgoyal/calibre — Calibre — это мощный менеджер электронных книг, который помогает пользователям организовывать, конвертировать и читать электронные книги. Он поддерживает множество форматов и предоставляет инструменты для редактирования метаданных, создания библиотек и синхронизации с ридерами. Удобный интерфейс и широкий функционал делают его идеальным решением для любителей литературы.","link":"https://github.com/kovidgoyal/calibre"},"raw_record_json":"{\"description\":\"kovidgoyal/calibre — Calibre — это мощный менеджер электронных книг, который помогает пользователям организовывать, конвертировать и читать электронные книги. Он поддерживает множество форматов и предоставляет инструменты для редактирования метаданных, создания библиотек и синхронизации с ридерами. Удобный интерфейс и широкий функционал делают его идеальным решением для любителей литературы.\",\"link\":\"https://github.com/kovidgoyal/calibre\"}","identity":{"raw_url":"https://github.com/kovidgoyal/calibre","normalized_exact_url":"https://github.com/kovidgoyal/calibre","normalized_address_key":"github.com/kovidgoyal/calibre","url_host":"github.com","owner_repo":"kovidgoyal/calibre"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-1844.md","card_sha256":"2e27e56d20f09e5bb3235daee1f15b476d525be1a5005ed92753ad45e804c9ef","exact_candidate_group_id":"DUP_c2a7bf07ce42c2