{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2062","origin":{"collection":"Радар","original_row_number":2062,"raw_json_pointer":"/2061"},"raw":{"description":"invoiceninja/invoiceninja — Invoiceninja — это удобное приложение для управления счетами, предложениями, проектами и отслеживания времени. Оно помогает малым и средним предприятиям автоматизировать финансовые процессы, упрощая создание и отправку счетов, управление проектами и учет рабочего времени. Пользователи могут легко отслеживать свои доходы и расходы, а также генерировать отчеты для анализа.","link":"https://github.com/invoiceninja/invoiceninja"},"raw_record_json":"{\"description\":\"invoiceninja/invoiceninja — Invoiceninja — это удобное приложение для управления счетами, предложениями, проектами и отслеживания времени. Оно помогает малым и средним предприятиям автоматизировать финансовые процессы, упрощая создание и отправку счетов, управление проектами и учет рабочего времени. Пользователи могут легко отслеживать свои доходы и расходы, а также генерировать отчеты для анализа.\",\"link\":\"https://github.com/invoiceninja/invoiceninja\"}","identity":{"raw_url":"https://github.com/invoiceninja/invoiceninja","normalized_exact_url":"https://github.com/invoiceninja/invoiceninja","normalized_address_key":"github.com/invoiceninja/invoiceninja","url_host":"github.com","owner_repo":"invoiceninja/invoiceninja"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2062.md","card_sha256":"17f9fcc29f7a5e9fcb88f2595b35617cb873329e05b612fec35f94489c