{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1793","origin":{"collection":"Радар","original_row_number":1793,"raw_json_pointer":"/1792"},"raw":{"description":"likaia/nginxpulse — nginxpulse — это легковесный инструмент для анализа и визуализации логов доступа Nginx. Он обеспечивает мгновенную статистику, фильтрацию по просмотрам, определение геолокации IP-адресов и распознавание клиентов. Пользователи могут быстро получать важные данные о трафике и поведении посетителей, что помогает оптимизировать работу веб-сайтов и улучшать пользовательский опыт.","link":"https://github.com/likaia/nginxpulse"},"raw_record_json":"{\"description\":\"likaia/nginxpulse — nginxpulse — это легковесный инструмент для анализа и визуализации логов доступа Nginx. Он обеспечивает мгновенную статистику, фильтрацию по просмотрам, определение геолокации IP-адресов и распознавание клиентов. Пользователи могут быстро получать важные данные о трафике и поведении посетителей, что помогает оптимизировать работу веб-сайтов и улучшать пользовательский опыт.\",\"link\":\"https://github.com/likaia/nginxpulse\"}","identity":{"raw_url":"https://github.com/likaia/nginxpulse","normalized_exact_url":"https://github.com/likaia/nginxpulse","normalized_address_key":"github.com/likaia/nginxpulse","url_host":"github.com","owner_repo":"likaia/nginxpulse"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-1793.md","card_sha256":"2ac819a32d8f6fe6f775ad43cd95c77d4cde5fe77750ff55a73d6d7baa8b6b3c","exact_candidate_group_id":"DUP_6fa10