{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1851","origin":{"collection":"Радар","original_row_number":1851,"raw_json_pointer":"/1850"},"raw":{"description":"Diorser/LiteMonitor — LiteMonitor — это легкий и настраиваемый инструмент для мониторинга аппаратных ресурсов на Windows. Он позволяет отслеживать производительность процессора, видеокарты, оперативной памяти и сетевого соединения, а также включает счетчик FPS. Пользователи могут расширять функциональность с помощью плагинов и оптимизировать использование памяти. — 👎","link":"https://github.com/Diorser/LiteMonitor"},"raw_record_json":"{\"description\":\"Diorser/LiteMonitor — LiteMonitor — это легкий и настраиваемый инструмент для мониторинга аппаратных ресурсов на Windows. Он позволяет отслеживать производительность процессора, видеокарты, оперативной памяти и сетевого соединения, а также включает счетчик FPS. Пользователи могут расширять функциональность с помощью плагинов и оптимизировать использование памяти. — 👎\",\"link\":\"https://github.com/Diorser/LiteMonitor\"}","identity":{"raw_url":"https://github.com/Diorser/LiteMonitor","normalized_exact_url":"https://github.com/diorser/litemonitor","normalized_address_key":"github.com/diorser/litemonitor","url_host":"github.com","owner_repo":"Diorser/LiteMonitor"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","retrieval_memory"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-1851.md","card_sha256":"53d5957a4917748b9d09af9e823ce121043aeb95bc66b5e49f1440cd25c3c991","exact_candidate_group_id":"DUP_0c11e7da38ebd313","exact_candidate_members"