{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2137","origin":{"collection":"Радар","original_row_number":2137,"raw_json_pointer":"/2136"},"raw":{"description":"KeygraphHQ/shannon — Shannon — это автономный ИИ-хакер, который находит уязвимости в веб-приложениях. С помощью передовых алгоритмов он анализирует код и выявляет реальные эксплойты, что позволяет значительно повысить безопасность ваших приложений. Достигнутая им эффективность составляет 96,15% на тестах без подсказок, что подтверждает его надежность. — ⚡","link":"https://github.com/KeygraphHQ/shannon"},"raw_record_json":"{\"description\":\"KeygraphHQ/shannon — Shannon — это автономный ИИ-хакер, который находит уязвимости в веб-приложениях. С помощью передовых алгоритмов он анализирует код и выявляет реальные эксплойты, что позволяет значительно повысить безопасность ваших приложений. Достигнутая им эффективность составляет 96,15% на тестах без подсказок, что подтверждает его надежность. — ⚡\",\"link\":\"https://github.com/KeygraphHQ/shannon\"}","identity":{"raw_url":"https://github.com/KeygraphHQ/shannon","normalized_exact_url":"https://github.com/keygraphhq/shannon","normalized_address_key":"github.com/keygraphhq/shannon","url_host":"github.com","owner_repo":"KeygraphHQ/shannon"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance","quality_evaluation"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2137.md","card_sha256":"4cf135433c9be3942bd1985e2c15b908bb8df245702504ec5de149c86fb69eda","exact_candidate_group_id":"DUP_c3f66097a0f86dc4","exact_candidate_members":["Радар-2137"],"address_candidate_group_id":"DUP_5d7815