{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1977","origin":{"collection":"Радар","original_row_number":1977,"raw_json_pointer":"/1976"},"raw":{"description":"CodeWithCJ/SparkyFitness — SparkyFitness помогает семьям следить за питанием, физической активностью, потреблением воды и общим состоянием здоровья. Удобный интерфейс позволяет отслеживать прогресс каждого члена семьи, что способствует совместному достижению целей. Приложение использует искусственный интеллект для анализа данных и предоставления рекомендаций. — 👍","link":"https://github.com/CodeWithCJ/SparkyFitness"},"raw_record_json":"{\"description\":\"CodeWithCJ/SparkyFitness — SparkyFitness помогает семьям следить за питанием, физической активностью, потреблением воды и общим состоянием здоровья. Удобный интерфейс позволяет отслеживать прогресс каждого члена семьи, что способствует совместному достижению целей. Приложение использует искусственный интеллект для анализа данных и предоставления рекомендаций. — 👍\",\"link\":\"https://github.com/CodeWithCJ/SparkyFitness\"}","identity":{"raw_url":"https://github.com/CodeWithCJ/SparkyFitness","normalized_exact_url":"https://github.com/codewithcj/sparkyfitness","normalized_address_key":"github.com/codewithcj/sparkyfitness","url_host":"github.com","owner_repo":"CodeWithCJ/SparkyFitness"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-1977.md","card_sha256":"bac0af73e9412a5e8de3c48ad4f27cacb67525f24c28a5598240076a0d53b824","exact_candidate_group_id":"DUP_bee4bea5ad39e5e2","exact_candidate_members":[