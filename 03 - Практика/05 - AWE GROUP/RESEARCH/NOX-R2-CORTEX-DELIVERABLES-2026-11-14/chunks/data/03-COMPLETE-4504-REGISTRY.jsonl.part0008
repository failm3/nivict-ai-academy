{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2023","origin":{"collection":"Радар","original_row_number":2023,"raw_json_pointer":"/2022"},"raw":{"description":"timescale/pg-aiguide — pg-aiguide предоставляет сервер MCP и плагин Claude для работы с PostgreSQL, что упрощает создание и оптимизацию SQL-кода. Этот инструмент помогает разработчикам и специалистам по данным улучшить качество генерируемого кода с использованием возможностей искусственного интеллекта. Он включает в себя документацию и примеры, что делает процесс работы с PostgreSQL более эффективным.","link":"https://github.com/timescale/pg-aiguide"},"raw_record_json":"{\"description\":\"timescale/pg-aiguide — pg-aiguide предоставляет сервер MCP и плагин Claude для работы с PostgreSQL, что упрощает создание и оптимизацию SQL-кода. Этот инструмент помогает разработчикам и специалистам по данным улучшить качество генерируемого кода с использованием возможностей искусственного интеллекта. Он включает в себя документацию и примеры, что делает процесс работы с PostgreSQL более эффективным.\",\"link\":\"https://github.com/timescale/pg-aiguide\"}","identity":{"raw_url":"https://github.com/timescale/pg-aiguide","normalized_exact_url":"https://github.com/timescale/pg-aiguide","normalized_address_key":"github.com/timescale/pg-aiguide","url_host":"github.com","owner_repo":"timescale/pg-aiguide"},"classification":{"semantic_class":"MCP","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["tool_discovery","execution_automation","knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-2023.md","card_sha256":"66