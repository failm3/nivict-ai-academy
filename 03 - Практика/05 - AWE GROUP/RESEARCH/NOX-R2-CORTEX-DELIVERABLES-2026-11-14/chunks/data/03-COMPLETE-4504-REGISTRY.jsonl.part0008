{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2089","origin":{"collection":"Радар","original_row_number":2089,"raw_json_pointer":"/2088"},"raw":{"description":"ericc-ch/copilot-api — Copilot-api преобразует GitHub Copilot в совместимый с API OpenAI и Anthropic сервер, что позволяет интегрировать возможности генерации кода в различные приложения. Это решение подходит для разработчиков, которым необходимо использовать мощные инструменты AI для автоматизации написания кода и улучшения рабочих процессов.","link":"https://github.com/ericc-ch/copilot-api"},"raw_record_json":"{\"description\":\"ericc-ch/copilot-api — Copilot-api преобразует GitHub Copilot в совместимый с API OpenAI и Anthropic сервер, что позволяет интегрировать возможности генерации кода в различные приложения. Это решение подходит для разработчиков, которым необходимо использовать мощные инструменты AI для автоматизации написания кода и улучшения рабочих процессов.\",\"link\":\"https://github.com/ericc-ch/copilot-api\"}","identity":{"raw_url":"https://github.com/ericc-ch/copilot-api","normalized_exact_url":"https://github.com/ericc-ch/copilot-api","normalized_address_key":"github.com/ericc-ch/copilot-api","url_host":"github.com","owner_repo":"ericc-ch/copilot-api"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-2089.md","card_sha256":"cf5e06ab7aba9b27d7e8b37d29e52ee55105b069252a61bba6803fedaa546ec6","exact_candidate_group_id":"DUP_6b99fd76bba9377f","exact_candidate_members":["Радар-2089"],"address_candidate