{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1994","origin":{"collection":"Радар","original_row_number":1994,"raw_json_pointer":"/1993"},"raw":{"description":"digimezzo/dopamine — Dopamine — это аудиоплеер, который предлагает простой и интуитивно понятный интерфейс для воспроизведения музыки. Он позволяет организовывать музыкальные коллекции, управлять плейлистами и наслаждаться любимыми треками без лишних сложностей. Пользователи могут легко находить и воспроизводить аудиофайлы, не отвлекаясь на ненужные функции.","link":"https://github.com/digimezzo/dopamine"},"raw_record_json":"{\"description\":\"digimezzo/dopamine — Dopamine — это аудиоплеер, который предлагает простой и интуитивно понятный интерфейс для воспроизведения музыки. Он позволяет организовывать музыкальные коллекции, управлять плейлистами и наслаждаться любимыми треками без лишних сложностей. Пользователи могут легко находить и воспроизводить аудиофайлы, не отвлекаясь на ненужные функции.\",\"link\":\"https://github.com/digimezzo/dopamine\"}","identity":{"raw_url":"https://github.com/digimezzo/dopamine","normalized_exact_url":"https://github.com/digimezzo/dopamine","normalized_address_key":"github.com/digimezzo/dopamine","url_host":"github.com","owner_repo":"digimezzo/dopamine"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-1994.md","card_sha256":"c456dbffb6667bddb61b8c1850066530df1ca9e6787d90a781af0400b2e96299","exact_candidate_group_id":"DUP_fa787056712e5b1e","exact_candidate_members":["Радар-1994"],"address_candidate_group_id":"DUP_dd48703d88b2012b","address_candi