{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1807","origin":{"collection":"Радар","original_row_number":1807,"raw_json_pointer":"/1806"},"raw":{"description":"wdanilo/crabtime — Crabtime — это инструмент для управления временем и задачами, который помогает пользователям эффективно планировать свой день. Он позволяет отслеживать затраченное время на различные дела, анализировать продуктивность и выявлять слабые места в распорядке. Удобный интерфейс и простота в использовании делают его подходящим как для индивидуальных пользователей, так и для команд.","link":"https://github.com/wdanilo/crabtime"},"raw_record_json":"{\"description\":\"wdanilo/crabtime — Crabtime — это инструмент для управления временем и задачами, который помогает пользователям эффективно планировать свой день. Он позволяет отслеживать затраченное время на различные дела, анализировать продуктивность и выявлять слабые места в распорядке. Удобный интерфейс и простота в использовании делают его подходящим как для индивидуальных пользователей, так и для команд.\",\"link\":\"https://github.com/wdanilo/crabtime\"}","identity":{"raw_url":"https://github.com/wdanilo/crabtime","normalized_exact_url":"https://github.com/wdanilo/crabtime","normalized_address_key":"github.com/wdanilo/crabtime","url_host":"github.com","owner_repo":"wdanilo/crabtime"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-1807.md","card_sha256":"82f02b7eddbc5f7a415906a9e1726c9361300f8e9281839df8a7c56d733a2e48","exact_candidate_group_id":"DUP_d6f814545cf1d473","exact_candidate_mem