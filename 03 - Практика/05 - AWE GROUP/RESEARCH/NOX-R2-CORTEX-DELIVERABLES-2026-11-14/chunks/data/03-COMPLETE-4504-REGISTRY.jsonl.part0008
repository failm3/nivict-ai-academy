{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2040","origin":{"collection":"Радар","original_row_number":2040,"raw_json_pointer":"/2039"},"raw":{"description":"AmoyLab/Unla — Unla — это легковесный шлюз, который позволяет без изменений в коде преобразовать существующие серверы и API в MCP-серверы. Он предлагает простоту развертывания через Docker и интуитивно понятный интерфейс управления, что исключает необходимость в модификациях инфраструктуры.","link":"https://github.com/AmoyLab/Unla"},"raw_record_json":"{\"description\":\"AmoyLab/Unla — Unla — это легковесный шлюз, который позволяет без изменений в коде преобразовать существующие серверы и API в MCP-серверы. Он предлагает простоту развертывания через Docker и интуитивно понятный интерфейс управления, что исключает необходимость в модификациях инфраструктуры.\",\"link\":\"https://github.com/AmoyLab/Unla\"}","identity":{"raw_url":"https://github.com/AmoyLab/Unla","normalized_exact_url":"https://github.com/amoylab/unla","normalized_address_key":"github.com/amoylab/unla","url_host":"github.com","owner_repo":"AmoyLab/Unla"},"classification":{"semantic_class":"MCP","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["tool_discovery","execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-2040.md","card_sha256":"2bc957b9bed3cba92585ae92b1b5a3c045fe031311fd7d8a4d473575b2af16e4","exact_candidate_group_id":"DUP_a05e003f4fab01bb","exact_candidate_members":["Радар-2040"],"address_candidate_group_id":"DUP_f3eed0131f7915ff","address_candidate_members":["Радар-2040"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTED","verdict":"H","research_status":"DOCUMENTED_L1_CROSSW