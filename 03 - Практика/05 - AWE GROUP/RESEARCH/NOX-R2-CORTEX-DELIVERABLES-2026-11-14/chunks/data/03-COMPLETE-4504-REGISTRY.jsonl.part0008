{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-1981","origin":{"collection":"Радар","original_row_number":1981,"raw_json_pointer":"/1980"},"raw":{"description":"vim/vim — Vim — это мощный текстовый редактор, который обеспечивает высокую скорость редактирования и гибкость работы с текстом. Он подходит как для программирования, так и для написания документации, благодаря поддержке множества языков и расширяемости через плагины. Интуитивно понятные команды и режимы работы позволяют пользователям эффективно управлять текстом. — ⚡","link":"https://github.com/vim/vim"},"raw_record_json":"{\"description\":\"vim/vim — Vim — это мощный текстовый редактор, который обеспечивает высокую скорость редактирования и гибкость работы с текстом. Он подходит как для программирования, так и для написания документации, благодаря поддержке множества языков и расширяемости через плагины. Интуитивно понятные команды и режимы работы позволяют пользователям эффективно управлять текстом. — ⚡\",\"link\":\"https://github.com/vim/vim\"}","identity":{"raw_url":"https://github.com/vim/vim","normalized_exact_url":"https://github.com/vim/vim","normalized_address_key":"github.com/vim/vim","url_host":"github.com","owner_repo":"vim/vim"},"classification":{"semantic_class":"documentation","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-1981.md","card_sha256":"0d6009f74c3b636b91356ea97932b7477a2cf7090c9e5d3194facf89b9a21810","exact_candidate_group_id":"DUP_c10c5672472dc3dd","exact_candidate_members":["Радар-1981"],"address_candidate_group_id":"DUP_6f0c5e83