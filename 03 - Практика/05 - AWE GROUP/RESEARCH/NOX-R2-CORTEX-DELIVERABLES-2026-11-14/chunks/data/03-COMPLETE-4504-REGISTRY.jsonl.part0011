{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3158","origin":{"collection":"Радар","original_row_number":3158,"raw_json_pointer":"/3157"},"raw":{"description":"code-yeongyu/oh-my-openagentИнструмент представляет собой агента для работы с кодом, который можно развернуть локально. Он принимает текстовое описание задачи и самостоятельно выполняет её: пишет код, создаёт бэкенд и фронтенд, проводит исследование по множеству источников. Поддерживается управление сессиями — можно продолжить прерванную работу. Уровень «глубины размышлений» модели настраивается прямо во время сеанса.","link":"https://github.com/code-yeongyu/oh-my-openagent"},"raw_record_json":"{\"description\":\"code-yeongyu/oh-my-openagentИнструмент представляет собой агента для работы с кодом, который можно развернуть локально. Он принимает текстовое описание задачи и самостоятельно выполняет её: пишет код, создаёт бэкенд и фронтенд, проводит исследование по множеству источников. Поддерживается управление сессиями — можно продолжить прерванную работу. Уровень «глубины размышлений» модели настраивается прямо во время сеанса.\",\"link\":\"https://github.com/code-yeongyu/oh-my-openagent\"}","identity":{"raw_url":"https://github.com/code-yeongyu/oh-my-openagent","normalized_exact_url":"https://github.com/code-yeongyu/oh-my-openagent","normalized_address_key":"github.com/code-yeongyu/oh-my-openagent","url_host":"github.com","owner_repo":"code-yeongyu/oh-my-openagent"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["C_EXECUTION_STRATEGY","A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-3158.m