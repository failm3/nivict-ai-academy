{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3173","origin":{"collection":"Радар","original_row_number":3173,"raw_json_pointer":"/3172"},"raw":{"description":"midday-ai/middayИнструмент для фрилансеров и независимых специалистов, который объединяет учёт рабочего времени, выставление счетов и управление финансами в одном месте. Входящие счета и чеки автоматически сопоставляются с транзакциями. Важные файлы хранятся в защищённом хранилище. Встроенный ассистент анализирует расходы и помогает находить нужные документы. Можно развернуть локально.","link":"https://github.com/midday-ai/midday"},"raw_record_json":"{\"description\":\"midday-ai/middayИнструмент для фрилансеров и независимых специалистов, который объединяет учёт рабочего времени, выставление счетов и управление финансами в одном месте. Входящие счета и чеки автоматически сопоставляются с транзакциями. Важные файлы хранятся в защищённом хранилище. Встроенный ассистент анализирует расходы и помогает находить нужные документы. Можно развернуть локально.\",\"link\":\"https://github.com/midday-ai/midday\"}","identity":{"raw_url":"https://github.com/midday-ai/midday","normalized_exact_url":"https://github.com/midday-ai/midday","normalized_address_key":"github.com/midday-ai/midday","url_host":"github.com","owner_repo":"midday-ai/midday"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-3173.md","card_sha256":"a72fede750ba1d35c75e0ec833b1037b03734db75876abc36a027eda8a3d09cf","exact_candidate_group