{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3152","origin":{"collection":"Радар","original_row_number":3152,"raw_json_pointer":"/3151"},"raw":{"description":"agno-agi/agnoИнструмент позволяет создавать программных агентов, которые выполняют задачи автономно и объединяются в команды. Агенты работают как постоянные сервисы со встроенным API и поддерживают управление памятью, планирование задач и согласование действий с человеком. Платформа разворачивается в собственном облаке. Есть интерфейс для просмотра диалогов и управления активностью агентов.","link":"https://github.com/agno-agi/agno"},"raw_record_json":"{\"description\":\"agno-agi/agnoИнструмент позволяет создавать программных агентов, которые выполняют задачи автономно и объединяются в команды. Агенты работают как постоянные сервисы со встроенным API и поддерживают управление памятью, планирование задач и согласование действий с человеком. Платформа разворачивается в собственном облаке. Есть интерфейс для просмотра диалогов и управления активностью агентов.\",\"link\":\"https://github.com/agno-agi/agno\"}","identity":{"raw_url":"https://github.com/agno-agi/agno","normalized_exact_url":"https://github.com/agno-agi/agno","normalized_address_key":"github.com/agno-agi/agno","url_host":"github.com","owner_repo":"agno-agi/agno"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","retrieval_memory","tool_discovery"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-3152.md","card_sha256":"a5d37903cb7e2d60ce0f09984af2c915622502529097b60973c9ff17f45f4547","exact_candidate_group_id":"DUP_4107c3b81128b653","exa