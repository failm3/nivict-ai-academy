{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3153","origin":{"collection":"Радар","original_row_number":3153,"raw_json_pointer":"/3152"},"raw":{"description":"palmier-io/palmier-proВидеоредактор для macOS, созданный специально для работы с искусственным интеллектом на компьютерах Apple Silicon. Позволяет генерировать видео и изображения прямо на монтажной шкале с помощью современных ИИ-моделей. Поддерживает подключение внешних ИИ-агентов — Claude, Codex, Cursor — чтобы они могли редактировать проект напрямую.","link":"https://github.com/palmier-io/palmier-pro"},"raw_record_json":"{\"description\":\"palmier-io/palmier-proВидеоредактор для macOS, созданный специально для работы с искусственным интеллектом на компьютерах Apple Silicon. Позволяет генерировать видео и изображения прямо на монтажной шкале с помощью современных ИИ-моделей. Поддерживает подключение внешних ИИ-агентов — Claude, Codex, Cursor — чтобы они могли редактировать проект напрямую.\",\"link\":\"https://github.com/palmier-io/palmier-pro\"}","identity":{"raw_url":"https://github.com/palmier-io/palmier-pro","normalized_exact_url":"https://github.com/palmier-io/palmier-pro","normalized_address_key":"github.com/palmier-io/palmier-pro","url_host":"github.com","owner_repo":"palmier-io/palmier-pro"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-3153.md","card_sha256":"c2417b667fc703400fca821d10154719597451b85fe91bde2960d93aaf3abaf9","exact_candidate_group_id":"DUP_f435cc8665ad2af2","exact_candidate_members":["Радар-3153"],"address_candidate_g