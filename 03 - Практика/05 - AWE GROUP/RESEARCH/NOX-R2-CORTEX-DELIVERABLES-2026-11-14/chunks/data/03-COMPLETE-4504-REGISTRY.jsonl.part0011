{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3163","origin":{"collection":"Радар","original_row_number":3163,"raw_json_pointer":"/3162"},"raw":{"description":"bytebase/bytebaseИнструмент помогает командам управлять изменениями в базах данных и контролировать доступ к ним. Все запросы на изменение проходят согласование и проверку по более чем 200 правилам. Доступ к данным можно ограничивать вплоть до отдельных столбцов, а чувствительные данные — скрывать в зависимости от роли пользователя. Все действия с базами данных фиксируются в журнале аудита.","link":"https://github.com/bytebase/bytebase"},"raw_record_json":"{\"description\":\"bytebase/bytebaseИнструмент помогает командам управлять изменениями в базах данных и контролировать доступ к ним. Все запросы на изменение проходят согласование и проверку по более чем 200 правилам. Доступ к данным можно ограничивать вплоть до отдельных столбцов, а чувствительные данные — скрывать в зависимости от роли пользователя. Все действия с базами данных фиксируются в журнале аудита.\",\"link\":\"https://github.com/bytebase/bytebase\"}","identity":{"raw_url":"https://github.com/bytebase/bytebase","normalized_exact_url":"https://github.com/bytebase/bytebase","normalized_address_key":"github.com/bytebase/bytebase","url_host":"github.com","owner_repo":"bytebase/bytebase"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-3163.md","card_sha256":"83aed5effc9ed90c73a78d290c8ba471b87f129e0e22cec1d3384338a966187d","exact_candidate_group_id":"DUP_34386113913eed2c","exact_candidate_members":["Радар-31