{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3169","origin":{"collection":"Радар","original_row_number":3169,"raw_json_pointer":"/3168"},"raw":{"description":"ether/etherpadИнструмент для совместного редактирования документов в реальном времени, который можно развернуть локально. Каждое изменение сразу видно всем участникам, а авторство каждой правки фиксируется автоматически. Полная история правок сохраняется, и её можно просматривать посимвольно. Функциональность расширяется через плагины, включая подключение к выбранным AI-моделям.","link":"https://github.com/ether/etherpad"},"raw_record_json":"{\"description\":\"ether/etherpadИнструмент для совместного редактирования документов в реальном времени, который можно развернуть локально. Каждое изменение сразу видно всем участникам, а авторство каждой правки фиксируется автоматически. Полная история правок сохраняется, и её можно просматривать посимвольно. Функциональность расширяется через плагины, включая подключение к выбранным AI-моделям.\",\"link\":\"https://github.com/ether/etherpad\"}","identity":{"raw_url":"https://github.com/ether/etherpad","normalized_exact_url":"https://github.com/ether/etherpad","normalized_address_key":"github.com/ether/etherpad","url_host":"github.com","owner_repo":"ether/etherpad"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-3169.md","card_sha256":"b082e14f19e441511dc2a48b4b9f892c8dabfea703286236552b8c8cad4815a8","exact_candidate_group_id":"DUP_ad5d35c90fdb7ba7