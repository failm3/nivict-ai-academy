{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-3171","origin":{"collection":"Радар","original_row_number":3171,"raw_json_pointer":"/3170"},"raw":{"description":"warpdotdev/warpЭто среда разработки, встроенная в терминал и дополненная собственным агентом для написания кода. Агент самостоятельно разбирает задачи, составляет спецификации, вносит изменения и проверяет код. Можно подключить сторонние агенты — Claude Code, Codex, Gemini CLI и другие. Для командной работы доступны фабрики: настраиваемые цепочки задач, которые автоматизируют разработку.","link":"https://github.com/warpdotdev/warp"},"raw_record_json":"{\"description\":\"warpdotdev/warpЭто среда разработки, встроенная в терминал и дополненная собственным агентом для написания кода. Агент самостоятельно разбирает задачи, составляет спецификации, вносит изменения и проверяет код. Можно подключить сторонние агенты — Claude Code, Codex, Gemini CLI и другие. Для командной работы доступны фабрики: настраиваемые цепочки задач, которые автоматизируют разработку.\",\"link\":\"https://github.com/warpdotdev/warp\"}","identity":{"raw_url":"https://github.com/warpdotdev/warp","normalized_exact_url":"https://github.com/warpdotdev/warp","normalized_address_key":"github.com/warpdotdev/warp","url_host":"github.com","owner_repo":"warpdotdev/warp"},"classification":{"semantic_class":"CLI","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-3171.md","card_sha256":"a149f037d511e58a76512151d8204c51f48920b36f5ec60bcf933bdd4f5b8203","exact_candidate_group_id":"DUP_19c2ece78944bd79","exact_candidate_