{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0232","origin":{"collection":"Радар","original_row_number":232,"raw_json_pointer":"/231"},"raw":{"description":"vnotex/vnote — Приложение для ведения заметок, которое работает на Linux, Windows и macOS. Основной формат работы — Markdown, при этом инструмент не просто редактирует текст, а предоставляет полноценную систему управления заметками. Пользователь может организовывать заметки, удобно их просматривать и редактировать в едином интерфейсе. В будущем планируется поддержка дополнительных форматов помимо Markdown. — ❤","link":"https://github.com/vnotex/vnote"},"raw_record_json":"{\"description\":\"vnotex/vnote — Приложение для ведения заметок, которое работает на Linux, Windows и macOS. Основной формат работы — Markdown, при этом инструмент не просто редактирует текст, а предоставляет полноценную систему управления заметками. Пользователь может организовывать заметки, удобно их просматривать и редактировать в едином интерфейсе. В будущем планируется поддержка дополнительных форматов помимо Markdown. — ❤\",\"link\":\"https://github.com/vnotex/vnote\"}","identity":{"raw_url":"https://github.com/vnotex/vnote","normalized_exact_url":"https://github.com/vnotex/vnote","normalized_address_key":"github.com/vnotex/vnote","url_host":"github.com","owner_repo":"vnotex/vnote"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","observability_economics","skills_competence"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Знания - Обучение и исследования","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Знания---Обучение-и-исследования/Радар-0232.md","card_sha256":"b9631c5693f0f0d4eaf7b725d23daf6137e5281a6b4e99bed7c0cebe26d86dff","exact_ca