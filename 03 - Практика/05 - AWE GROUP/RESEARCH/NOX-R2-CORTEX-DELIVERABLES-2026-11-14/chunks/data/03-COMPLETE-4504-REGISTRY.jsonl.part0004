{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0359","origin":{"collection":"Радар","original_row_number":359,"raw_json_pointer":"/358"},"raw":{"description":"lusingander/serie — TUI-приложение для просмотра истории git-репозитория в терминале. Отображает граф коммитов, аналогичный `git log --graph --all`, но с визуализацией через протоколы отображения изображений терминала — iTerm и Kitty. Граф рендерится как растровое изображение, а не ASCII-символами. — ❤","link":"https://github.com/lusingander/serie"},"raw_record_json":"{\"description\":\"lusingander/serie — TUI-приложение для просмотра истории git-репозитория в терминале. Отображает граф коммитов, аналогичный `git log --graph --all`, но с визуализацией через протоколы отображения изображений терминала — iTerm и Kitty. Граф рендерится как растровое изображение, а не ASCII-символами. — ❤\",\"link\":\"https://github.com/lusingander/serie\"}","identity":{"raw_url":"https://github.com/lusingander/serie","normalized_exact_url":"https://github.com/lusingander/serie","normalized_address_key":"github.com/lusingander/serie","url_host":"github.com","owner_repo":"lusingander/serie"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0359.md","card_sha256":"842a2418659d7f701b0491c005783045512f4bff9d19699a0c5c40f8f31aac23","exact_candidate_group_id":"DUP_6b8295d00fd44080","exact_candidate_members":["Радар-0359"],"address_candidate_group_id":"DUP_d0f5862f03bc55b9","address_candidate_members":["Радар-0359"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTED","