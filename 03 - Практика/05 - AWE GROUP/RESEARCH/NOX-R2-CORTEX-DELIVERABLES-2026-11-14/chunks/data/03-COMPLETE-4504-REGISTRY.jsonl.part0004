{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0330","origin":{"collection":"Радар","original_row_number":330,"raw_json_pointer":"/329"},"raw":{"description":"OpenWhispr/openwhispr — Инструмент для голосового ввода текста на рабочем столе. Нажатие горячей клавиши запускает запись, после которой текст автоматически вставляется в любое активное поле. Поддерживает локальную транскрипцию через Whisper и NVIDIA Parakeet — аудио не покидает устройство — или облачную обработку. Без сбора данных и телеметрии. Работает на macOS, Windows и Linux. — 👍","link":"https://github.com/OpenWhispr/openwhispr"},"raw_record_json":"{\"description\":\"OpenWhispr/openwhispr — Инструмент для голосового ввода текста на рабочем столе. Нажатие горячей клавиши запускает запись, после которой текст автоматически вставляется в любое активное поле. Поддерживает локальную транскрипцию через Whisper и NVIDIA Parakeet — аудио не покидает устройство — или облачную обработку. Без сбора данных и телеметрии. Работает на macOS, Windows и Linux. — 👍\",\"link\":\"https://github.com/OpenWhispr/openwhispr\"}","identity":{"raw_url":"https://github.com/OpenWhispr/openwhispr","normalized_exact_url":"https://github.com/openwhispr/openwhispr","normalized_address_key":"github.com/openwhispr/openwhispr","url_host":"github.com","owner_repo":"OpenWhispr/openwhispr"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-0330.md","card_sha256":"0f2ec41512b75c810b7385f15f945d4574dc711f1ed50d1db55d930f23c442db","exact_candidate_group_id":"DUP_b92c08c3906301b1","exact_candidate_mem