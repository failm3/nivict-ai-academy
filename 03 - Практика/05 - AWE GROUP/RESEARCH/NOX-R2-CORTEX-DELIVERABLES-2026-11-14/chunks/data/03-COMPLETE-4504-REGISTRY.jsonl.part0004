{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0201","origin":{"collection":"Радар","original_row_number":201,"raw_json_pointer":"/200"},"raw":{"description":"spf13/cobra — Библиотека для языка Go, которая позволяет разработчикам создавать командные интерфейсы с вложенными подкомандами, флагами и автодополнением в терминале. Поддерживает автоматическую генерацию справки и man-страниц, умные подсказки при опечатках и псевдонимы команд. Используется в таких проектах, как Kubernetes и Hugo. — ❤","link":"https://github.com/spf13/cobra"},"raw_record_json":"{\"description\":\"spf13/cobra — Библиотека для языка Go, которая позволяет разработчикам создавать командные интерфейсы с вложенными подкомандами, флагами и автодополнением в терминале. Поддерживает автоматическую генерацию справки и man-страниц, умные подсказки при опечатках и псевдонимы команд. Используется в таких проектах, как Kubernetes и Hugo. — ❤\",\"link\":\"https://github.com/spf13/cobra\"}","identity":{"raw_url":"https://github.com/spf13/cobra","normalized_exact_url":"https://github.com/spf13/cobra","normalized_address_key":"github.com/spf13/cobra","url_host":"github.com","owner_repo":"spf13/cobra"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0201.md","card_sha256":"a8bf67c99331674b4d578a443bc2aa196d040adb2b5e4373a250a46b0e0bc363","exact_candidate_group_id":"DUP_ea50432daf033da3","exact_candidate_members":["Радар-0201"],"address_candidate_group_id":"DUP_e2f864b01952cc4a","address_candidate_members":["Радар-0201"]},"status":{"maturity_stage":"