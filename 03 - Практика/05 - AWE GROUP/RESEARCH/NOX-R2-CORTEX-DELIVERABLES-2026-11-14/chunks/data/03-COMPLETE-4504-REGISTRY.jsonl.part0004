{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0287","origin":{"collection":"Радар","original_row_number":287,"raw_json_pointer":"/286"},"raw":{"description":"graphhopper/graphhopper — Движок для построения маршрутов на основе данных OpenStreetMap. Вычисляет расстояние, время в пути, пошаговые инструкции и атрибуты дороги для маршрута между двумя и более точками. Поддерживает данные GTFS и точные данные о высотах рельефа. Можно развернуть локально как standalone web-сервер или подключить как Java-библиотеку. — 👍","link":"https://github.com/graphhopper/graphhopper"},"raw_record_json":"{\"description\":\"graphhopper/graphhopper — Движок для построения маршрутов на основе данных OpenStreetMap. Вычисляет расстояние, время в пути, пошаговые инструкции и атрибуты дороги для маршрута между двумя и более точками. Поддерживает данные GTFS и точные данные о высотах рельефа. Можно развернуть локально как standalone web-сервер или подключить как Java-библиотеку. — 👍\",\"link\":\"https://github.com/graphhopper/graphhopper\"}","identity":{"raw_url":"https://github.com/graphhopper/graphhopper","normalized_exact_url":"https://github.com/graphhopper/graphhopper","normalized_address_key":"github.com/graphhopper/graphhopper","url_host":"github.com","owner_repo":"graphhopper/graphhopper"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-0287.md","card_sha256":"ff7ef42aaa2397d9bda75db76be5b837aa08ea4d400963c0d5dc6deea1e63f89","exact_candidate_group_id":"DUP_8565dcbd9c06cbdd","exact_can