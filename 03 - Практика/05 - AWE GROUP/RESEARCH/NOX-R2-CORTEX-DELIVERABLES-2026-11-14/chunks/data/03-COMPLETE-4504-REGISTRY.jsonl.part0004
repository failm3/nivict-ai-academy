{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0352","origin":{"collection":"Радар","original_row_number":352,"raw_json_pointer":"/351"},"raw":{"description":"lencx/Minke — Нативное десктопное приложение для работы с DeepSeek Harness. Объединяет чат, файловый менеджер, терминал, браузер и управление плагинами в одном окне — без переключения между приложениями. Терминал подключается к реальному PTY на хосте, файловый менеджер поддерживает навигацию, просмотр с подсветкой синтаксиса, редактирование и diff. — 👍","link":"https://github.com/lencx/Minke"},"raw_record_json":"{\"description\":\"lencx/Minke — Нативное десктопное приложение для работы с DeepSeek Harness. Объединяет чат, файловый менеджер, терминал, браузер и управление плагинами в одном окне — без переключения между приложениями. Терминал подключается к реальному PTY на хосте, файловый менеджер поддерживает навигацию, просмотр с подсветкой синтаксиса, редактирование и diff. — 👍\",\"link\":\"https://github.com/lencx/Minke\"}","identity":{"raw_url":"https://github.com/lencx/Minke","normalized_exact_url":"https://github.com/lencx/minke","normalized_address_key":"github.com/lencx/minke","url_host":"github.com","owner_repo":"lencx/Minke"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0352.md","card_sha256":"f6de432649ba131f2a8f6456398105e133a57fc37878958a8dc4334537f88f78","exact_candidate_group_id":"DUP_05b6c1846b08b7dc","exact_candidate_members":["Радар-0352"],"address_candidate_group_id":"DUP_3be8109c669f7694","address_candidate_members":["Радар-0352"]},"statu