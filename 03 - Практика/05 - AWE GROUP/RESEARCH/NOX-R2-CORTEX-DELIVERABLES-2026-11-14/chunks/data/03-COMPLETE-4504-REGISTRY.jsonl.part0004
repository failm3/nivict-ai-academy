{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0299","origin":{"collection":"Радар","original_row_number":299,"raw_json_pointer":"/298"},"raw":{"description":"xai-org/x-algorithm — Алгоритм, который управляет лентой «For You» на платформе X. Он определяет, какие публикации пользователь видит в персональной ленте: комбинирует контент от аккаунтов, на которые подписан пользователь, с контентом за пределами его сети, найденным через ML-ретривал. Ранжирование выполняется с помощью трансформерной модели. — ❤","link":"https://github.com/xai-org/x-algorithm"},"raw_record_json":"{\"description\":\"xai-org/x-algorithm — Алгоритм, который управляет лентой «For You» на платформе X. Он определяет, какие публикации пользователь видит в персональной ленте: комбинирует контент от аккаунтов, на которые подписан пользователь, с контентом за пределами его сети, найденным через ML-ретривал. Ранжирование выполняется с помощью трансформерной модели. — ❤\",\"link\":\"https://github.com/xai-org/x-algorithm\"}","identity":{"raw_url":"https://github.com/xai-org/x-algorithm","normalized_exact_url":"https://github.com/xai-org/x-algorithm","normalized_address_key":"github.com/xai-org/x-algorithm","url_host":"github.com","owner_repo":"xai-org/x-algorithm"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-0299.md","card_sha256":"c5e127b0381001953d46158493f64704c7e428a0814abba21dfb6a3831c0afd5","exact_candidate_group_id":"DUP_0b36d4b637d15e92","exact_candidate_members":["Радар-0299"],"address_candidate_group_id":"DUP_c683576d9a07