{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0366","origin":{"collection":"Радар","original_row_number":366,"raw_json_pointer":"/365"},"raw":{"description":"HeliBorg/HeliBoard — Клавиатура для Android с открытым исходным кодом, основанная на AOSP / OpenBoard. Не запрашивает разрешение на доступ к интернету и работает полностью офлайн. — Поддерживает подключение пользовательских словарей для автодополнения и проверки орфографии, включая словари эмодзи и научных символов.","link":"https://github.com/HeliBorg/HeliBoard"},"raw_record_json":"{\"description\":\"HeliBorg/HeliBoard — Клавиатура для Android с открытым исходным кодом, основанная на AOSP / OpenBoard. Не запрашивает разрешение на доступ к интернету и работает полностью офлайн. — Поддерживает подключение пользовательских словарей для автодополнения и проверки орфографии, включая словари эмодзи и научных символов.\",\"link\":\"https://github.com/HeliBorg/HeliBoard\"}","identity":{"raw_url":"https://github.com/HeliBorg/HeliBoard","normalized_exact_url":"https://github.com/heliborg/heliboard","normalized_address_key":"github.com/heliborg/heliboard","url_host":"github.com","owner_repo":"HeliBorg/HeliBoard"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","skills_competence"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Знания - Обучение и исследования","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Знания---Обучение-и-исследования/Радар-0366.md","card_sha256":"f6028705c135a52fbbbc51a73f0c6144292bdfffb398bf170227c04315d21660","exact_candidate_group_id":"DUP_c0d22e3295ad10e8","exact_candidate_members":["Радар-0366"],"address_candidate_group_id":"DUP_3553c3f83e091957","address_candidate_members":["Радар-