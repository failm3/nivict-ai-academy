{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0326","origin":{"collection":"Радар","original_row_number":326,"raw_json_pointer":"/325"},"raw":{"description":"crmne/fastpotify — Клиент Spotify, написанный на Rust с использованием egui. Воспроизводит музыку через librespot, потребляет 100–250 МБ оперативной памяти против 600 МБ и более у официального приложения, запускается менее чем за секунду и не содержит браузерного движка. Работает на Linux, macOS и Windows. — ❤","link":"https://github.com/crmne/fastpotify"},"raw_record_json":"{\"description\":\"crmne/fastpotify — Клиент Spotify, написанный на Rust с использованием egui. Воспроизводит музыку через librespot, потребляет 100–250 МБ оперативной памяти против 600 МБ и более у официального приложения, запускается менее чем за секунду и не содержит браузерного движка. Работает на Linux, macOS и Windows. — ❤\",\"link\":\"https://github.com/crmne/fastpotify\"}","identity":{"raw_url":"https://github.com/crmne/fastpotify","normalized_exact_url":"https://github.com/crmne/fastpotify","normalized_address_key":"github.com/crmne/fastpotify","url_host":"github.com","owner_repo":"crmne/fastpotify"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable","retrieval_memory"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-0326.md","card_sha256":"2c0ba654089da27eb956b4104b8685fa394062248bff1fb883eaa668f90cd399","exact_candidate_group_id":"DUP_6c1af913d3a1f038","exact_candidate_members":["Радар-0326"],"address_candidate_group_id":"DUP_c214533ace29b16d","address_candidate_members":["Радар-0326"]},"status":{"maturity_stage":"RAW_CANDIDATE",