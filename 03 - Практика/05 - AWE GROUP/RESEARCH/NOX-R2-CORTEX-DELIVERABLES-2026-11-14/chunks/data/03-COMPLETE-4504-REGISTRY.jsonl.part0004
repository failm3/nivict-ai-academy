{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0307","origin":{"collection":"Радар","original_row_number":307,"raw_json_pointer":"/306"},"raw":{"description":"univrsal/input-overlay — Плагин для OBS Studio, который отображает нажатия клавиш, движения мыши и ввод с геймпада прямо на стрейме. Работает на Windows и Linux (64-bit). — Ввод отображается в виде настраиваемых оверлеев. Конфигурации создаются через отдельный инструмент и хранятся в формате JSON. Плагин использует libuiohook для перехвата ввода и SDL2 для работы с геймпадами.","link":"https://github.com/univrsal/input-overlay"},"raw_record_json":"{\"description\":\"univrsal/input-overlay — Плагин для OBS Studio, который отображает нажатия клавиш, движения мыши и ввод с геймпада прямо на стрейме. Работает на Windows и Linux (64-bit). — Ввод отображается в виде настраиваемых оверлеев. Конфигурации создаются через отдельный инструмент и хранятся в формате JSON. Плагин использует libuiohook для перехвата ввода и SDL2 для работы с геймпадами.\",\"link\":\"https://github.com/univrsal/input-overlay\"}","identity":{"raw_url":"https://github.com/univrsal/input-overlay","normalized_exact_url":"https://github.com/univrsal/input-overlay","normalized_address_key":"github.com/univrsal/input-overlay","url_host":"github.com","owner_repo":"univrsal/input-overlay"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-0307.md","card_sha256":"71072f255711c13e64993441d959edcc0244cb360a7c71493fde44d86a71f420","exact_candidate_group_id":"DUP_76777f2ff2404e95","exact_candidate_members":["Радар-03