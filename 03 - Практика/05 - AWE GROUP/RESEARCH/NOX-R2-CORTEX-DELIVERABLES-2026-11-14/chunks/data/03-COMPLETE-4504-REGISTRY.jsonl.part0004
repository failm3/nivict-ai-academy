{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0372","origin":{"collection":"Радар","original_row_number":372,"raw_json_pointer":"/371"},"raw":{"description":"square/leakcanary — Библиотека для обнаружения утечек памяти в Android-приложениях. Встраивается в проект и автоматически отслеживает объекты, которые должны быть удалены сборщиком мусора, но остаются в памяти. — При обнаружении утечки LeakCanary анализирует heap и строит цепочку ссылок, удерживающих объект в памяти.","link":"https://github.com/square/leakcanary"},"raw_record_json":"{\"description\":\"square/leakcanary — Библиотека для обнаружения утечек памяти в Android-приложениях. Встраивается в проект и автоматически отслеживает объекты, которые должны быть удалены сборщиком мусора, но остаются в памяти. — При обнаружении утечки LeakCanary анализирует heap и строит цепочку ссылок, удерживающих объект в памяти.\",\"link\":\"https://github.com/square/leakcanary\"}","identity":{"raw_url":"https://github.com/square/leakcanary","normalized_exact_url":"https://github.com/square/leakcanary","normalized_address_key":"github.com/square/leakcanary","url_host":"github.com","owner_repo":"square/leakcanary"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["retrieval_memory"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-0372.md","card_sha256":"026c203c2c50173921c4e21831c85ef1058cc6a6595697b6761a510f2a5d3781","exact_candidate_group_id":"DUP_825a44dd15fa9f0e","exact_candidate_members":["Радар-0372"],"address_candidate_group_id":"DUP_0e7b13bad2be3f6e","address_candidate_members":["Радар-0372"]},"status":{"