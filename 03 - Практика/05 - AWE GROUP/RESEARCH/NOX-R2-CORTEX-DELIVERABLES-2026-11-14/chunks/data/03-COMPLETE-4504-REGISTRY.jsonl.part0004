{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0337","origin":{"collection":"Радар","original_row_number":337,"raw_json_pointer":"/336"},"raw":{"description":"Clats97/ClatScope — Инструмент для OSINT-разведки с более чем 70 функциями. Собирает данные по IP-адресам, доменам, email-адресам, номерам телефонов и именам пользователей. Проверяет утечки данных через Have I Been Pwned и Hudson Rock, извлекает DNS-записи, выполняет WHOIS-запросы, определяет геолокацию и провайдера, ищет аккаунты по имени пользователя на более чем 250 сайтах. — 🤔","link":"https://github.com/Clats97/ClatScope"},"raw_record_json":"{\"description\":\"Clats97/ClatScope — Инструмент для OSINT-разведки с более чем 70 функциями. Собирает данные по IP-адресам, доменам, email-адресам, номерам телефонов и именам пользователей. Проверяет утечки данных через Have I Been Pwned и Hudson Rock, извлекает DNS-записи, выполняет WHOIS-запросы, определяет геолокацию и провайдера, ищет аккаунты по имени пользователя на более чем 250 сайтах. — 🤔\",\"link\":\"https://github.com/Clats97/ClatScope\"}","identity":{"raw_url":"https://github.com/Clats97/ClatScope","normalized_exact_url":"https://github.com/clats97/clatscope","normalized_address_key":"github.com/clats97/clatscope","url_host":"github.com","owner_repo":"Clats97/ClatScope"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-0337.md","card_sha256":"eee96b66bfdfc1c2b5ff03c4683ca3aa263c21c922900099cbd9e3ce18bfda6d","exact_candidate_group_id":"DUP_33cd6835632d1b59","exact_candidate_members":["Радар-0337"],"address_candid