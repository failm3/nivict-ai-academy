{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0370","origin":{"collection":"Радар","original_row_number":370,"raw_json_pointer":"/369"},"raw":{"description":"dubinc/dub — Платформа для управления короткими ссылками, отслеживания конверсий и партнёрских программ. Обрабатывает более 100 миллионов кликов и 2 миллионов ссылок в месяц. Можно развернуть локально для полного контроля над данными. — Построена на Next.js, TypeScript и Prisma. Для аналитики используется Tinybird, для кэширования — Upstash, для базы данных — PlanetScale. Поддерживает SAML/SSO через BoxyHQ.","link":"https://github.com/dubinc/dub"},"raw_record_json":"{\"description\":\"dubinc/dub — Платформа для управления короткими ссылками, отслеживания конверсий и партнёрских программ. Обрабатывает более 100 миллионов кликов и 2 миллионов ссылок в месяц. Можно развернуть локально для полного контроля над данными. — Построена на Next.js, TypeScript и Prisma. Для аналитики используется Tinybird, для кэширования — Upstash, для базы данных — PlanetScale. Поддерживает SAML/SSO через BoxyHQ.\",\"link\":\"https://github.com/dubinc/dub\"}","identity":{"raw_url":"https://github.com/dubinc/dub","normalized_exact_url":"https://github.com/dubinc/dub","normalized_address_key":"github.com/dubinc/dub","url_host":"github.com","owner_repo":"dubinc/dub"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0370.md","card_sha256":"678e1759a740fe01dfd8a336820636d12713ee79aba525c0c6428047a0ca6220","exact_candidate_group_id":"DUP_6cabc778a618357b","exact_candidate_members":["