{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0056","origin":{"collection":"Радар","original_row_number":56,"raw_json_pointer":"/55"},"raw":{"description":"gitbucket/gitbucket — Self-hosted платформа для работы с Git-репозиториями, которую можно развернуть локально без сложной настройки. Поддерживает приватные и публичные репозитории, задачи, вики и уведомления по электронной почте. Совместима с GitHub API, что позволяет использовать привычные инструменты без изменений. Функциональность расширяется через плагины, а управление пользователями поддерживает интеграцию с LDAP. — ❤","link":"https://github.com/gitbucket/gitbucket"},"raw_record_json":"{\"description\":\"gitbucket/gitbucket — Self-hosted платформа для работы с Git-репозиториями, которую можно развернуть локально без сложной настройки. Поддерживает приватные и публичные репозитории, задачи, вики и уведомления по электронной почте. Совместима с GitHub API, что позволяет использовать привычные инструменты без изменений. Функциональность расширяется через плагины, а управление пользователями поддерживает интеграцию с LDAP. — ❤\",\"link\":\"https://github.com/gitbucket/gitbucket\"}","identity":{"raw_url":"https://github.com/gitbucket/gitbucket","normalized_exact_url":"https://github.com/gitbucket/gitbucket","normalized_address_key":"github.com/gitbucket/gitbucket","url_host":"github.com","owner_repo":"gitbucket/gitbucket"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics","security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-0056.md","card_sha256":"2