{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0207","origin":{"collection":"Радар","original_row_number":207,"raw_json_pointer":"/206"},"raw":{"description":"ruffle-rs/ruffle — Эмулятор Adobe Flash Player, который позволяет запускать SWF-файлы без установки оригинального плеера. Работает на настольных операционных системах, включая macOS, а также в браузере. Поддерживает сценарии на ActionScript 1, 2 и 3, что охватывает большинство Flash-контента. Можно развернуть локально или встроить в браузер в виде расширения. — 👍","link":"https://github.com/ruffle-rs/ruffle"},"raw_record_json":"{\"description\":\"ruffle-rs/ruffle — Эмулятор Adobe Flash Player, который позволяет запускать SWF-файлы без установки оригинального плеера. Работает на настольных операционных системах, включая macOS, а также в браузере. Поддерживает сценарии на ActionScript 1, 2 и 3, что охватывает большинство Flash-контента. Можно развернуть локально или встроить в браузер в виде расширения. — 👍\",\"link\":\"https://github.com/ruffle-rs/ruffle\"}","identity":{"raw_url":"https://github.com/ruffle-rs/ruffle","normalized_exact_url":"https://github.com/ruffle-rs/ruffle","normalized_address_key":"github.com/ruffle-rs/ruffle","url_host":"github.com","owner_repo":"ruffle-rs/ruffle"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0207.md","card_sha256":"1a03f0039a3c0c8121169d3fd34e9a61ea5d7216b55fdcf73adb8e79e367e530","exact_candidate_group_id":"DUP_7fb339d21fd7b5d5","exact_candidate_members":["Радар-0207"],"address_candidate_group_id":"DUP_