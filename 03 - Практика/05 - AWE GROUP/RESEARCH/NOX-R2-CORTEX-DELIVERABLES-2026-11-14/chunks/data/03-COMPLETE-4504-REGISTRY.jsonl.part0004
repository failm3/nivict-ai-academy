{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0164","origin":{"collection":"Радар","original_row_number":164,"raw_json_pointer":"/163"},"raw":{"description":"ShareDropio/sharedrop — Инструмент позволяет передавать файлы напрямую между устройствами без загрузки на сервер. Устройства в одной сети находят друг друга автоматически, а для передачи между разными сетями достаточно создать комнату и поделиться ссылкой. Поддерживаются Android, iOS и настольные браузеры. Можно развернуть локально на собственной инфраструктуре. — 👍","link":"https://github.com/ShareDropio/sharedrop"},"raw_record_json":"{\"description\":\"ShareDropio/sharedrop — Инструмент позволяет передавать файлы напрямую между устройствами без загрузки на сервер. Устройства в одной сети находят друг друга автоматически, а для передачи между разными сетями достаточно создать комнату и поделиться ссылкой. Поддерживаются Android, iOS и настольные браузеры. Можно развернуть локально на собственной инфраструктуре. — 👍\",\"link\":\"https://github.com/ShareDropio/sharedrop\"}","identity":{"raw_url":"https://github.com/ShareDropio/sharedrop","normalized_exact_url":"https://github.com/sharedropio/sharedrop","normalized_address_key":"github.com/sharedropio/sharedrop","url_host":"github.com","owner_repo":"ShareDropio/sharedrop"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-0164.md","card_sha256":"ea19c3b6c5dfa9f1d61a4f9b5cf52325f25be7e623fcb8b8d183660065a2b7d7","exact_candidate_group_id":"DUP_6fd2b499865f08a7","exac