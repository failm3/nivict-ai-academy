{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0191","origin":{"collection":"Радар","original_row_number":191,"raw_json_pointer":"/190"},"raw":{"description":"sudoevolve/EUI-NEO — Кроссплатформенный фреймворк на C++17 для создания графических интерфейсов с низкими накладными расходами. Поддерживает оконные бэкенды GLFW и SDL2, а также рендеринг через OpenGL и Vulkan. Позволяет описывать интерфейс декларативно: задавать колонки, текст, отступы и размеры окна в коде. Собирается через CMake и работает на Windows, Linux и macOS. — 👍","link":"https://github.com/sudoevolve/EUI-NEO"},"raw_record_json":"{\"description\":\"sudoevolve/EUI-NEO — Кроссплатформенный фреймворк на C++17 для создания графических интерфейсов с низкими накладными расходами. Поддерживает оконные бэкенды GLFW и SDL2, а также рендеринг через OpenGL и Vulkan. Позволяет описывать интерфейс декларативно: задавать колонки, текст, отступы и размеры окна в коде. Собирается через CMake и работает на Windows, Linux и macOS. — 👍\",\"link\":\"https://github.com/sudoevolve/EUI-NEO\"}","identity":{"raw_url":"https://github.com/sudoevolve/EUI-NEO","normalized_exact_url":"https://github.com/sudoevolve/eui-neo","normalized_address_key":"github.com/sudoevolve/eui-neo","url_host":"github.com","owner_repo":"sudoevolve/EUI-NEO"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0191.md","card_sha256":"d9e9321d1d0be26226cddd66cfef264eb257735bdaf28b792186c96967ab9661","exact_candidate_group_id":"DUP_b353b7b52ed1891b","exact_candidate_members":["Радар-0191"],"address_candidate_group_i