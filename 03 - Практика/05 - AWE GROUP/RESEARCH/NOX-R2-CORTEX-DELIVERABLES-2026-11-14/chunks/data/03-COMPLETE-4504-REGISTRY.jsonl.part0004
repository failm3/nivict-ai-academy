{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0100","origin":{"collection":"Радар","original_row_number":100,"raw_json_pointer":"/99"},"raw":{"description":"sqlitebrowser/sqlitebrowser — DB Browser for SQLite — визуальный инструмент для работы с базами данных SQLite без знания SQL. Он позволяет создавать и редактировать таблицы, добавлять и удалять записи, выполнять поиск и строить простые графики по данным. Поддерживается импорт и экспорт данных в форматах CSV и SQL. Интерфейс напоминает таблицу, что упрощает работу для тех, кто не знаком с базами данных. — 🔥","link":"https://github.com/sqlitebrowser/sqlitebrowser"},"raw_record_json":"{\"description\":\"sqlitebrowser/sqlitebrowser — DB Browser for SQLite — визуальный инструмент для работы с базами данных SQLite без знания SQL. Он позволяет создавать и редактировать таблицы, добавлять и удалять записи, выполнять поиск и строить простые графики по данным. Поддерживается импорт и экспорт данных в форматах CSV и SQL. Интерфейс напоминает таблицу, что упрощает работу для тех, кто не знаком с базами данных. — 🔥\",\"link\":\"https://github.com/sqlitebrowser/sqlitebrowser\"}","identity":{"raw_url":"https://github.com/sqlitebrowser/sqlitebrowser","normalized_exact_url":"https://github.com/sqlitebrowser/sqlitebrowser","normalized_address_key":"github.com/sqlitebrowser/sqlitebrowser","url_host":"github.com","owner_repo":"sqlitebrowser/sqlitebrowser"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","retrieval_memory"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0100.md","card_sha256":"ea36e616135768