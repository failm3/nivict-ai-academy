{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0126","origin":{"collection":"Радар","original_row_number":126,"raw_json_pointer":"/125"},"raw":{"description":"webtor-io/web-ui — Веб-интерфейс для работы с торрентами, который можно развернуть локально. Позволяет загружать торрент-файлы и magnet-ссылки, просматривать список файлов, скачивать их напрямую или папками в виде ZIP-архива. Поддерживает потоковое воспроизведение видео и аудио, показ субтитров и Chromecast. Есть тёмная и светлая темы, авторизация через Google и интеграция со Stremio. — 👍","link":"https://github.com/webtor-io/web-ui"},"raw_record_json":"{\"description\":\"webtor-io/web-ui — Веб-интерфейс для работы с торрентами, который можно развернуть локально. Позволяет загружать торрент-файлы и magnet-ссылки, просматривать список файлов, скачивать их напрямую или папками в виде ZIP-архива. Поддерживает потоковое воспроизведение видео и аудио, показ субтитров и Chromecast. Есть тёмная и светлая темы, авторизация через Google и интеграция со Stremio. — 👍\",\"link\":\"https://github.com/webtor-io/web-ui\"}","identity":{"raw_url":"https://github.com/webtor-io/web-ui","normalized_exact_url":"https://github.com/webtor-io/web-ui","normalized_address_key":"github.com/webtor-io/web-ui","url_host":"github.com","owner_repo":"webtor-io/web-ui"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0126.md","card_sha256":"14604fdbef9112d636dcdb4a4c99626be28d0333792a7fb765edca3ab9d259b3","exact_candidate_group_id":"DUP_41c2da2f9f463f33","exact_candidate_members":["Радар-0126"],"addre