{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0215","origin":{"collection":"Радар","original_row_number":215,"raw_json_pointer":"/214"},"raw":{"description":"apache/camel — Фреймворк для интеграции разных систем между собой: баз данных, очередей сообщений, облачных сервисов и внешних API. Позволяет описывать маршруты передачи данных на Java, YAML или XML и запускать их локально через командную строку или в составе Spring Boot и Quarkus. Включает более 350 готовых коннекторов к популярным платформам. — ❤","link":"https://github.com/apache/camel"},"raw_record_json":"{\"description\":\"apache/camel — Фреймворк для интеграции разных систем между собой: баз данных, очередей сообщений, облачных сервисов и внешних API. Позволяет описывать маршруты передачи данных на Java, YAML или XML и запускать их локально через командную строку или в составе Spring Boot и Quarkus. Включает более 350 готовых коннекторов к популярным платформам. — ❤\",\"link\":\"https://github.com/apache/camel\"}","identity":{"raw_url":"https://github.com/apache/camel","normalized_exact_url":"https://github.com/apache/camel","normalized_address_key":"github.com/apache/camel","url_host":"github.com","owner_repo":"apache/camel"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0215.md","card_sha256":"6adef5852a6373037326846ccd4c0660ccee9870889950aad3d156613ae08345","exact_candidate_group_id":"DUP_61a151a51675dab8","exact_candidate_members":["Радар-0215"],"address_candidate_group_id":"DUP_ad655d33d3f7fbac","address_candidate_members