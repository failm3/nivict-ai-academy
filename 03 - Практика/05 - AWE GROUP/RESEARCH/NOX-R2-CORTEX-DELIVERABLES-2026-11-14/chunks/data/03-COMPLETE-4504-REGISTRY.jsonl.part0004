{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0120","origin":{"collection":"Радар","original_row_number":120,"raw_json_pointer":"/119"},"raw":{"description":"aframevr/aframe — Инструмент позволяет создавать трёхмерные, AR и VR сцены прямо в браузере с помощью HTML-разметки. Достаточно добавить несколько тегов — и сцена заработает на мобильных устройствах, десктопе и VR-гарнитурах. Встроенный визуальный редактор позволяет осматривать и редактировать сцену без перезагрузки страницы. Проект можно развернуть локально. — 🔥","link":"https://github.com/aframevr/aframe"},"raw_record_json":"{\"description\":\"aframevr/aframe — Инструмент позволяет создавать трёхмерные, AR и VR сцены прямо в браузере с помощью HTML-разметки. Достаточно добавить несколько тегов — и сцена заработает на мобильных устройствах, десктопе и VR-гарнитурах. Встроенный визуальный редактор позволяет осматривать и редактировать сцену без перезагрузки страницы. Проект можно развернуть локально. — 🔥\",\"link\":\"https://github.com/aframevr/aframe\"}","identity":{"raw_url":"https://github.com/aframevr/aframe","normalized_exact_url":"https://github.com/aframevr/aframe","normalized_address_key":"github.com/aframevr/aframe","url_host":"github.com","owner_repo":"aframevr/aframe"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0120.md","card_sha256":"38d38e233d61b1d31478010a28545d51d776352cdb76a1f64dd1e2fcc6ad462a","exact_candidate_group_id":"DUP_b38c9b4dee8319be","exact_candidate_members":["Радар-0120"],"address_candidate_group_id":"DUP_c792b3d0a40