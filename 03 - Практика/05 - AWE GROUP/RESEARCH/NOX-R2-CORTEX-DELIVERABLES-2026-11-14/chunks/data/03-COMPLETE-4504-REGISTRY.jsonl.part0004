{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0116","origin":{"collection":"Радар","original_row_number":116,"raw_json_pointer":"/115"},"raw":{"description":"abue-ammar/tinycast — Небольшой нативный лаунчер для macOS, который можно развернуть локально. Одним сочетанием клавиш открывает палитру команд для запуска приложений, поиска файлов, истории буфера обмена и калькулятора с конвертацией валют. Поддерживает сниппеты, управление окнами, системные действия и запуск расширений Raycast. Работает без сторонних зависимостей и не собирает данные о пользователе. — ❤","link":"https://github.com/abue-ammar/tinycast"},"raw_record_json":"{\"description\":\"abue-ammar/tinycast — Небольшой нативный лаунчер для macOS, который можно развернуть локально. Одним сочетанием клавиш открывает палитру команд для запуска приложений, поиска файлов, истории буфера обмена и калькулятора с конвертацией валют. Поддерживает сниппеты, управление окнами, системные действия и запуск расширений Raycast. Работает без сторонних зависимостей и не собирает данные о пользователе. — ❤\",\"link\":\"https://github.com/abue-ammar/tinycast\"}","identity":{"raw_url":"https://github.com/abue-ammar/tinycast","normalized_exact_url":"https://github.com/abue-ammar/tinycast","normalized_address_key":"github.com/abue-ammar/tinycast","url_host":"github.com","owner_repo":"abue-ammar/tinycast"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["retrieval_memory"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0116.md","card_sha256":"06d52601d2ebbcf6bc09a9784a07620a357e887b4683c3e1b8aa593f78120a19","exact_candidate_group_id":"DUP_e68