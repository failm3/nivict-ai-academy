{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0410","origin":{"collection":"Радар","original_row_number":410,"raw_json_pointer":"/409"},"raw":{"description":"navidrome/navidrome — Self-hosted сервер для стриминга личной музыкальной коллекции. Работает через браузер или мобильное устройство — без привязки к сторонним сервисам. — Поддерживает практически любые аудиоформаты, читает метаданные треков, корректно обрабатывает сборники и многодисковые альбомы. Несколько пользователей могут работать независимо: у каждого свои плейлисты, счётчики воспроизведений и избранное.","link":"https://github.com/navidrome/navidrome"},"raw_record_json":"{\"description\":\"navidrome/navidrome — Self-hosted сервер для стриминга личной музыкальной коллекции. Работает через браузер или мобильное устройство — без привязки к сторонним сервисам. — Поддерживает практически любые аудиоформаты, читает метаданные треков, корректно обрабатывает сборники и многодисковые альбомы. Несколько пользователей могут работать независимо: у каждого свои плейлисты, счётчики воспроизведений и избранное.\",\"link\":\"https://github.com/navidrome/navidrome\"}","identity":{"raw_url":"https://github.com/navidrome/navidrome","normalized_exact_url":"https://github.com/navidrome/navidrome","normalized_address_key":"github.com/navidrome/navidrome","url_host":"github.com","owner_repo":"navidrome/navidrome"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-0410.md","card_sha256":"2c77a7288978f71d4e2c9206d00ba11e10307072ebdd37e48ffaf580355071f9","exact_candidate_group_id":"DUP_