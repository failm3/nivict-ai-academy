{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0173","origin":{"collection":"Радар","original_row_number":173,"raw_json_pointer":"/172"},"raw":{"description":"leits/MeetingBar — Приложение для macOS отображает текущую или ближайшую встречу прямо в строке меню и позволяет подключиться к ней одним кликом. Оно автоматически находит ссылки на встречи в событиях календаря и поддерживает более 50 сервисов, включая Google Meet, Zoom и Microsoft Teams. Работает с macOS Calendar и Google Calendar. Можно настроить уведомления и горячие клавиши. — 🔥","link":"https://github.com/leits/MeetingBar"},"raw_record_json":"{\"description\":\"leits/MeetingBar — Приложение для macOS отображает текущую или ближайшую встречу прямо в строке меню и позволяет подключиться к ней одним кликом. Оно автоматически находит ссылки на встречи в событиях календаря и поддерживает более 50 сервисов, включая Google Meet, Zoom и Microsoft Teams. Работает с macOS Calendar и Google Calendar. Можно настроить уведомления и горячие клавиши. — 🔥\",\"link\":\"https://github.com/leits/MeetingBar\"}","identity":{"raw_url":"https://github.com/leits/MeetingBar","normalized_exact_url":"https://github.com/leits/meetingbar","normalized_address_key":"github.com/leits/meetingbar","url_host":"github.com","owner_repo":"leits/MeetingBar"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-0173.md","card_sha256":"df1ce9e16884c3537b21e852cfc4383cefa17fb62759106bf9ab5f09d5c59d30","exact_candidate_group_id":"DUP_8cad55fbbc503cb9","exact_candidate_members":["Радар-0173"],"addres