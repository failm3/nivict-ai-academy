{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2324","origin":{"collection":"Радар","original_row_number":2324,"raw_json_pointer":"/2323"},"raw":{"description":"trueai-org/grok — Grok — это бесплатный прокси-сервис на базе Deno, позволяющий пользователям без регистрации подключаться к интернету. Он обеспечивает прямое соединение в пределах страны, не ограничивая доступ по регионам, сетям или устройствам. Grok предлагает простоту использования и доступность, что делает его удобным инструментом для обхода ограничений. — 👎","link":"https://github.com/trueai-org/grok"},"raw_record_json":"{\"description\":\"trueai-org/grok — Grok — это бесплатный прокси-сервис на базе Deno, позволяющий пользователям без регистрации подключаться к интернету. Он обеспечивает прямое соединение в пределах страны, не ограничивая доступ по регионам, сетям или устройствам. Grok предлагает простоту использования и доступность, что делает его удобным инструментом для обхода ограничений. — 👎\",\"link\":\"https://github.com/trueai-org/grok\"}","identity":{"raw_url":"https://github.com/trueai-org/grok","normalized_exact_url":"https://github.com/trueai-org/grok","normalized_address_key":"github.com/trueai-org/grok","url_host":"github.com","owner_repo":"trueai-org/grok"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics","quality_evaluation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-2324.md","card_sha256":"dcc35780f43f52916a9247f15a823aecf5e04b096669146b7749f5b7c06c5944","exact_candidate_group_id":"DUP_5041846509eec8c8","exact_candidate_members":["Р