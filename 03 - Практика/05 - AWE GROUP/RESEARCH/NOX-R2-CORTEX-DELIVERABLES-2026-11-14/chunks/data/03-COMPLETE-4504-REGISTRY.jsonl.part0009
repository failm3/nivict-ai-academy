{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2456","origin":{"collection":"Радар","original_row_number":2456,"raw_json_pointer":"/2455"},"raw":{"description":"NLPOptimize/flash-tokenizer — Flash-tokenizer представляет собой эффективный и оптимизированный движок токенизации, специально разработанный для обслуживания вывода больших языковых моделей (LLM). Он обеспечивает быструю и точную обработку текстовых данных, что критично для задач, связанных с машинным обучением и обработкой естественного языка. — 🔥","link":"https://github.com/NLPOptimize/flash-tokenizer"},"raw_record_json":"{\"description\":\"NLPOptimize/flash-tokenizer — Flash-tokenizer представляет собой эффективный и оптимизированный движок токенизации, специально разработанный для обслуживания вывода больших языковых моделей (LLM). Он обеспечивает быструю и точную обработку текстовых данных, что критично для задач, связанных с машинным обучением и обработкой естественного языка. — 🔥\",\"link\":\"https://github.com/NLPOptimize/flash-tokenizer\"}","identity":{"raw_url":"https://github.com/NLPOptimize/flash-tokenizer","normalized_exact_url":"https://github.com/nlpoptimize/flash-tokenizer","normalized_address_key":"github.com/nlpoptimize/flash-tokenizer","url_host":"github.com","owner_repo":"NLPOptimize/flash-tokenizer"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","quality_evaluation","skills_competence"],"contours":["D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-2456.md","card_sha256":"ec78651427e10aa2a622c9321f66b918a16b39bb8ec7e0e51656b729070d33c4","exact_candidate_group_id":"DUP_c88cd65ae0ed5d15","exac