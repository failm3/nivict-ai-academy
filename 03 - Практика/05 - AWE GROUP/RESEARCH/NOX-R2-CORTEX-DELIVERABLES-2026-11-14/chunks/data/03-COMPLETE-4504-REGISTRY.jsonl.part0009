{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2526","origin":{"collection":"Радар","original_row_number":2526,"raw_json_pointer":"/2525"},"raw":{"description":"ncdai/react-wheel-picker — React-wheel-picker — это компонент для React, который имитирует колесо выбора, как на iOS. Он обеспечивает плавное инерционное прокручивание и поддержку бесконечного цикла, что делает его идеальным для создания интуитивно понятных интерфейсов. Легко настраиваемый и производительный, этот компонент поможет вам добавить стильный и функциональный элемент выбора в ваше приложение.","link":"https://github.com/ncdai/react-wheel-picker"},"raw_record_json":"{\"description\":\"ncdai/react-wheel-picker — React-wheel-picker — это компонент для React, который имитирует колесо выбора, как на iOS. Он обеспечивает плавное инерционное прокручивание и поддержку бесконечного цикла, что делает его идеальным для создания интуитивно понятных интерфейсов. Легко настраиваемый и производительный, этот компонент поможет вам добавить стильный и функциональный элемент выбора в ваше приложение.\",\"link\":\"https://github.com/ncdai/react-wheel-picker\"}","identity":{"raw_url":"https://github.com/ncdai/react-wheel-picker","normalized_exact_url":"https://github.com/ncdai/react-wheel-picker","normalized_address_key":"github.com/ncdai/react-wheel-picker","url_host":"github.com","owner_repo":"ncdai/react-wheel-picker"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-2526.md","card_sha256":"4102cbe56f40c1f79d1a740d3ce6c13762072148d7777b4140afcad266de1fb8","exa