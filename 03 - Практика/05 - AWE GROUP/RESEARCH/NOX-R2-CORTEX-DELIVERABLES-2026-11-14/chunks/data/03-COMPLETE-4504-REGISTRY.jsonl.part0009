{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2340","origin":{"collection":"Радар","original_row_number":2340,"raw_json_pointer":"/2339"},"raw":{"description":"securade/hub — Securade.ai HUB представляет собой платформу на основе генеративного ИИ для компьютерного зрения, которая интегрируется с существующими камерами видеонаблюдения, превращая их в интеллектуальные устройства. Платформа обеспечивает анализ видео в реальном времени и позволяет повысить уровень безопасности, делая системы видеонаблюдения более эффективными и адаптивными. — ❤","link":"https://github.com/securade/hub"},"raw_record_json":"{\"description\":\"securade/hub — Securade.ai HUB представляет собой платформу на основе генеративного ИИ для компьютерного зрения, которая интегрируется с существующими камерами видеонаблюдения, превращая их в интеллектуальные устройства. Платформа обеспечивает анализ видео в реальном времени и позволяет повысить уровень безопасности, делая системы видеонаблюдения более эффективными и адаптивными. — ❤\",\"link\":\"https://github.com/securade/hub\"}","identity":{"raw_url":"https://github.com/securade/hub","normalized_exact_url":"https://github.com/securade/hub","normalized_address_key":"github.com/securade/hub","url_host":"github.com","owner_repo":"securade/hub"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2340.md","card_sha256":"eab2d49017049d0ada58f183be973f459a4360586eafd45f63d8e94d06bb782e","exact_candidate_group_id":"DUP_401aaaa34916ed8a","exact_candidate_members":["Радар-2340"],"address_candidate_