{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2613","origin":{"collection":"Радар","original_row_number":2613,"raw_json_pointer":"/2612"},"raw":{"description":"Pixen/Pixen — Pixen — это удобный редактор пиксельной графики, созданный специально для macOS и iOS. Он предлагает интуитивно понятный интерфейс и мощные инструменты для рисования, анимации и работы с цветами. Пользователи могут легко создавать и редактировать пиксельные изображения, используя различные кисти, слои и эффекты. — ⚡","link":"https://github.com/Pixen/Pixen"},"raw_record_json":"{\"description\":\"Pixen/Pixen — Pixen — это удобный редактор пиксельной графики, созданный специально для macOS и iOS. Он предлагает интуитивно понятный интерфейс и мощные инструменты для рисования, анимации и работы с цветами. Пользователи могут легко создавать и редактировать пиксельные изображения, используя различные кисти, слои и эффекты. — ⚡\",\"link\":\"https://github.com/Pixen/Pixen\"}","identity":{"raw_url":"https://github.com/Pixen/Pixen","normalized_exact_url":"https://github.com/pixen/pixen","normalized_address_key":"github.com/pixen/pixen","url_host":"github.com","owner_repo":"Pixen/Pixen"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-2613.md","card_sha256":"ed03efa888c0ae4186a112d8c52fbe3804a0d4cd232ddcc95c4e86651d1c5ff4","exact_candidate_group_id":"DUP_90a1838f2dbb6c88","exact_candidate_members":["Радар-2613"],"address_candidate_group_id":"DUP_d70ab85e559d0017","address_candidate_members":["Радар-2613"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTE