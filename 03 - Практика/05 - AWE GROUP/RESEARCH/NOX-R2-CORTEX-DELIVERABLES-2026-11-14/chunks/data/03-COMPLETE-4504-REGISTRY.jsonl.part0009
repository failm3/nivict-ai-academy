{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2439","origin":{"collection":"Радар","original_row_number":2439,"raw_json_pointer":"/2438"},"raw":{"description":"dbos-inc/dbos-transact-golang — dbos-transact-golang предлагает легковесные и надежные решения для создания рабочих процессов на языке Go. Он обеспечивает высокую производительность и простоту интеграции, позволяя разработчикам эффективно управлять транзакциями и автоматизировать бизнес-логики. Инструмент подходит для построения масштабируемых приложений и оптимизации процессов, что делает его ценным ресурсом для разработчиков. — ❤","link":"https://github.com/dbos-inc/dbos-transact-golang"},"raw_record_json":"{\"description\":\"dbos-inc/dbos-transact-golang — dbos-transact-golang предлагает легковесные и надежные решения для создания рабочих процессов на языке Go. Он обеспечивает высокую производительность и простоту интеграции, позволяя разработчикам эффективно управлять транзакциями и автоматизировать бизнес-логики. Инструмент подходит для построения масштабируемых приложений и оптимизации процессов, что делает его ценным ресурсом для разработчиков. — ❤\",\"link\":\"https://github.com/dbos-inc/dbos-transact-golang\"}","identity":{"raw_url":"https://github.com/dbos-inc/dbos-transact-golang","normalized_exact_url":"https://github.com/dbos-inc/dbos-transact-golang","normalized_address_key":"github.com/dbos-inc/dbos-transact-golang","url_host":"github.com","owner_repo":"dbos-inc/dbos-transact-golang"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics","professional_deliverable"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - З