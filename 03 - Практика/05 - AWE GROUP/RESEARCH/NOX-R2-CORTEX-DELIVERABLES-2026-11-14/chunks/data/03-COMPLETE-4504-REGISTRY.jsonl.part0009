{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2614","origin":{"collection":"Радар","original_row_number":2614,"raw_json_pointer":"/2613"},"raw":{"description":"SagerNet/sing-box — Sing-box — универсальная платформа прокси, которая упрощает работу с сетевыми запросами и обеспечивает надежное соединение. Она поддерживает множество протоколов и легко настраивается, что делает её идеальным инструментом для разработчиков и системных администраторов. Sing-box позволяет эффективно управлять трафиком и обеспечивает безопасность данных, что особенно важно в современных условиях. — ❤","link":"https://github.com/SagerNet/sing-box"},"raw_record_json":"{\"description\":\"SagerNet/sing-box — Sing-box — универсальная платформа прокси, которая упрощает работу с сетевыми запросами и обеспечивает надежное соединение. Она поддерживает множество протоколов и легко настраивается, что делает её идеальным инструментом для разработчиков и системных администраторов. Sing-box позволяет эффективно управлять трафиком и обеспечивает безопасность данных, что особенно важно в современных условиях. — ❤\",\"link\":\"https://github.com/SagerNet/sing-box\"}","identity":{"raw_url":"https://github.com/SagerNet/sing-box","normalized_exact_url":"https://github.com/sagernet/sing-box","normalized_address_key":"github.com/sagernet/sing-box","url_host":"github.com","owner_repo":"SagerNet/sing-box"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2614.md","card_sha256":"bcd16263e902a5f39634ece095c238fc41fde79e7747f9e837e53e919cbc9476","exact_candidate_