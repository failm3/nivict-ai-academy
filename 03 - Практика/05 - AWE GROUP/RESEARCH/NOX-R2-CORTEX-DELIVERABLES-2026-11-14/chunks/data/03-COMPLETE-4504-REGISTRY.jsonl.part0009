{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2383","origin":{"collection":"Радар","original_row_number":2383,"raw_json_pointer":"/2382"},"raw":{"description":"sgl-project/SpecForge — SpecForge упрощает процесс обучения моделей спекулятивного декодирования и их интеграции с SGLang для развертывания. Платформа предоставляет инструменты для эффективного тренинга и трансформации моделей, обеспечивая плавный переход от разработки к эксплуатации. Специализированные функции позволяют оптимизировать работу с данными и улучшить производительность моделей. — ❤","link":"https://github.com/sgl-project/SpecForge"},"raw_record_json":"{\"description\":\"sgl-project/SpecForge — SpecForge упрощает процесс обучения моделей спекулятивного декодирования и их интеграции с SGLang для развертывания. Платформа предоставляет инструменты для эффективного тренинга и трансформации моделей, обеспечивая плавный переход от разработки к эксплуатации. Специализированные функции позволяют оптимизировать работу с данными и улучшить производительность моделей. — ❤\",\"link\":\"https://github.com/sgl-project/SpecForge\"}","identity":{"raw_url":"https://github.com/sgl-project/SpecForge","normalized_exact_url":"https://github.com/sgl-project/specforge","normalized_address_key":"github.com/sgl-project/specforge","url_host":"github.com","owner_repo":"sgl-project/SpecForge"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence","quality_evaluation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Обучение и оценка моделей","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Обучение-и-оценка-моделеи/Радар-2383.md","card_sha256":"b9d43f9bc02ff1128eae3a8861422de8f6d4719eba9d6aa4dc0e4cf92d124722","exact_candi