{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2556","origin":{"collection":"Радар","original_row_number":2556,"raw_json_pointer":"/2555"},"raw":{"description":"open-telemetry/opentelemetry-collector — OpenTelemetry Collector — это мощный инструмент для сбора, обработки и передачи телеметрических данных, таких как метрики, логи и трассировки. Он поддерживает различные источники и приемники данных, что позволяет легко интегрировать его в существующие системы мониторинга. Collector обеспечивает гибкость и масштабируемость, позволяя пользователям настраивать обработку данных под свои нужды.","link":"https://github.com/open-telemetry/opentelemetry-collector"},"raw_record_json":"{\"description\":\"open-telemetry/opentelemetry-collector — OpenTelemetry Collector — это мощный инструмент для сбора, обработки и передачи телеметрических данных, таких как метрики, логи и трассировки. Он поддерживает различные источники и приемники данных, что позволяет легко интегрировать его в существующие системы мониторинга. Collector обеспечивает гибкость и масштабируемость, позволяя пользователям настраивать обработку данных под свои нужды.\",\"link\":\"https://github.com/open-telemetry/opentelemetry-collector\"}","identity":{"raw_url":"https://github.com/open-telemetry/opentelemetry-collector","normalized_exact_url":"https://github.com/open-telemetry/opentelemetry-collector","normalized_address_key":"github.com/open-telemetry/opentelemetry-collector","url_host":"github.com","owner_repo":"open-telemetry/opentelemetry-collector"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topi