{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2461","origin":{"collection":"Радар","original_row_number":2461,"raw_json_pointer":"/2460"},"raw":{"description":"BandarLabs/gitpodcast — Gitpodcast превращает любой git-репозиторий в увлекательный подкаст. Инструмент автоматически генерирует аудиофайлы, основываясь на содержимом репозитория, включая коммиты и документацию. Пользователи могут легко делиться знаниями и идеями, создавая аудиоконтент для своей аудитории. Проект предоставляет возможность сделать технические материалы более доступными и интересными для прослушивания. — 🔥","link":"https://github.com/BandarLabs/gitpodcast"},"raw_record_json":"{\"description\":\"BandarLabs/gitpodcast — Gitpodcast превращает любой git-репозиторий в увлекательный подкаст. Инструмент автоматически генерирует аудиофайлы, основываясь на содержимом репозитория, включая коммиты и документацию. Пользователи могут легко делиться знаниями и идеями, создавая аудиоконтент для своей аудитории. Проект предоставляет возможность сделать технические материалы более доступными и интересными для прослушивания. — 🔥\",\"link\":\"https://github.com/BandarLabs/gitpodcast\"}","identity":{"raw_url":"https://github.com/BandarLabs/gitpodcast","normalized_exact_url":"https://github.com/bandarlabs/gitpodcast","normalized_address_key":"github.com/bandarlabs/gitpodcast","url_host":"github.com","owner_repo":"BandarLabs/gitpodcast"},"classification":{"semantic_class":"documentation","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable"],"contours":["B_KNOWLEDGE_COMPETENCE","A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-2461.md","card_sha256":"6de19a0db30f9bd64011c0f