{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2442","origin":{"collection":"Радар","original_row_number":2442,"raw_json_pointer":"/2441"},"raw":{"description":"woheller69/whisperIME — whisperIME — это редактор ввода на платформе Android, разработанный на основе технологии Whisper. Он обеспечивает удобный и интуитивно понятный интерфейс для ввода текста, поддерживая различные языки и режимы ввода. whisperIME интегрирует функции предсказания текста и автозамены, что делает процесс ввода более эффективным. — ❤","link":"https://github.com/woheller69/whisperIME"},"raw_record_json":"{\"description\":\"woheller69/whisperIME — whisperIME — это редактор ввода на платформе Android, разработанный на основе технологии Whisper. Он обеспечивает удобный и интуитивно понятный интерфейс для ввода текста, поддерживая различные языки и режимы ввода. whisperIME интегрирует функции предсказания текста и автозамены, что делает процесс ввода более эффективным. — ❤\",\"link\":\"https://github.com/woheller69/whisperIME\"}","identity":{"raw_url":"https://github.com/woheller69/whisperIME","normalized_exact_url":"https://github.com/woheller69/whisperime","normalized_address_key":"github.com/woheller69/whisperime","url_host":"github.com","owner_repo":"woheller69/whisperIME"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-2442.md","card_sha256":"262a5551711a2840395a5018609ea11ad5a2e0a353b6981df1d9a6991a00747b","exact_candidate_group_id":"DUP_a38c8191e24649ee","exact_candidate_members":["Радар-2442"],"address_candidate_group_id":"DUP_7bf3bde