{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2533","origin":{"collection":"Радар","original_row_number":2533,"raw_json_pointer":"/2532"},"raw":{"description":"rari-build/rari — Rari — это высокопроизводительная инфраструктура для рендеринга компонентов React, основанная на Rust. Она обеспечивает в 12 раз меньшую задержку P99 и в 10,5 раз большую пропускную способность по сравнению с Next.js, при этом не требует сложной настройки и поддерживает универсальный NPM. Идеальный выбор для разработчиков, стремящихся к максимальной производительности и простоте в использовании.","link":"https://github.com/rari-build/rari"},"raw_record_json":"{\"description\":\"rari-build/rari — Rari — это высокопроизводительная инфраструктура для рендеринга компонентов React, основанная на Rust. Она обеспечивает в 12 раз меньшую задержку P99 и в 10,5 раз большую пропускную способность по сравнению с Next.js, при этом не требует сложной настройки и поддерживает универсальный NPM. Идеальный выбор для разработчиков, стремящихся к максимальной производительности и простоте в использовании.\",\"link\":\"https://github.com/rari-build/rari\"}","identity":{"raw_url":"https://github.com/rari-build/rari","normalized_exact_url":"https://github.com/rari-build/rari","normalized_address_key":"github.com/rari-build/rari","url_host":"github.com","owner_repo":"rari-build/rari"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-2533.md","card_sha256":"702b87eecc0ff315b98adb255010f1fefad6bd92520389e9e8ae1479e9acf261","exact_candidate_group_id":"DUP_2f621127debddc10","