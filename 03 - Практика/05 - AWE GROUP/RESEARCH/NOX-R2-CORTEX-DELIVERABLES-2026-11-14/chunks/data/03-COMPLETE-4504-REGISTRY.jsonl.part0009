{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2353","origin":{"collection":"Радар","original_row_number":2353,"raw_json_pointer":"/2352"},"raw":{"description":"voicekit-team/T-one — T-one представляет собой высокопроизводительный потоковый ASR-пайплайн для русского языка, ориентированный на телекоммуникационную сферу. Он обеспечивает точное распознавание речи в реальном времени, что делает его идеальным решением для обработки телефонных звонков и голосовых команд.","link":"https://github.com/voicekit-team/T-one"},"raw_record_json":"{\"description\":\"voicekit-team/T-one — T-one представляет собой высокопроизводительный потоковый ASR-пайплайн для русского языка, ориентированный на телекоммуникационную сферу. Он обеспечивает точное распознавание речи в реальном времени, что делает его идеальным решением для обработки телефонных звонков и голосовых команд.\",\"link\":\"https://github.com/voicekit-team/T-one\"}","identity":{"raw_url":"https://github.com/voicekit-team/T-one","normalized_exact_url":"https://github.com/voicekit-team/t-one","normalized_address_key":"github.com/voicekit-team/t-one","url_host":"github.com","owner_repo":"voicekit-team/T-one"},"classification":{"semantic_class":"workflow","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-2353.md","card_sha256":"54c68922c7a8ac3cb1c4ddb5123bbc40973b8ec20324b12b0500ecfd42418dbe","exact_candidate_group_id":"DUP_aa079c96c99963b3","exact_candidate_members":["Радар-2353"],"address_candidate_group_id":"DUP_c53cd942a7f2eb51","address_candidate_members":["Радар-2353"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTED","ver