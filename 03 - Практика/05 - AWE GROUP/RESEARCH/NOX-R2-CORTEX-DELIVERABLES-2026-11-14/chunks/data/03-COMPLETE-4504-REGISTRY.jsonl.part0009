{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2605","origin":{"collection":"Радар","original_row_number":2605,"raw_json_pointer":"/2604"},"raw":{"description":"Helmi/claude-simone — «claude-simone» — это инновационная структура управления проектами, созданная для упрощения разработки с использованием Claude Code. Она сочетает в себе лучшие практики управления и современные подходы к интеграции искусственного интеллекта, позволяя командам эффективно планировать, отслеживать и реализовывать проекты. — ❤","link":"https://github.com/Helmi/claude-simone"},"raw_record_json":"{\"description\":\"Helmi/claude-simone — «claude-simone» — это инновационная структура управления проектами, созданная для упрощения разработки с использованием Claude Code. Она сочетает в себе лучшие практики управления и современные подходы к интеграции искусственного интеллекта, позволяя командам эффективно планировать, отслеживать и реализовывать проекты. — ❤\",\"link\":\"https://github.com/Helmi/claude-simone\"}","identity":{"raw_url":"https://github.com/Helmi/claude-simone","normalized_exact_url":"https://github.com/helmi/claude-simone","normalized_address_key":"github.com/helmi/claude-simone","url_host":"github.com","owner_repo":"Helmi/claude-simone"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2605.md","card_sha256":"7c22f60418592a044d5690e357457e43cbea32edce2d35bc271b57f409b1b683","exact_candidate_group_id":"DUP_380d64c64f3f87f6","exact_candidate_members":["Радар-2605"],"address_candidate_group_id":"DUP_8dd83d565e39b741