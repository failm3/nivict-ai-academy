{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2451","origin":{"collection":"Радар","original_row_number":2451,"raw_json_pointer":"/2450"},"raw":{"description":"BytexGrid/NeatShift — NeatShift — это современный инструмент для организации файлов в Windows, который поддерживает символические ссылки. Он позволяет пользователям эффективно управлять файлами, упрощая процесс их перемещения и организации. Благодаря интуитивно понятному интерфейсу и мощным функциям, NeatShift помогает оптимизировать рабочее пространство и повысить продуктивность. — ⚡","link":"https://github.com/BytexGrid/NeatShift"},"raw_record_json":"{\"description\":\"BytexGrid/NeatShift — NeatShift — это современный инструмент для организации файлов в Windows, который поддерживает символические ссылки. Он позволяет пользователям эффективно управлять файлами, упрощая процесс их перемещения и организации. Благодаря интуитивно понятному интерфейсу и мощным функциям, NeatShift помогает оптимизировать рабочее пространство и повысить продуктивность. — ⚡\",\"link\":\"https://github.com/BytexGrid/NeatShift\"}","identity":{"raw_url":"https://github.com/BytexGrid/NeatShift","normalized_exact_url":"https://github.com/bytexgrid/neatshift","normalized_address_key":"github.com/bytexgrid/neatshift","url_host":"github.com","owner_repo":"BytexGrid/NeatShift"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Продуктивность и приложения","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Продуктивность-и-приложения/Радар-2451.md","card_sha256":"23483f4b278a04cedaad3fbebf60f079daef865faa533a1d742fa15c8584a33e","exact_candidate_group_id":"DUP_92f06d048b556b92","exact_candidate_membe