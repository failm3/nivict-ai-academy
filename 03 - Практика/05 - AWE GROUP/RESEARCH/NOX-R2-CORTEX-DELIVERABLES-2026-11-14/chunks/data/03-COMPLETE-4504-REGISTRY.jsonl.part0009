{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2583","origin":{"collection":"Радар","original_row_number":2583,"raw_json_pointer":"/2582"},"raw":{"description":"abbodi1406/ConsumerESU — ConsumerESU — это инструмент для регистрации пользователей в программе Extended Security Updates (ESU) для Windows 10. Он позволяет обычным пользователям получать обновления безопасности после окончания основной поддержки операционной системы. С помощью этого решения вы сможете продлить срок службы вашей системы и защитить свои данные от уязвимостей. — 👍","link":"https://github.com/abbodi1406/ConsumerESU"},"raw_record_json":"{\"description\":\"abbodi1406/ConsumerESU — ConsumerESU — это инструмент для регистрации пользователей в программе Extended Security Updates (ESU) для Windows 10. Он позволяет обычным пользователям получать обновления безопасности после окончания основной поддержки операционной системы. С помощью этого решения вы сможете продлить срок службы вашей системы и защитить свои данные от уязвимостей. — 👍\",\"link\":\"https://github.com/abbodi1406/ConsumerESU\"}","identity":{"raw_url":"https://github.com/abbodi1406/ConsumerESU","normalized_exact_url":"https://github.com/abbodi1406/consumeresu","normalized_address_key":"github.com/abbodi1406/consumeresu","url_host":"github.com","owner_repo":"abbodi1406/ConsumerESU"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2583.md","card_sha256":"3d3b4ba52097df541926637e386637e2acac341df537c8d00076ebd09c81dd9a","exact_candidate_group_id":"DUP_8074f2b998f88169","exact_candi