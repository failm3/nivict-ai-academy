{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2291","origin":{"collection":"Радар","original_row_number":2291,"raw_json_pointer":"/2290"},"raw":{"description":"QwenLM/ParScale — ParScale исследует параллельные законы масштабирования для языковых моделей, выходя за рамки традиционных подходов к увеличению параметров и времени вывода. Проект предлагает новые методы и алгоритмы, позволяющие эффективно масштабировать модели, улучшая их производительность и адаптивность. — 🔥","link":"https://github.com/QwenLM/ParScale"},"raw_record_json":"{\"description\":\"QwenLM/ParScale — ParScale исследует параллельные законы масштабирования для языковых моделей, выходя за рамки традиционных подходов к увеличению параметров и времени вывода. Проект предлагает новые методы и алгоритмы, позволяющие эффективно масштабировать модели, улучшая их производительность и адаптивность. — 🔥\",\"link\":\"https://github.com/QwenLM/ParScale\"}","identity":{"raw_url":"https://github.com/QwenLM/ParScale","normalized_exact_url":"https://github.com/qwenlm/parscale","normalized_address_key":"github.com/qwenlm/parscale","url_host":"github.com","owner_repo":"QwenLM/ParScale"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-2291.md","card_sha256":"7a332272caa7a64135ca2e69404d6ebee9eed44fc1a0a7347f4a8321a2daa8c1","exact_candidate_group_id":"DUP_9e20eaa1fa5d429c","exact_candidate_members":["Радар-2291"],"address_candidate_group_id":"DUP_6a84187f08aa3ed0","address_candidate_members":["Радар-2291"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVETTED","verdict":