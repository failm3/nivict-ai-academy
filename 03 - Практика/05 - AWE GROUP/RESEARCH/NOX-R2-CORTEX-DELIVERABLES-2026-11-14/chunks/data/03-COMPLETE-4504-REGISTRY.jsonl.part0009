{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2501","origin":{"collection":"Радар","original_row_number":2501,"raw_json_pointer":"/2500"},"raw":{"description":"Snapchat/Valdi — Valdi — кроссплатформенный UI-фреймворк, который обеспечивает нативную производительность и при этом не замедляет разработку. Он позволяет создавать интерфейсы, которые выглядят и работают как родные приложения на разных платформах. Благодаря простоте использования и высокой скорости разработки, Valdi идеально подходит для разработчиков, стремящихся к качеству и эффективности.","link":"https://github.com/Snapchat/Valdi"},"raw_record_json":"{\"description\":\"Snapchat/Valdi — Valdi — кроссплатформенный UI-фреймворк, который обеспечивает нативную производительность и при этом не замедляет разработку. Он позволяет создавать интерфейсы, которые выглядят и работают как родные приложения на разных платформах. Благодаря простоте использования и высокой скорости разработки, Valdi идеально подходит для разработчиков, стремящихся к качеству и эффективности.\",\"link\":\"https://github.com/Snapchat/Valdi\"}","identity":{"raw_url":"https://github.com/Snapchat/Valdi","normalized_exact_url":"https://github.com/snapchat/valdi","normalized_address_key":"github.com/snapchat/valdi","url_host":"github.com","owner_repo":"Snapchat/Valdi"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-2501.md","card_sha256":"e2378791a659869373cf0c33703015f62a51bb996ee61b54fb73085c5f37bed5","exact_candidate_group_id":"DUP_98318a4e9b17bf88","exact_candida