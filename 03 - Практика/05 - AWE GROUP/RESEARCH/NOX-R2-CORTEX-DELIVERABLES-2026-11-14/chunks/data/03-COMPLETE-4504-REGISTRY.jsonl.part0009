{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2396","origin":{"collection":"Радар","original_row_number":2396,"raw_json_pointer":"/2395"},"raw":{"description":"sansan0/TrendRadar — TrendRadar — это мощный инструмент для мониторинга и анализа актуальных новостей и трендов с использованием искусственного интеллекта. Он агрегирует данные с 35 платформ, включая популярные социальные сети и новостные ресурсы, обеспечивая интеллектуальную фильтрацию и автоматическую рассылку.","link":"https://github.com/sansan0/TrendRadar"},"raw_record_json":"{\"description\":\"sansan0/TrendRadar — TrendRadar — это мощный инструмент для мониторинга и анализа актуальных новостей и трендов с использованием искусственного интеллекта. Он агрегирует данные с 35 платформ, включая популярные социальные сети и новостные ресурсы, обеспечивая интеллектуальную фильтрацию и автоматическую рассылку.\",\"link\":\"https://github.com/sansan0/TrendRadar\"}","identity":{"raw_url":"https://github.com/sansan0/TrendRadar","normalized_exact_url":"https://github.com/sansan0/trendradar","normalized_address_key":"github.com/sansan0/trendradar","url_host":"github.com","owner_repo":"sansan0/TrendRadar"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2396.md","card_sha256":"7fb295c747c0a1d819f9e7f6a96e4ede7fe274f649dc0e3f66402b427aee24a1","exact_candidate_group_id":"DUP_91c778a5ef73dc31","exact_candidate_members":["Радар-2396"],"address_candidate_group_id":"DUP_ff4764fb3fed869b","address_candidate_members":["Радар-2396"]},"status":{"maturity