{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2548","origin":{"collection":"Радар","original_row_number":2548,"raw_json_pointer":"/2547"},"raw":{"description":"spipm/Depixelization_poc — Depixelization_poc предлагает инновационный подход к восстановлению текста из пикселизированных скриншотов. Используя современные алгоритмы обработки изображений, проект демонстрирует, как можно извлечь скрытую информацию, превращая нечеткие изображения в читаемый текст. Это полезный инструмент для тех, кто сталкивается с проблемами распознавания текста на низкокачественных изображениях. — ❤","link":"https://github.com/spipm/Depixelization_poc"},"raw_record_json":"{\"description\":\"spipm/Depixelization_poc — Depixelization_poc предлагает инновационный подход к восстановлению текста из пикселизированных скриншотов. Используя современные алгоритмы обработки изображений, проект демонстрирует, как можно извлечь скрытую информацию, превращая нечеткие изображения в читаемый текст. Это полезный инструмент для тех, кто сталкивается с проблемами распознавания текста на низкокачественных изображениях. — ❤\",\"link\":\"https://github.com/spipm/Depixelization_poc\"}","identity":{"raw_url":"https://github.com/spipm/Depixelization_poc","normalized_exact_url":"https://github.com/spipm/depixelization_poc","normalized_address_key":"github.com/spipm/depixelization_poc","url_host":"github.com","owner_repo":"spipm/Depixelization_poc"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Изображения и графика","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Изображения-и-графика/Радар-2548.md","card_sha256":"93714900ea1434