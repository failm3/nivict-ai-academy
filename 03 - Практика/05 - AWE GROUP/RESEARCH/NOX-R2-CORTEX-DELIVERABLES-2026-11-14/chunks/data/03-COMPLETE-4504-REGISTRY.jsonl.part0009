{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2591","origin":{"collection":"Радар","original_row_number":2591,"raw_json_pointer":"/2590"},"raw":{"description":"KRSHH/Sonosano — Sonosano — это инновационный P2P плеер для музыки, который позволяет пользователям обмениваться и слушать песни напрямую друг с другом. Система обеспечивает высокое качество звука и простоту в использовании, создавая уникальный опыт для меломанов. Благодаря децентрализованному подходу, Sonosano делает музыкальный контент доступным без посредников. Откройте для себя мир музыки с Sonosano!","link":"https://github.com/KRSHH/Sonosano"},"raw_record_json":"{\"description\":\"KRSHH/Sonosano — Sonosano — это инновационный P2P плеер для музыки, который позволяет пользователям обмениваться и слушать песни напрямую друг с другом. Система обеспечивает высокое качество звука и простоту в использовании, создавая уникальный опыт для меломанов. Благодаря децентрализованному подходу, Sonosano делает музыкальный контент доступным без посредников. Откройте для себя мир музыки с Sonosano!\",\"link\":\"https://github.com/KRSHH/Sonosano\"}","identity":{"raw_url":"https://github.com/KRSHH/Sonosano","normalized_exact_url":"https://github.com/krshh/sonosano","normalized_address_key":"github.com/krshh/sonosano","url_host":"github.com","owner_repo":"KRSHH/Sonosano"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-2591.md","card_sha256":"e74951911378f36fbd062bc7442d85290c3866b34166c820a34512fe4decc9b3","exact_candidate_group_id":"DUP_cf56ee845c2e295f","exact_candidate_members":["Ра