{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2384","origin":{"collection":"Радар","original_row_number":2384,"raw_json_pointer":"/2383"},"raw":{"description":"AkaliKong/MiniOneRec — MiniOneRec представляет собой минималистичную реализацию системы OneRec, предназначенную для упрощения процесса рекоммендации. Проект фокусируется на создании компактного и эффективного инструмента для обработки данных и генерации рекомендаций. Он включает в себя основные функции, необходимые для работы с пользовательскими предпочтениями и контентом. — 👍","link":"https://github.com/AkaliKong/MiniOneRec"},"raw_record_json":"{\"description\":\"AkaliKong/MiniOneRec — MiniOneRec представляет собой минималистичную реализацию системы OneRec, предназначенную для упрощения процесса рекоммендации. Проект фокусируется на создании компактного и эффективного инструмента для обработки данных и генерации рекомендаций. Он включает в себя основные функции, необходимые для работы с пользовательскими предпочтениями и контентом. — 👍\",\"link\":\"https://github.com/AkaliKong/MiniOneRec\"}","identity":{"raw_url":"https://github.com/AkaliKong/MiniOneRec","normalized_exact_url":"https://github.com/akalikong/minionerec","normalized_address_key":"github.com/akalikong/minionerec","url_host":"github.com","owner_repo":"AkaliKong/MiniOneRec"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2384.md","card_sha256":"a67438825e35014faf7ebb48ac80f0cbfd71e1b4a3fecd5232192c12abc7b981","exact_candidate_group_id":"DUP_be36f00618d830b5","exact_candidate_members