{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2242","origin":{"collection":"Радар","original_row_number":2242,"raw_json_pointer":"/2241"},"raw":{"description":"jcalabro/uscope — μscope — это инструмент для визуализации и анализа данных, который помогает пользователям быстро и эффективно обрабатывать информацию. Он позволяет исследовать сложные наборы данных, выявлять закономерности и представлять результаты в наглядном виде. Удобный интерфейс и мощные функции делают его идеальным решением для исследователей и аналитиков, стремящихся улучшить качество своих выводов.","link":"https://github.com/jcalabro/uscope"},"raw_record_json":"{\"description\":\"jcalabro/uscope — μscope — это инструмент для визуализации и анализа данных, который помогает пользователям быстро и эффективно обрабатывать информацию. Он позволяет исследовать сложные наборы данных, выявлять закономерности и представлять результаты в наглядном виде. Удобный интерфейс и мощные функции делают его идеальным решением для исследователей и аналитиков, стремящихся улучшить качество своих выводов.\",\"link\":\"https://github.com/jcalabro/uscope\"}","identity":{"raw_url":"https://github.com/jcalabro/uscope","normalized_exact_url":"https://github.com/jcalabro/uscope","normalized_address_key":"github.com/jcalabro/uscope","url_host":"github.com","owner_repo":"jcalabro/uscope"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2242.md","card_sha256":"aa5243481d71c2f54164119618b445045a473e848ecafb0cd7bcdb9b029