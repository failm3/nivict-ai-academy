{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2271","origin":{"collection":"Радар","original_row_number":2271,"raw_json_pointer":"/2270"},"raw":{"description":"kohya-ss/musubi-tuner — Musubi-tuner — это инструмент для настройки музыкальных инструментов, который упрощает процесс достижения идеального звучания. Он позволяет пользователям точно определять высоту звука и настраивать инструменты с учетом индивидуальных предпочтений. Программа поддерживает различные типы инструментов и предлагает интуитивно понятный интерфейс, что делает её доступной для музыкантов любого уровня. — ⚡","link":"https://github.com/kohya-ss/musubi-tuner"},"raw_record_json":"{\"description\":\"kohya-ss/musubi-tuner — Musubi-tuner — это инструмент для настройки музыкальных инструментов, который упрощает процесс достижения идеального звучания. Он позволяет пользователям точно определять высоту звука и настраивать инструменты с учетом индивидуальных предпочтений. Программа поддерживает различные типы инструментов и предлагает интуитивно понятный интерфейс, что делает её доступной для музыкантов любого уровня. — ⚡\",\"link\":\"https://github.com/kohya-ss/musubi-tuner\"}","identity":{"raw_url":"https://github.com/kohya-ss/musubi-tuner","normalized_exact_url":"https://github.com/kohya-ss/musubi-tuner","normalized_address_key":"github.com/kohya-ss/musubi-tuner","url_host":"github.com","owner_repo":"kohya-ss/musubi-tuner"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-2271.md","card_sha256":"15ee8827e774b02581d0f9363975efab44565f985f471addb3f226f93b7cfa0a","exact_candidate