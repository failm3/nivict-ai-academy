{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2523","origin":{"collection":"Радар","original_row_number":2523,"raw_json_pointer":"/2522"},"raw":{"description":"OpenBMB/AppCopilot — AppCopilot — это универсальный и высокоточный мобильный агент, который использует мультимодальные базовые модели для эффективного выполнения задач. Он способен анализировать и обрабатывать информацию из различных источников, обеспечивая долгосрочные результаты и высокую производительность.","link":"https://github.com/OpenBMB/AppCopilot"},"raw_record_json":"{\"description\":\"OpenBMB/AppCopilot — AppCopilot — это универсальный и высокоточный мобильный агент, который использует мультимодальные базовые модели для эффективного выполнения задач. Он способен анализировать и обрабатывать информацию из различных источников, обеспечивая долгосрочные результаты и высокую производительность.\",\"link\":\"https://github.com/OpenBMB/AppCopilot\"}","identity":{"raw_url":"https://github.com/OpenBMB/AppCopilot","normalized_exact_url":"https://github.com/openbmb/appcopilot","normalized_address_key":"github.com/openbmb/appcopilot","url_host":"github.com","owner_repo":"OpenBMB/AppCopilot"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-2523.md","card_sha256":"224a6f53f03938b202939c0a82df247f50c06099b2aa1e123161867f3b5c09b5","exact_candidate_group_id":"DUP_0344e31be1d570af","exact_candidate_members":["Радар-2523"],"address_candidate_group_id":"DUP_895a4be1c46b0b44","address_candidate_members":["Радар-2523"]},"status":{"maturity_stage":"RAW_CAND