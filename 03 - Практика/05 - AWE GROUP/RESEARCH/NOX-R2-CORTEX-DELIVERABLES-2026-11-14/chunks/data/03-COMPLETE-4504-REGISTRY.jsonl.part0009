{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2431","origin":{"collection":"Радар","original_row_number":2431,"raw_json_pointer":"/2430"},"raw":{"description":"tensorgi/TPA — TPA (Tensor ProducT ATTenTion Transformer) представляет собой инновационную архитектуру трансформеров, разработанную для повышения эффективности обработки данных в задачах глубокого обучения. Основное внимание уделяется оптимизации механизма внимания с использованием тензорных произведений, что позволяет значительно уменьшить вычислительные затраты и улучшить производительность модели. — ❤","link":"https://github.com/tensorgi/TPA"},"raw_record_json":"{\"description\":\"tensorgi/TPA — TPA (Tensor ProducT ATTenTion Transformer) представляет собой инновационную архитектуру трансформеров, разработанную для повышения эффективности обработки данных в задачах глубокого обучения. Основное внимание уделяется оптимизации механизма внимания с использованием тензорных произведений, что позволяет значительно уменьшить вычислительные затраты и улучшить производительность модели. — ❤\",\"link\":\"https://github.com/tensorgi/TPA\"}","identity":{"raw_url":"https://github.com/tensorgi/TPA","normalized_exact_url":"https://github.com/tensorgi/tpa","normalized_address_key":"github.com/tensorgi/tpa","url_host":"github.com","owner_repo":"tensorgi/TPA"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-2431.md","card_sha256":"1f53d839601baa89c5404f57197c0092a6fdd3b404788ef1f96b27370ba866ed","exact_candidate_group_id":"DUP_a87c8cf659a65e95","exact_candidate_members"