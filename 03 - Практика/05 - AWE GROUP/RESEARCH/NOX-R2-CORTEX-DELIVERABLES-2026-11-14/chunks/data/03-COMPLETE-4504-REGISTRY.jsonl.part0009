{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2273","origin":{"collection":"Радар","original_row_number":2273,"raw_json_pointer":"/2272"},"raw":{"description":"facebook/pyrefly — Pyrefly — это быстрый инструмент для проверки типов и сервер языка Python, который помогает разработчикам находить ошибки на ранних стадиях. Он обеспечивает статический анализ кода, позволяя улучшить качество и надежность программного обеспечения. С помощью Pyrefly можно легко интегрировать проверку типов в рабочий процесс, что ускоряет разработку и упрощает отладку. — 🔥","link":"https://github.com/facebook/pyrefly"},"raw_record_json":"{\"description\":\"facebook/pyrefly — Pyrefly — это быстрый инструмент для проверки типов и сервер языка Python, который помогает разработчикам находить ошибки на ранних стадиях. Он обеспечивает статический анализ кода, позволяя улучшить качество и надежность программного обеспечения. С помощью Pyrefly можно легко интегрировать проверку типов в рабочий процесс, что ускоряет разработку и упрощает отладку. — 🔥\",\"link\":\"https://github.com/facebook/pyrefly\"}","identity":{"raw_url":"https://github.com/facebook/pyrefly","normalized_exact_url":"https://github.com/facebook/pyrefly","normalized_address_key":"github.com/facebook/pyrefly","url_host":"github.com","owner_repo":"facebook/pyrefly"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - DevOps и хостинг","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---DevOps-и-хостинг/Радар-2273.md","card_sha256":"386c2b25118b9ee16f46d4114f8f0e9a8826c72ea7967f5c0485d32c29d63169","exact_candid