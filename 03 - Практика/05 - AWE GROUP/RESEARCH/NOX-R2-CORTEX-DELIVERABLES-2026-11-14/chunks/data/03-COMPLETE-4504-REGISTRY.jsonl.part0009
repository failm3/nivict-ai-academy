{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2295","origin":{"collection":"Радар","original_row_number":2295,"raw_json_pointer":"/2294"},"raw":{"description":"Maciek-roboblog/Claude-Code-Usage-Monitor — Claude-Code-Usage-Monitor позволяет отслеживать использование кода в реальном времени, предоставляя пользователям прогнозы и предупреждения о возможных проблемах. Этот инструмент помогает разработчикам и командам контролировать эффективность работы, выявлять узкие места и оптимизировать процессы. — ❤","link":"https://github.com/Maciek-roboblog/Claude-Code-Usage-Monitor"},"raw_record_json":"{\"description\":\"Maciek-roboblog/Claude-Code-Usage-Monitor — Claude-Code-Usage-Monitor позволяет отслеживать использование кода в реальном времени, предоставляя пользователям прогнозы и предупреждения о возможных проблемах. Этот инструмент помогает разработчикам и командам контролировать эффективность работы, выявлять узкие места и оптимизировать процессы. — ❤\",\"link\":\"https://github.com/Maciek-roboblog/Claude-Code-Usage-Monitor\"}","identity":{"raw_url":"https://github.com/Maciek-roboblog/Claude-Code-Usage-Monitor","normalized_exact_url":"https://github.com/maciek-roboblog/claude-code-usage-monitor","normalized_address_key":"github.com/maciek-roboblog/claude-code-usage-monitor","url_host":"github.com","owner_repo":"Maciek-roboblog/Claude-Code-Usage-Monitor"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["A_TOOL_CAPABILITY","D_META_INTELLIGENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2295.md","card_sha256":"767904cf8a181e4cf4a5e92578b234389c678d56064f2c29b3