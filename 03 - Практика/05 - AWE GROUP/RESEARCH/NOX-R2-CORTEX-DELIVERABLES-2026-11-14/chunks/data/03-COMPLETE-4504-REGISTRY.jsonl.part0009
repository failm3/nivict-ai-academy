{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2443","origin":{"collection":"Радар","original_row_number":2443,"raw_json_pointer":"/2442"},"raw":{"description":"NativeMindBrowser/NativeMindExtension — NativeMindExtension — это полностью приватный, открытый и работающий на устройстве AI-ассистент. Он обеспечивает безопасное взаимодействие с пользователем, не передавая данные на сторонние серверы. Решение ориентировано на защиту конфиденциальности и автономность, позволяя выполнять задачи без необходимости подключения к интернету. — ❤","link":"https://github.com/NativeMindBrowser/NativeMindExtension"},"raw_record_json":"{\"description\":\"NativeMindBrowser/NativeMindExtension — NativeMindExtension — это полностью приватный, открытый и работающий на устройстве AI-ассистент. Он обеспечивает безопасное взаимодействие с пользователем, не передавая данные на сторонние серверы. Решение ориентировано на защиту конфиденциальности и автономность, позволяя выполнять задачи без необходимости подключения к интернету. — ❤\",\"link\":\"https://github.com/NativeMindBrowser/NativeMindExtension\"}","identity":{"raw_url":"https://github.com/NativeMindBrowser/NativeMindExtension","normalized_exact_url":"https://github.com/nativemindbrowser/nativemindextension","normalized_address_key":"github.com/nativemindbrowser/nativemindextension","url_host":"github.com","owner_repo":"NativeMindBrowser/NativeMindExtension"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance","execution_automation"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-2443.md","card_sha256":"5e1fe315bc9698cbf69d304