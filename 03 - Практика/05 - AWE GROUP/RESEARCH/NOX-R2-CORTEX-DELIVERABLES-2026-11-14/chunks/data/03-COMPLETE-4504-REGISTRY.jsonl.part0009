{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2595","origin":{"collection":"Радар","original_row_number":2595,"raw_json_pointer":"/2594"},"raw":{"description":"minio/minio — MinIO — это высокопроизводительное хранилище объектов, совместимое с S3, которое идеально подходит для облачных и локальных решений. Оно открыто и распространяется под лицензией GNU AGPLv3. MinIO обеспечивает быструю и надежную работу с данными, что делает его отличным выбором для разработчиков и компаний, стремящихся к эффективному управлению хранилищем.","link":"https://github.com/minio/minio"},"raw_record_json":"{\"description\":\"minio/minio — MinIO — это высокопроизводительное хранилище объектов, совместимое с S3, которое идеально подходит для облачных и локальных решений. Оно открыто и распространяется под лицензией GNU AGPLv3. MinIO обеспечивает быструю и надежную работу с данными, что делает его отличным выбором для разработчиков и компаний, стремящихся к эффективному управлению хранилищем.\",\"link\":\"https://github.com/minio/minio\"}","identity":{"raw_url":"https://github.com/minio/minio","normalized_exact_url":"https://github.com/minio/minio","normalized_address_key":"github.com/minio/minio","url_host":"github.com","owner_repo":"minio/minio"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2595.md","card_sha256":"920ef5ea4cb485c1e335aa0038ae452ab445b35bf0c8f72ef5a657e7154e5198","exact_candidate_group_id":"DUP_67ceea7e033e8ad3","exact_candidate_members":["Радар-2595"],"address_candidate_group_id":"DUP_f23e