{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2311","origin":{"collection":"Радар","original_row_number":2311,"raw_json_pointer":"/2310"},"raw":{"description":"TeXlyre/texlyre — Texlyre — это веб-редактор для LaTeX и Typst, который ориентирован на локальную работу. Он поддерживает совместное редактирование в реальном времени и обеспечивает возможность офлайн-доступа. Удобный интерфейс и мощные функции делают его идеальным инструментом для пользователей, стремящихся к эффективному созданию и редактированию документов. — ❤","link":"https://github.com/TeXlyre/texlyre"},"raw_record_json":"{\"description\":\"TeXlyre/texlyre — Texlyre — это веб-редактор для LaTeX и Typst, который ориентирован на локальную работу. Он поддерживает совместное редактирование в реальном времени и обеспечивает возможность офлайн-доступа. Удобный интерфейс и мощные функции делают его идеальным инструментом для пользователей, стремящихся к эффективному созданию и редактированию документов. — ❤\",\"link\":\"https://github.com/TeXlyre/texlyre\"}","identity":{"raw_url":"https://github.com/TeXlyre/texlyre","normalized_exact_url":"https://github.com/texlyre/texlyre","normalized_address_key":"github.com/texlyre/texlyre","url_host":"github.com","owner_repo":"TeXlyre/texlyre"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion","professional_deliverable"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Требует ручной классификации","historical_confidence":"unclassified","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Требует-ручнои-классификации/Радар-2311.md","card_sha256":"c12d3182020c042578a6ec5210b40fce2f837c4855a1c65458bc8506c88383cb","exact_candidate_group_id":"DUP_99e0b3b70639c33c","exact_candidate_membe