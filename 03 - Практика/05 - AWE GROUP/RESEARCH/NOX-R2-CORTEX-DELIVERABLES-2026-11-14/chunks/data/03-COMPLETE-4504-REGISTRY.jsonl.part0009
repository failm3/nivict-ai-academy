{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2490","origin":{"collection":"Радар","original_row_number":2490,"raw_json_pointer":"/2489"},"raw":{"description":"googleapis/gcloud-mcp — gcloud-mcp — это сервер, который обеспечивает взаимодействие с Google Cloud через Managed Control Plane (MCP). Он упрощает управление ресурсами и автоматизацию процессов в облачной среде. С помощью gcloud-mcp разработчики могут легко развертывать, настраивать и контролировать свои приложения, используя мощные инструменты Google Cloud. — 🔥","link":"https://github.com/googleapis/gcloud-mcp"},"raw_record_json":"{\"description\":\"googleapis/gcloud-mcp — gcloud-mcp — это сервер, который обеспечивает взаимодействие с Google Cloud через Managed Control Plane (MCP). Он упрощает управление ресурсами и автоматизацию процессов в облачной среде. С помощью gcloud-mcp разработчики могут легко развертывать, настраивать и контролировать свои приложения, используя мощные инструменты Google Cloud. — 🔥\",\"link\":\"https://github.com/googleapis/gcloud-mcp\"}","identity":{"raw_url":"https://github.com/googleapis/gcloud-mcp","normalized_exact_url":"https://github.com/googleapis/gcloud-mcp","normalized_address_key":"github.com/googleapis/gcloud-mcp","url_host":"github.com","owner_repo":"googleapis/gcloud-mcp"},"classification":{"semantic_class":"MCP","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-2490.md","card_sha256":"1d0f583a545c87be37d4957563d19d54b7a8e0e4bc162b537f564b46417480ec","exact_candidate_group_id":"DUP_5613f36bc2d0f869","exact_candidate_members":["Радар-2490"],"address_candidate_group_id":"DUP