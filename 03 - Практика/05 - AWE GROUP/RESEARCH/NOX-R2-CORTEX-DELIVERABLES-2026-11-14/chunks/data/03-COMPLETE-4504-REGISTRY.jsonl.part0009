{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-2594","origin":{"collection":"Радар","original_row_number":2594,"raw_json_pointer":"/2593"},"raw":{"description":"deepseek-ai/DeepSeek-OCR — DeepSeek-OCR предлагает инновационное решение для оптического распознавания текста с использованием контекстного сжатия. Этот инструмент позволяет эффективно извлекать информацию из изображений, минимизируя объем данных и сохраняя высокое качество распознавания.","link":"https://github.com/deepseek-ai/DeepSeek-OCR"},"raw_record_json":"{\"description\":\"deepseek-ai/DeepSeek-OCR — DeepSeek-OCR предлагает инновационное решение для оптического распознавания текста с использованием контекстного сжатия. Этот инструмент позволяет эффективно извлекать информацию из изображений, минимизируя объем данных и сохраняя высокое качество распознавания.\",\"link\":\"https://github.com/deepseek-ai/DeepSeek-OCR\"}","identity":{"raw_url":"https://github.com/deepseek-ai/DeepSeek-OCR","normalized_exact_url":"https://github.com/deepseek-ai/deepseek-ocr","normalized_address_key":"github.com/deepseek-ai/deepseek-ocr","url_host":"github.com","owner_repo":"deepseek-ai/DeepSeek-OCR"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["knowledge_ingestion"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE","D_META_INTELLIGENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Модели и инференс","historical_confidence":"medium","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/AI---Модели-и-инференс/Радар-2594.md","card_sha256":"de88f0f59b3d7dfbb5291212b6bbc840533b8d86051f5d8eb1d29b32c1f98f50","exact_candidate_group_id":"DUP_5c4487c45240610a","exact_candidate_members":["Радар-2594"],"address_candidate_group_id":"DUP_57f68ad01d5b6d17","address_candidate_members":["Радар-2594"]},"status":{"maturity_stag