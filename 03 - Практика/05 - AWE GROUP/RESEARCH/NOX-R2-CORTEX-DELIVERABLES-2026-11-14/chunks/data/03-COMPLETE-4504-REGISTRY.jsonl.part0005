{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0744","origin":{"collection":"Радар","original_row_number":744,"raw_json_pointer":"/743"},"raw":{"description":"webtorrent/webtorrent — Торрент-клиент для node.js и браузера. Работает без плагинов и расширений — достаточно подключить JavaScript-файл на страницу. В браузере использует WebRTC для передачи данных между пирами по протоколу BitTorrent. В node.js работает через TCP и UDP как обычный торрент-клиент. — Поддерживает magnet-ссылки, обнаружение пиров через DHT, tracker, LSD и PEP.","link":"https://github.com/webtorrent/webtorrent"},"raw_record_json":"{\"description\":\"webtorrent/webtorrent — Торрент-клиент для node.js и браузера. Работает без плагинов и расширений — достаточно подключить JavaScript-файл на страницу. В браузере использует WebRTC для передачи данных между пирами по протоколу BitTorrent. В node.js работает через TCP и UDP как обычный торрент-клиент. — Поддерживает magnet-ссылки, обнаружение пиров через DHT, tracker, LSD и PEP.\",\"link\":\"https://github.com/webtorrent/webtorrent\"}","identity":{"raw_url":"https://github.com/webtorrent/webtorrent","normalized_exact_url":"https://github.com/webtorrent/webtorrent","normalized_address_key":"github.com/webtorrent/webtorrent","url_host":"github.com","owner_repo":"webtorrent/webtorrent"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-0744.md","card_sha256":"477685a7747353d376dc7e91ee1428ba43a89d07af28085b13126e1d52cd92b3","exact_candidate_group_id":"DUP_d33a89c109c601c8","exact_can