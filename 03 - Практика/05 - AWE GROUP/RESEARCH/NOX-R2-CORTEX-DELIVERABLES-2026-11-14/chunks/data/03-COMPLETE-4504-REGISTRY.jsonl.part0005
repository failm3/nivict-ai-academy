{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0525","origin":{"collection":"Радар","original_row_number":525,"raw_json_pointer":"/524"},"raw":{"description":"erincatto/box3d — 3D-движок для физики в играх, написанный на C17. Реализует обнаружение столкновений, включая непрерывное обнаружение для быстро движущихся объектов, и поддерживает выпуклые оболочки, капсулы, сферы, треугольные сетки и поля высот. К одному телу можно прикрепить несколько форм. Доступны лучевые запросы, запросы перекрытия и система сенсоров. — ❤","link":"https://github.com/erincatto/box3d"},"raw_record_json":"{\"description\":\"erincatto/box3d — 3D-движок для физики в играх, написанный на C17. Реализует обнаружение столкновений, включая непрерывное обнаружение для быстро движущихся объектов, и поддерживает выпуклые оболочки, капсулы, сферы, треугольные сетки и поля высот. К одному телу можно прикрепить несколько форм. Доступны лучевые запросы, запросы перекрытия и система сенсоров. — ❤\",\"link\":\"https://github.com/erincatto/box3d\"}","identity":{"raw_url":"https://github.com/erincatto/box3d","normalized_exact_url":"https://github.com/erincatto/box3d","normalized_address_key":"github.com/erincatto/box3d","url_host":"github.com","owner_repo":"erincatto/box3d"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0525.md","card_sha256":"10902c35f4f34bd2b0de9f3c98b5adb5f1f828532830ae98f6bb9bdc022983f5","exact_candidate_group_id":"DUP_0e3194e0d7b6f44e","exact_candidate_members":["Радар-0525"],"address_candidate_group_id":"DUP_01bd365941609457","address_candi