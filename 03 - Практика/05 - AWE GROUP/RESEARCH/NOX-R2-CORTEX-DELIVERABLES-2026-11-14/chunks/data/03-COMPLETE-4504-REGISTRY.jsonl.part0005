{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0814","origin":{"collection":"Радар","original_row_number":814,"raw_json_pointer":"/813"},"raw":{"description":"blackcandy-org/blackcandy — Self-hosted сервер для стриминга музыки. Разворачивается локально через Docker одной командой — без сложной настройки. По умолчанию использует SQLite, но поддерживает PostgreSQL, если нужна более производительная база данных. — Медиафайлы подключаются через монтирование директории с хоста в контейнер. Есть мобильные приложения для Android и iOS, доступные в магазинах приложений.","link":"https://github.com/blackcandy-org/blackcandy"},"raw_record_json":"{\"description\":\"blackcandy-org/blackcandy — Self-hosted сервер для стриминга музыки. Разворачивается локально через Docker одной командой — без сложной настройки. По умолчанию использует SQLite, но поддерживает PostgreSQL, если нужна более производительная база данных. — Медиафайлы подключаются через монтирование директории с хоста в контейнер. Есть мобильные приложения для Android и iOS, доступные в магазинах приложений.\",\"link\":\"https://github.com/blackcandy-org/blackcandy\"}","identity":{"raw_url":"https://github.com/blackcandy-org/blackcandy","normalized_exact_url":"https://github.com/blackcandy-org/blackcandy","normalized_address_key":"github.com/blackcandy-org/blackcandy","url_host":"github.com","owner_repo":"blackcandy-org/blackcandy"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0814.md","card_sha256":"29906710c20268a498131998946bbafae372311dd2c3d061b06498e8efe4