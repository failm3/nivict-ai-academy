{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0794","origin":{"collection":"Радар","original_row_number":794,"raw_json_pointer":"/793"},"raw":{"description":"sabrogden/Ditto — Расширение стандартного буфера обмена Windows. Каждый раз, когда что-то копируется в буфер, Ditto сохраняет это в локальную базу данных. Позднее можно открыть список всех скопированных элементов и вставить любой из них. — Поддерживает все типы данных, которые можно поместить в буфер обмена: текст, изображения, HTML, пользовательские форматы.","link":"https://github.com/sabrogden/Ditto"},"raw_record_json":"{\"description\":\"sabrogden/Ditto — Расширение стандартного буфера обмена Windows. Каждый раз, когда что-то копируется в буфер, Ditto сохраняет это в локальную базу данных. Позднее можно открыть список всех скопированных элементов и вставить любой из них. — Поддерживает все типы данных, которые можно поместить в буфер обмена: текст, изображения, HTML, пользовательские форматы.\",\"link\":\"https://github.com/sabrogden/Ditto\"}","identity":{"raw_url":"https://github.com/sabrogden/Ditto","normalized_exact_url":"https://github.com/sabrogden/ditto","normalized_address_key":"github.com/sabrogden/ditto","url_host":"github.com","owner_repo":"sabrogden/Ditto"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0794.md","card_sha256":"7a81c5b304384020bf6ad385cf2ca0ada7ddc65c1b4d572c8e63397f3c8721c1","exact_candidate_group_id":"DUP_3d9d3479eba2aa43","exact_candidate_members":["Радар-0794"],"address_candidate_group_id":"DUP_76ecb110f0639d9e",