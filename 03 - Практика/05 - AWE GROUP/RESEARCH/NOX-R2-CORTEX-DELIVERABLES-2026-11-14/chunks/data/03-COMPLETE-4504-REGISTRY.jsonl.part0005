{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0538","origin":{"collection":"Радар","original_row_number":538,"raw_json_pointer":"/537"},"raw":{"description":"kando-menu/kando — Круговое меню для рабочего стола. Kando отображает элементы управления в виде круга вокруг курсора и позволяет запускать приложения, открывать файлы и выполнять горячие клавиши через быстрые жесты мышью, стилусом, касанием или геймпадом. Управление с клавиатуры тоже поддерживается. — Работает на Windows, macOS и Linux.","link":"https://github.com/kando-menu/kando"},"raw_record_json":"{\"description\":\"kando-menu/kando — Круговое меню для рабочего стола. Kando отображает элементы управления в виде круга вокруг курсора и позволяет запускать приложения, открывать файлы и выполнять горячие клавиши через быстрые жесты мышью, стилусом, касанием или геймпадом. Управление с клавиатуры тоже поддерживается. — Работает на Windows, macOS и Linux.\",\"link\":\"https://github.com/kando-menu/kando\"}","identity":{"raw_url":"https://github.com/kando-menu/kando","normalized_exact_url":"https://github.com/kando-menu/kando","normalized_address_key":"github.com/kando-menu/kando","url_host":"github.com","owner_repo":"kando-menu/kando"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["skills_competence"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0538.md","card_sha256":"ea862e54ca8d42077c7284c0700f3f46b788e56d5e42bb66e114b3ab960eaea9","exact_candidate_group_id":"DUP_0bc664089f567d8f","exact_candidate_members":["Радар-0538"],"address_candidate_group_id":"DUP_e2d33b9f14605171","address_candidate_members":["Радар-0538"]},"st