{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0485","origin":{"collection":"Радар","original_row_number":485,"raw_json_pointer":"/484"},"raw":{"description":"fastfetch-cli/fastfetch — Утилита для сбора и отображения системной информации. Показывает данные об операционной системе, железе, окружении и других параметрах системы в терминале. Написана на C с акцентом на производительность и гибкость настройки. — Поддерживает Linux, macOS, Windows 8.1+, Android, FreeBSD, OpenBSD, NetBSD, DragonFly, Haiku и SunOS. Вывод настраивается через конфигурационные файлы.","link":"https://github.com/fastfetch-cli/fastfetch"},"raw_record_json":"{\"description\":\"fastfetch-cli/fastfetch — Утилита для сбора и отображения системной информации. Показывает данные об операционной системе, железе, окружении и других параметрах системы в терминале. Написана на C с акцентом на производительность и гибкость настройки. — Поддерживает Linux, macOS, Windows 8.1+, Android, FreeBSD, OpenBSD, NetBSD, DragonFly, Haiku и SunOS. Вывод настраивается через конфигурационные файлы.\",\"link\":\"https://github.com/fastfetch-cli/fastfetch\"}","identity":{"raw_url":"https://github.com/fastfetch-cli/fastfetch","normalized_exact_url":"https://github.com/fastfetch-cli/fastfetch","normalized_address_key":"github.com/fastfetch-cli/fastfetch","url_host":"github.com","owner_repo":"fastfetch-cli/fastfetch"},"classification":{"semantic_class":"CLI","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","observability_economics"],"contours":["A_TOOL_CAPABILITY","B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Редакторы и CLI","historical_confidence":"high","historical_resource_type":"github_repository","historical_flags":""},"crosswalk":{"card_path":"20 - Записи/Разработка---Редакторы-и-CLI/Радар-0485.md","card_sha256":"bc98453d28901120791849e6d1b2435b0a35799e55e5