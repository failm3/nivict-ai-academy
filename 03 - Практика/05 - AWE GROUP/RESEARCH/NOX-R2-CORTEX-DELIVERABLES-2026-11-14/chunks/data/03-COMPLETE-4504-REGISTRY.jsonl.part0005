{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0534","origin":{"collection":"Радар","original_row_number":534,"raw_json_pointer":"/533"},"raw":{"description":"NativeScript/NativeScript — Фреймворк с открытым исходным кодом для разработки нативных мобильных приложений на TypeScript. Даёт прямой доступ к нативным API iOS, Android и visionOS из JavaScript без промежуточного слоя. Приложение компилируется в нативный код, а не запускается в WebView. — Поддерживает работу с UIKit, SwiftUI, Android View и Jetpack Compose напрямую из TypeScript.","link":"https://github.com/NativeScript/NativeScript"},"raw_record_json":"{\"description\":\"NativeScript/NativeScript — Фреймворк с открытым исходным кодом для разработки нативных мобильных приложений на TypeScript. Даёт прямой доступ к нативным API iOS, Android и visionOS из JavaScript без промежуточного слоя. Приложение компилируется в нативный код, а не запускается в WebView. — Поддерживает работу с UIKit, SwiftUI, Android View и Jetpack Compose напрямую из TypeScript.\",\"link\":\"https://github.com/NativeScript/NativeScript\"}","identity":{"raw_url":"https://github.com/NativeScript/NativeScript","normalized_exact_url":"https://github.com/nativescript/nativescript","normalized_address_key":"github.com/nativescript/nativescript","url_host":"github.com","owner_repo":"NativeScript/NativeScript"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-0534.md","card_sha256":"30699005466f2e7f7e8b96fd815dd27ffd812bbb419099e16afcd4580d233602","exact_candidate_group_id":"DU