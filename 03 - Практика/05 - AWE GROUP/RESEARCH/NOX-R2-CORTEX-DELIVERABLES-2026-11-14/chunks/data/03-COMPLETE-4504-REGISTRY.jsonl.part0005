{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0509","origin":{"collection":"Радар","original_row_number":509,"raw_json_pointer":"/508"},"raw":{"description":"microg/GmsCore — Свободная реализация Google Play Services под лицензией Apache 2.0. Позволяет запускать Android-приложения, которые зависят от Google Play Services, на устройствах, где эти сервисы недоступны — например, на кастомных прошивках без Google. — GmsCore входит в состав проекта microG и выступает заменой проприетарных сервисов Google на уровне фреймворка.","link":"https://github.com/microg/GmsCore"},"raw_record_json":"{\"description\":\"microg/GmsCore — Свободная реализация Google Play Services под лицензией Apache 2.0. Позволяет запускать Android-приложения, которые зависят от Google Play Services, на устройствах, где эти сервисы недоступны — например, на кастомных прошивках без Google. — GmsCore входит в состав проекта microG и выступает заменой проприетарных сервисов Google на уровне фреймворка.\",\"link\":\"https://github.com/microg/GmsCore\"}","identity":{"raw_url":"https://github.com/microg/GmsCore","normalized_exact_url":"https://github.com/microg/gmscore","normalized_address_key":"github.com/microg/gmscore","url_host":"github.com","owner_repo":"microg/GmsCore"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Разработка - Фреймворки и библиотеки","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Разработка---Фреимворки-и-библиотеки/Радар-0509.md","card_sha256":"4b528356728ce0c05a79cedbe1fdf742f3888633f0402c6533693c6ec197ed03","exact_candidate_group_id":"DUP_6a901d58658175d8","exact_candidate_members":["Радар-0509"],"address_candidate