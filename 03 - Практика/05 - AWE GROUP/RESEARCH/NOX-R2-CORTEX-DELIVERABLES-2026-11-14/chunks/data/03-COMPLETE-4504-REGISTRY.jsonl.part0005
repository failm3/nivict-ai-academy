{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0502","origin":{"collection":"Радар","original_row_number":502,"raw_json_pointer":"/501"},"raw":{"description":"DNSCrypt/dnscrypt-proxy — Гибкий DNS-прокси с поддержкой современных протоколов шифрования: DNSCrypt v2, DNS over HTTPS (DoH) через TLS 1.3 и QUIC, Anonymized DNSCrypt и ODoH. Шифрует и аутентифицирует DNS-трафик, скрывает IP-адрес клиента через Tor, SOCKS-прокси или анонимные ретрансляторы. Можно развернуть локально. — 👍","link":"https://github.com/DNSCrypt/dnscrypt-proxy"},"raw_record_json":"{\"description\":\"DNSCrypt/dnscrypt-proxy — Гибкий DNS-прокси с поддержкой современных протоколов шифрования: DNSCrypt v2, DNS over HTTPS (DoH) через TLS 1.3 и QUIC, Anonymized DNSCrypt и ODoH. Шифрует и аутентифицирует DNS-трафик, скрывает IP-адрес клиента через Tor, SOCKS-прокси или анонимные ретрансляторы. Можно развернуть локально. — 👍\",\"link\":\"https://github.com/DNSCrypt/dnscrypt-proxy\"}","identity":{"raw_url":"https://github.com/DNSCrypt/dnscrypt-proxy","normalized_exact_url":"https://github.com/dnscrypt/dnscrypt-proxy","normalized_address_key":"github.com/dnscrypt/dnscrypt-proxy","url_host":"github.com","owner_repo":"DNSCrypt/dnscrypt-proxy"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-0502.md","card_sha256":"8816995e2097df0f4270692cea79c2435a37330bcd5b63875a25d24a142f3f1c","exact_candidate_group_id":"DUP_c0363eabb3b51a02","exact_candidate_members":["Радар-0502"],"address_candidate_group_id":"DUP_c1d26629ef2ce5b5","address_candidate_members