{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0811","origin":{"collection":"Радар","original_row_number":811,"raw_json_pointer":"/810"},"raw":{"description":"ShadowArcanist/netviz — Браузерный инструмент для визуального проектирования сетевых архитектур. На холст добавляются компоненты — серверы, прокси, базы данных — и соединяются стрелками для отображения потоков данных. Компоненты можно группировать по слоям, редактировать через панель инспектора и дублировать. — Поддерживаются пользовательские блоки с собственными иконками, отмена и повтор действий, тёмная и светлая темы.","link":"https://github.com/ShadowArcanist/netviz"},"raw_record_json":"{\"description\":\"ShadowArcanist/netviz — Браузерный инструмент для визуального проектирования сетевых архитектур. На холст добавляются компоненты — серверы, прокси, базы данных — и соединяются стрелками для отображения потоков данных. Компоненты можно группировать по слоям, редактировать через панель инспектора и дублировать. — Поддерживаются пользовательские блоки с собственными иконками, отмена и повтор действий, тёмная и светлая темы.\",\"link\":\"https://github.com/ShadowArcanist/netviz\"}","identity":{"raw_url":"https://github.com/ShadowArcanist/netviz","normalized_exact_url":"https://github.com/shadowarcanist/netviz","normalized_address_key":"github.com/shadowarcanist/netviz","url_host":"github.com","owner_repo":"ShadowArcanist/netviz"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Инфраструктура - Данные и БД","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Инфраструктура---Данные-и-БД/Радар-0811.md","card_sha256":"2239d31ae3f6531523057a9d664f3e33d2cb7d74ea7bd8fbdcc9