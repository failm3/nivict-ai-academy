{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0507","origin":{"collection":"Радар","original_row_number":507,"raw_json_pointer":"/506"},"raw":{"description":"safing/portmaster — Бесплатный application firewall с открытым исходным кодом для Windows и Linux. Перехватывает сетевые пакеты на уровне ядра — через WFP на Windows и nfqueue на Linux. Определяет, какое именно приложение установило соединение, в том числе для Snap, AppImage, скриптов, приложений Windows Store и системных служб вроде svchost.exe. — 👍","link":"https://github.com/safing/portmaster"},"raw_record_json":"{\"description\":\"safing/portmaster — Бесплатный application firewall с открытым исходным кодом для Windows и Linux. Перехватывает сетевые пакеты на уровне ядра — через WFP на Windows и nfqueue на Linux. Определяет, какое именно приложение установило соединение, в том числе для Snap, AppImage, скриптов, приложений Windows Store и системных служб вроде svchost.exe. — 👍\",\"link\":\"https://github.com/safing/portmaster\"}","identity":{"raw_url":"https://github.com/safing/portmaster","normalized_exact_url":"https://github.com/safing/portmaster","normalized_address_key":"github.com/safing/portmaster","url_host":"github.com","owner_repo":"safing/portmaster"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["professional_deliverable"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Системы - ОС и устройства","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Системы---ОС-и-устроиства/Радар-0507.md","card_sha256":"e13d06744d34c61e13111890c8297e53bcae1b406b854836f9986ae69d1d61d6","exact_candidate_group_id":"DUP_5c4f953ffd61bbe2","exact_candidate_members":["Радар-0507"],"address_candidate_group_id":"DUP_8a667103551c5887","address