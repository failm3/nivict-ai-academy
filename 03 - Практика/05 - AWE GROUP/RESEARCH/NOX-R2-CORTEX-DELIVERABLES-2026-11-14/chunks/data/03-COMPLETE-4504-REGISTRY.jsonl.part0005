{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0627","origin":{"collection":"Радар","original_row_number":627,"raw_json_pointer":"/626"},"raw":{"description":"mojs/mojs — JavaScript-библиотека для создания анимационной графики в браузере. Поддерживает декларативный API, который даёт полный контроль над анимацией. Библиотека позиционируется как быстрая, поддерживает retina-дисплеи и построена по модульному принципу. — Включает встроенные компоненты: `html`, `shape`, `swirl`, `burst` и `stagger`. Устанавливается через npm или yarn, подключается через CDN.","link":"https://github.com/mojs/mojs"},"raw_record_json":"{\"description\":\"mojs/mojs — JavaScript-библиотека для создания анимационной графики в браузере. Поддерживает декларативный API, который даёт полный контроль над анимацией. Библиотека позиционируется как быстрая, поддерживает retina-дисплеи и построена по модульному принципу. — Включает встроенные компоненты: `html`, `shape`, `swirl`, `burst` и `stagger`. Устанавливается через npm или yarn, подключается через CDN.\",\"link\":\"https://github.com/mojs/mojs\"}","identity":{"raw_url":"https://github.com/mojs/mojs","normalized_exact_url":"https://github.com/mojs/mojs","normalized_address_key":"github.com/mojs/mojs","url_host":"github.com","owner_repo":"mojs/mojs"},"classification":{"semantic_class":"API","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["A_TOOL_CAPABILITY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0627.md","card_sha256":"0bdd59641650931d05a340ffc7254d6841d56fe53034ddc553d8577c6aa22089","exact_candidate_group_id":"DUP_086cea1094c903c5","exact_candidate_members":["Радар-0627"],"address_candidate_group_id":"DUP_88e2c