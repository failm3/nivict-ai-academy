{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0873","origin":{"collection":"Радар","original_row_number":873,"raw_json_pointer":"/872"},"raw":{"description":"PrivateBin/PrivateBin — Онлайн-сервис для обмена текстом, где сервер физически не может прочитать то, что вы отправили. Шифрование происходит прямо в браузере с помощью 256-битного AES, и на сервер уходит уже зашифрованный текст — ключ остаётся частью ссылки, но не передаётся на сервер. — 👍","link":"https://github.com/PrivateBin/PrivateBin"},"raw_record_json":"{\"description\":\"PrivateBin/PrivateBin — Онлайн-сервис для обмена текстом, где сервер физически не может прочитать то, что вы отправили. Шифрование происходит прямо в браузере с помощью 256-битного AES, и на сервер уходит уже зашифрованный текст — ключ остаётся частью ссылки, но не передаётся на сервер. — 👍\",\"link\":\"https://github.com/PrivateBin/PrivateBin\"}","identity":{"raw_url":"https://github.com/PrivateBin/PrivateBin","normalized_exact_url":"https://github.com/privatebin/privatebin","normalized_address_key":"github.com/privatebin/privatebin","url_host":"github.com","owner_repo":"PrivateBin/PrivateBin"},"classification":{"semantic_class":"service","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-0873.md","card_sha256":"23a2e678e5a6169c6a0accd0561b74dc5e39320090d2ed2900d9a2874ca2bfff","exact_candidate_group_id":"DUP_c3194bd413689800","exact_candidate_members":["Радар-0873"],"address_candidate_group_id":"DUP_d2847466217e5641","address_candidate_members":["Радар-0873"]},"status":{"maturity_stage":"RAW_CANDIDATE","readiness":"UNVET