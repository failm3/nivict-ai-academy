{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0648","origin":{"collection":"Радар","original_row_number":648,"raw_json_pointer":"/647"},"raw":{"description":"aseprite/aseprite — Редактор пиксельной графики и анимированных спрайтов. Работает на Windows, macOS и Linux. Позволяет создавать покадровую анимацию с предпросмотром в реальном времени и режимом onion skinning. Поддерживает цветовые режимы RGBA, Indexed (палитры до 256 цветов) и Grayscale, а также цветовые профили. — Слои и кадры существуют как независимые сущности.","link":"https://github.com/aseprite/aseprite"},"raw_record_json":"{\"description\":\"aseprite/aseprite — Редактор пиксельной графики и анимированных спрайтов. Работает на Windows, macOS и Linux. Позволяет создавать покадровую анимацию с предпросмотром в реальном времени и режимом onion skinning. Поддерживает цветовые режимы RGBA, Indexed (палитры до 256 цветов) и Grayscale, а также цветовые профили. — Слои и кадры существуют как независимые сущности.\",\"link\":\"https://github.com/aseprite/aseprite\"}","identity":{"raw_url":"https://github.com/aseprite/aseprite","normalized_exact_url":"https://github.com/aseprite/aseprite","normalized_address_key":"github.com/aseprite/aseprite","url_host":"github.com","owner_repo":"aseprite/aseprite"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Видео и 3D","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Видео-и-3D/Радар-0648.md","card_sha256":"0a242064c7a8a7431fa544f5c241f3b5d79586c101c22cf8151ab1ab6665c8b3","exact_candidate_group_id":"DUP_fe14fc3925d15394","exact_candidate_members":["Радар-0648"],"address_candidate_group_id":"DUP_76dc5e6cc0