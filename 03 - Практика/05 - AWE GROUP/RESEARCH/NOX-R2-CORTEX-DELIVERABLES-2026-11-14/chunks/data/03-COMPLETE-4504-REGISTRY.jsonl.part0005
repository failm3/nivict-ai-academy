{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0791","origin":{"collection":"Радар","original_row_number":791,"raw_json_pointer":"/790"},"raw":{"description":"wwmm/easyeffects — Аудиопроцессор для Linux с поддержкой PipeWire. Работает как системный эффект-процессор: перехватывает аудиопоток приложений и применяет к нему цепочку обработки в реальном времени. Порядок эффектов настраивается вручную. — Включает более 30 эффектов: эквалайзер, компрессор, лимитер, ревербератор, шумоподавление, сдвиг высоты тона, автоусиление, подавление голоса, удаление эха, свёрточный процессор и другие.","link":"https://github.com/wwmm/easyeffects"},"raw_record_json":"{\"description\":\"wwmm/easyeffects — Аудиопроцессор для Linux с поддержкой PipeWire. Работает как системный эффект-процессор: перехватывает аудиопоток приложений и применяет к нему цепочку обработки в реальном времени. Порядок эффектов настраивается вручную. — Включает более 30 эффектов: эквалайзер, компрессор, лимитер, ревербератор, шумоподавление, сдвиг высоты тона, автоусиление, подавление голоса, удаление эха, свёрточный процессор и другие.\",\"link\":\"https://github.com/wwmm/easyeffects\"}","identity":{"raw_url":"https://github.com/wwmm/easyeffects","normalized_exact_url":"https://github.com/wwmm/easyeffects","normalized_address_key":"github.com/wwmm/easyeffects","url_host":"github.com","owner_repo":"wwmm/easyeffects"},"classification":{"semantic_class":"app","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["other_unknown"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"LOW","heuristic_not_ground_truth":true},"historical":{"historical_category":"Медиа - Аудио и речь","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Медиа---Аудио-и-речь/Радар-0791.md","card_sha256":"116ea2b539290f5633fe1b7476746d85377eef122507864fcbc8f3169be6a4cc","exact_candidate_group