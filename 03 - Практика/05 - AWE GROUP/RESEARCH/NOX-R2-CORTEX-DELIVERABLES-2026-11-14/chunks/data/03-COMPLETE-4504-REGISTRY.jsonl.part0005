{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0616","origin":{"collection":"Радар","original_row_number":616,"raw_json_pointer":"/615"},"raw":{"description":"stablyai/orca — Десктопное и мобильное приложение для одновременного запуска нескольких AI-агентов. Позволяет запускать Claude Code, Codex, OpenCode, Grok и другие CLI-агенты параллельно — каждый в отдельном git worktree, все отслеживаются в одном интерфейсе. Один промпт можно разослать сразу пяти агентам, сравнить результаты и принять лучший. — ❤","link":"https://github.com/stablyai/orca"},"raw_record_json":"{\"description\":\"stablyai/orca — Десктопное и мобильное приложение для одновременного запуска нескольких AI-агентов. Позволяет запускать Claude Code, Codex, OpenCode, Grok и другие CLI-агенты параллельно — каждый в отдельном git worktree, все отслеживаются в одном интерфейсе. Один промпт можно разослать сразу пяти агентам, сравнить результаты и принять лучший. — ❤\",\"link\":\"https://github.com/stablyai/orca\"}","identity":{"raw_url":"https://github.com/stablyai/orca","normalized_exact_url":"https://github.com/stablyai/orca","normalized_address_key":"github.com/stablyai/orca","url_host":"github.com","owner_repo":"stablyai/orca"},"classification":{"semantic_class":"CLI","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["execution_automation","tool_discovery"],"contours":["A_TOOL_CAPABILITY","C_EXECUTION_STRATEGY"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"AI - Агенты и MCP","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/AI---Агенты-и-MCP/Радар-0616.md","card_sha256":"79ad172b930ae5c6297bdf7bd9be05d341e7d3b0e744b67a84f1bfa6a42f13a6","exact_candidate_group_id":"DUP_10a41ea6f971ed1c","exact_candidate_members":["Радар-0616"],"address_candidate_group_id":"DUP_4cf2a0e23ba55394","address_candidate_m