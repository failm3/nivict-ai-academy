{"schema_version":"nox-r2-complete-raw-registry-v1","record_id":"Радар-0530","origin":{"collection":"Радар","original_row_number":530,"raw_json_pointer":"/529"},"raw":{"description":"igniterealtime/Openfire — XMPP-сервер для обмена сообщениями в реальном времени. Работает на открытом протоколе XMPP (Jabber) и распространяется под лицензией Apache. Можно развернуть локально. — Поддерживает администрирование через веб-интерфейс. Обеспечивает шифрование и контроль доступа. Архитектура построена на Java и Maven, что упрощает доработку под собственные нужды.","link":"https://github.com/igniterealtime/Openfire"},"raw_record_json":"{\"description\":\"igniterealtime/Openfire — XMPP-сервер для обмена сообщениями в реальном времени. Работает на открытом протоколе XMPP (Jabber) и распространяется под лицензией Apache. Можно развернуть локально. — Поддерживает администрирование через веб-интерфейс. Обеспечивает шифрование и контроль доступа. Архитектура построена на Java и Maven, что упрощает доработку под собственные нужды.\",\"link\":\"https://github.com/igniterealtime/Openfire\"}","identity":{"raw_url":"https://github.com/igniterealtime/Openfire","normalized_exact_url":"https://github.com/igniterealtime/openfire","normalized_address_key":"github.com/igniterealtime/openfire","url_host":"github.com","owner_repo":"igniterealtime/Openfire"},"classification":{"semantic_class":"library","method":"DETERMINISTIC_HEURISTIC_NOT_UPSTREAM_VERIFIED","operation_purposes":["observability_economics","security_governance"],"contours":["B_KNOWLEDGE_COMPETENCE"],"confidence":"MEDIUM","heuristic_not_ground_truth":true},"historical":{"historical_category":"Безопасность и приватность","historical_confidence":"low","historical_resource_type":"github_repository","historical_flags":"manual_topic_review"},"crosswalk":{"card_path":"20 - Записи/Безопасность-и-приватность/Радар-0530.md","card_sha256":"edb5d84e58bda844450e9b1bc1bcca613ceed1fbe8e22eeae57c9cbf53604492","exact_candidate_group_id":"DUP_1b375